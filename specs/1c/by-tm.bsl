// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик GET get-products/by-tm
//
// Исправленная версия функции ПолучитьТоварыПоПроизводителю. Кодировка файла: UTF-8.
// Контракт ответа — specs/content-manager.md §8, дополнен массивом `errors`.
//
// ПОЧЕМУ ПЕРЕПИСАНО. На ТМ «Farecom / Фареком» (код 000000215) сервис отдавал
// HTTP 500 с ПУСТЫМ телом: 51 позиция, из них первые 11 отдавались нормально
// (вся коллекция «Победа цветное масло»), а начиная с 12-й падала каждая — даже
// при size=1. Причина — обращение к реквизиту «Коллекция» без проверки:
//
//     СтрокаКоллекция = Товар.ДополнительныеРеквизиты.Найти(СвойствоКоллекция, "Свойство");
//     СтруктураТовара.Вставить("collection", СтрокаКоллекция.Значение.Наименование);
//
// `Найти` возвращает **Неопределено**, если у товара такого допреквизита нет вовсе —
// и `.Значение` на Неопределено выбрасывает исключение. У первых 11 товаров реквизит
// заполнен, у остальных нет, отсюда и граница ровно на 12-й позиции.
//
// ВНИМАНИЕ ПРИ ВСТАВКЕ В МОДУЛЬ. Этот файл и set-prices.bsl попадают в ОДИН модуль, и
// общая функция `ИмяКоллекции(Наименование)` есть в обоих — вставляйте её один раз
// (второй одноимённый блок пропустите, иначе модуль не скомпилируется). Все остальные
// функции здесь уникальны.
//
// ЧТО ИЗМЕНЕНО:
//   1. `КоллекцияТовара()` — проверяет и Неопределено, и незаполненное значение, и случай,
//      когда значение реквизита не ссылка, а строка. Результат прогоняется через общий
//      `ИмяКоллекции()`, чтобы by-tm и set-prices звали коллекцию одинаково.
//   2. Сборка КАЖДОЙ позиции обёрнута в Попытка. Сбой на одном товаре больше не роняет
//      весь запрос: товар попадает в `errors` с кодом и текстом, остальные отдаются.
//      Это главное: любая будущая дырка в данных перестаёт быть отказом всей ТМ.
//   3. Виды цен ищутся ОДИН раз до цикла и проверяются `ЗначениеЗаполнено`:
//      `НайтиПоКоду` возвращает пустую ссылку, а не Неопределено, и без проверки
//      цены молча искались бы по пустому виду цены.
//   4. `УПОРЯДОЧИТЬ ПО Код` — без сортировки порядок выборки не определён, и постраничный
//      обход мог возвращать одни товары дважды, а другие пропускать.
//   5. Отброшены помеченные на удаление.
//   6. Границы страницы: `Страница` <= 0 давала отрицательный индекс и исключение.
//   7. `ПланыВидовХарактеристик...НайтиПоНаименованию` вынесен из цикла (был на каждый товар).
//
// Ответ (добавился только `errors`, остальное без изменений):
//   { "tm": "Farecom / Фареком", "total": 51, "offset": 1, "limit": 200,
//     "items": [ { "ref": "YO-00032195", ... } ],
//     "errors": [ { "ref": "YO-00032200", "code": "item_failed",
//                   "message": "Значение не является значением объектного типа (Значение)" } ] }
// =====================================================================================

Функция ПолучитьТоварыПоПроизводителю(Производитель, Страница, Лимит)

	Результат = Новый Структура;
	Ошибки = Новый Массив;

	// --- виды цен: один раз, с проверкой (НайтиПоКоду отдаёт ПУСТУЮ ССЫЛКУ, не Неопределено)
	КодыВидовЦен = Новый Соответствие;
	КодыВидовЦен.Вставить("purchase", "00-000003");
	КодыВидовЦен.Вставить("rrc",      "YO-000005");
	КодыВидовЦен.Вставить("retail",   "YO-000004");

	ВидыЦен = Новый Соответствие;
	Для Каждого ЭлементКода Из КодыВидовЦен Цикл
		ВидЦены = Справочники.ВидыЦен.НайтиПоКоду(ЭлементКода.Значение);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			ВидыЦен.Вставить(ЭлементКода.Ключ, ВидЦены);
		Иначе
			Ошибки.Добавить(Новый Структура("ref,code,message", "",
				"price_type_missing",
				"Не найден вид цены с кодом " + ЭлементКода.Значение));
		КонецЕсли;
	КонецЦикла;

	// --- реквизит «Коллекция» ищем один раз, а не на каждый товар
	СвойствоКоллекция = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Коллекция", Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Товар
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Производитель = &Производитель
	               |	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	               |	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	               |	И НЕ Номенклатура.ПометкаУдаления
	               |	И НЕ Номенклатура.Родитель В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					Группы.Ссылка
	               |				ИЗ
	               |					Справочник.Номенклатура КАК Группы
	               |				ГДЕ
	               |					Группы.ЭтоГруппа = ИСТИНА
	               |					И Группы.НеВыгружать = ИСТИНА)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура.Код";

	Запрос.УстановитьПараметр("Производитель", Производитель);
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ВсегоЗаписей = ТаблицаРезультат.Количество();

	Результат.Вставить("tm", Производитель.Наименование);
	Результат.Вставить("total", ВсегоЗаписей);
	Результат.Вставить("offset", Страница);
	Результат.Вставить("limit", Лимит);

	// --- границы страницы: без этого Страница = 0 давала отрицательный индекс
	НомерСтраницы = ?(Страница = Неопределено ИЛИ Страница < 1, 1, Страница);
	РазмерСтраницы = ?(Лимит = Неопределено ИЛИ Лимит < 1, 200, Лимит);

	Начало = (НомерСтраницы - 1) * РазмерСтраницы;
	Конец = Мин(Начало + РазмерСтраницы, ВсегоЗаписей);

	МассивДанныхТоваров = Новый Массив;

	Для Инд = Начало По Конец - 1 Цикл

		Если Инд < 0 ИЛИ Инд >= ВсегоЗаписей Тогда
			Продолжить;
		КонецЕсли;

		Товар = ТаблицаРезультат[Инд].Товар;

		// Сбой на ОДНОМ товаре не должен отменять всю страницу: раньше любое
		// незаполненное поле превращалось в HTTP 500 на всю торговую марку.
		Попытка
			МассивДанныхТоваров.Добавить(ДанныеТовара(Товар, СвойствоКоллекция, ВидыЦен));
		Исключение
			Ошибки.Добавить(Новый Структура("ref,code,message",
				Строка(Товар.Код), "item_failed", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Результат.Вставить("items", МассивДанныхТоваров);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции

// Данные одной позиции. Вынесено из цикла, чтобы обернуть в Попытка целиком.
Функция ДанныеТовара(Товар, СвойствоКоллекция, ВидыЦен)

	СтруктураТовара = Новый Структура();
	СтруктураТовара.Вставить("ref", Товар.Код);
	СтруктураТовара.Вставить("id", UIDДляСайта(Товар));
	СтруктураТовара.Вставить("name", Товар.Наименование);
	СтруктураТовара.Вставить("article", Товар.Артикул);
	СтруктураТовара.Вставить("unit", Товар.ЕдиницаИзмерения.Наименование);
	СтруктураТовара.Вставить("size", ПолучитьРазмеры(Товар));
	СтруктураТовара.Вставить("product_type", Товар.ВидТовара.Наименование);
	СтруктураТовара.Вставить("collection", КоллекцияТовара(Товар, СвойствоКоллекция));
	СтруктураТовара.Вставить("parent",
		Новый Структура("code,name", Товар.Родитель.Код, Товар.Родитель.Наименование));
	СтруктураТовара.Вставить("alt_units", ПолучитьКоэффициентыЕИ(Товар));

	СписокЦен = Новый Массив;
	Для Каждого ЭлементВида Из ВидыЦен Цикл
		Ответ = ПолучитьАктуальнуюЦену(Товар, ЭлементВида.Значение);
		Если НЕ Ответ = Неопределено Тогда
			СписокЦен.Добавить(Новый Структура(ЭлементВида.Ключ, Ответ));
		КонецЕсли;
	КонецЦикла;
	СтруктураТовара.Вставить("prices", СписокЦен);

	Возврат СтруктураТовара;

КонецФункции

// ИМЕННО ЗДЕСЬ БЫЛО ПАДЕНИЕ.
//
// `ДополнительныеРеквизиты.Найти(...)` возвращает Неопределено, если у товара такой
// строки нет — обращение к `.Значение` на Неопределено выбрасывает исключение.
// Дополнительно: значение реквизита не обязано быть ссылкой (бывает строка), поэтому
// `.Наименование` тоже нельзя брать без проверки типа.
//
// Читает СЫРОЕ значение и прогоняет через общий нормализатор `ИмяКоллекции` — тот же,
// которым пользуется set-prices, иначе одна и та же коллекция называлась бы в двух
// ответах по-разному.
Функция КоллекцияТовара(Товар, СвойствоКоллекция)

	Если НЕ ЗначениеЗаполнено(СвойствоКоллекция) Тогда
		Возврат "";                        // реквизита «Коллекция» нет в конфигурации
	КонецЕсли;

	СтрокаКоллекция = Товар.ДополнительныеРеквизиты.Найти(СвойствоКоллекция, "Свойство");
	Если СтрокаКоллекция = Неопределено Тогда
		Возврат "";                        // у товара реквизит не заполнен — это НОРМА
	КонецЕсли;

	Значение = СтрокаКоллекция.Значение;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	// строковый допреквизит берём как есть, ссылочный — по наименованию
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Сырое = Значение;
	Иначе
		Попытка
			Сырое = Строка(Значение.Наименование);
		Исключение
			Сырое = Строка(Значение);       // тип без Наименование (число, дата, булево)
		КонецПопытки;
	КонецЕсли;

	Возврат ИмяКоллекции(Сырое);

КонецФункции


// =====================================================================================
// ОБЩАЯ ФУНКЦИЯ. Уже присутствует в specs/1c/set-prices.bsl — в модуле она должна быть
// РОВНО ОДНА. Если set-prices уже вставлен, этот блок пропустите; если вставляете
// by-tm первым, при вставке set-prices пропустите одноимённый блок там.
//
// Имя коллекции для сообщения админу: «Коллекция Brilliant - 10 декоров» → «Brilliant».
// =====================================================================================
Функция ИмяКоллекции(Наименование)

	Имя = СокрЛП(Наименование);

	Если ВРег(Лев(Имя, 10)) = "КОЛЛЕКЦИЯ " Тогда
		Имя = СокрЛП(Сред(Имя, 11));
	КонецЕсли;

	Позиция = Найти(Имя, " - ");
	Если Позиция > 1 Тогда
		Имя = СокрЛП(Лев(Имя, Позиция - 1));
	КонецЕсли;

	Возврат Имя;

КонецФункции

// UID сайта: если записи в регистре нет, Получить() отдаёт структуру с пустым UID —
// падать на этом не нужно, товар просто уйдёт без id.
Функция UIDДляСайта(Товар)

	Попытка
		СтруктураПоиска = Новый Структура("Номенклатура,Магазин", Товар, Справочники.ёМагазины.Норвик);
		UID = РегистрыСведений.ёРеквизитыНоменклатурыДляСайтов.Получить(СтруктураПоиска).UID;
		Если НЕ ЗначениеЗаполнено(UID) Тогда
			Возврат "";
		КонецЕсли;
		Возврат УбратьРазделительЧисел(Строка(UID));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции
