// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик GET get-products/by-tm
//
// Кодировка файла: UTF-8. Контракт ответа — specs/content-manager.md §8 и §19.3.
//
// ПОЧЕМУ ПЕРЕПИСЫВАЛОСЬ РАНЬШЕ. На ТМ «Farecom / Фареком» (код 000000215) сервис отдавал
// HTTP 500 с ПУСТЫМ телом: 51 позиция, из них первые 11 отдавались нормально, а начиная
// с 12-й падала каждая — даже при size=1. Причина — обращение к реквизиту «Коллекция»
// без проверки:
//
//     СтрокаКоллекция = Товар.ДополнительныеРеквизиты.Найти(СвойствоКоллекция, "Свойство");
//     СтруктураТовара.Вставить("collection", СтрокаКоллекция.Значение.Наименование);
//
// `Найти` возвращает **Неопределено**, если у товара такого допреквизита нет вовсе —
// и `.Значение` на Неопределено выбрасывает исключение.
//
// ВНИМАНИЕ ПРИ ВСТАВКЕ В МОДУЛЬ. Этот файл и set-prices.bsl попадают в ОДИН модуль, и
// общая функция `ИмяКоллекции(Наименование)` есть в обоих — вставляйте её один раз
// (второй одноимённый блок пропустите, иначе модуль не скомпилируется). Все остальные
// функции здесь уникальны.
//
// ЧТО ДОБАВЛЕНО В ЭТОЙ РЕДАКЦИИ (§19.3) — три поля, которых не хватало агенту:
//
//   1. `properties` — набор дополнительных реквизитов товара со значениями И КОДАМИ.
//      Без него сверка «правильности заполнения всех полей» невозможна: доп. свойства
//      не видны вовсе. Значения адресуются кодом (§19.2.2), поэтому в каждой записи есть
//      и `value`, и `value_code`; у примитивных значений (строка, число, дата, булево)
//      кода нет — там `value_code` пустой, и это норма.
//
//   2. `collection_code` — код значения свойства «Коллекция». Он закрывает основной
//      сценарий работы с коллекциями БЕЗ обращения к их справочнику (§19.2.1): справочник
//      значений не привязан ни к виду товара, ни к производителю, и сопоставлять его по
//      именам папок рискованно. А код, взятый из самих товаров марки, однозначен.
//
//   3. `not_exported` — признак, что позиция не выгружается на сайт. Считается В ЗАПРОСЕ,
//      а не обращением `Товар.Родитель.НеВыгружать`, по двум причинам: обход иерархии на
//      каждый товар дорог, а у реквизита с «Использование = Для группы» обращение через
//      точку от ссылки бросает «Поле объекта не обнаружено» — этим уже роняли ответ в
//      HTTP 500. В запросе тот же подзапрос по ИЕРАРХИИ, что и в отборе.
//
// ВОССТАНОВЛЕНО. В присланной версии из `ДанныеТовара` пропала обёртка `Безопасно()` для
// необязательных полей. Она была заведена не зря: сплошной прогон по 165 ТМ (11 059
// позиций) нашёл 2 позиции — YO-00021204 (Kapelli) и YO-00008229 (Boen), — которые
// терялись ЦЕЛИКОМ из-за «Invalid parameter value (parameter number '1')» в
// `ПолучитьРазмеры`. С `Безопасно()` такая позиция отдаётся с пустым размером, а причина
// уходит в журнал регистрации. Без неё она уходит в `errors` и до агента не доходит.
// Если это было сознательное упрощение — уберите обёртки обратно, остальное не изменится.
//
// ЧТО ДОБАВЛЕНО 05.09.2026: точка входа `ПолучитьТоварыПоТМкВыгрузкеНаСайт` — ошибки
// параметров отдаются в том же конверте, что удачный ответ, а не массивом (из-за этого они
// превращались в HTTP 500), и `page` получил умолчание. Подробности — в комментарии к ней.
//
// Ответ (§19.3): к прежним полям добавились properties, collection_code, not_exported.
// =====================================================================================

// =====================================================================================
// Точка входа GET get-products/by-tm: разбор и проверка параметров.
//
// ЧТО БЫЛО НЕ ТАК. Ошибки возвращались МАССИВОМ (`Результат = Новый Массив` с одной
// структурой внутри), а удачный ответ — СТРУКТУРОЙ. Сериализация ответа рассчитана на
// структуру, поэтому любая ошибка параметров превращалась в HTTP 500 с HTML-страницей IIS
// вместо JSON. Проверено на боевом сервисе 05.09.2026:
//
//     tm=…            (без page)          -> 500
//     tm=…&size=5     (без page)          -> 500
//     page=1&size=5   (без tm)            -> 500
//     tm=…&page=1&size=5                  -> 200
//
// Наш клиент всегда передаёт все три параметра, поэтому на работе это не сказывалось. Но
// любой новый вызов без параметра получал нечитаемый 500 вместо кода ошибки — и полчаса
// уходило бы на выяснение, что дело в параметре, а не в 1С.
//
// ЧТО ИЗМЕНЕНО:
//   1. Ошибка отдаётся В ТОМ ЖЕ КОНВЕРТЕ, что удачный ответ: {tm, total, offset, limit,
//      items, errors}. Клиент разбирает ответ одинаково в обоих случаях и видит причину;
//      сериализация больше не спотыкается.
//   2. Коды ошибок машинные — как в set-prices (§10.3) и folders: tm_missing, tm_not_found,
//      page_invalid, size_invalid. Текст остаётся для человека.
//   3. `page` получил умолчание 1, как у `size` умолчание 200. Требовать номер страницы,
//      когда страница одна, незачем: это параметр пагинации, а не запроса.
//   4. Отрицательные и нулевые значения приводятся к границам, а не роняют ответ.
// =====================================================================================

Функция ПолучитьТоварыПоТМкВыгрузкеНаСайт(ПараметрыЗапроса)

	КодПроизводителя = ПараметрыЗапроса["tm"];

	Если КодПроизводителя = Неопределено Тогда
		Возврат ОтветСОшибкой("", "tm_missing", "Не передан параметр tm");
	КонецЕсли;

	Производитель = Справочники.Производители.НайтиПоКоду(КодПроизводителя);

	Если Производитель.Пустая() Тогда
		Возврат ОтветСОшибкой("", "tm_not_found",
			"Не найдена торговая марка с кодом " + КодПроизводителя);
	КонецЕсли;

	// --- страница: умолчание 1. Требовать её незачем — это параметр пагинации.
	ПараметрНомерСтраницы = ПараметрыЗапроса["page"];

	Если ПараметрНомерСтраницы = Неопределено Тогда
		Страница = 1;
	Иначе
		Попытка
			Страница = Число(ПараметрНомерСтраницы);
		Исключение
			Возврат ОтветСОшибкой(Производитель.Наименование, "page_invalid",
				"Параметр page не число: " + Строка(ПараметрНомерСтраницы));
		КонецПопытки;
	КонецЕсли;

	// --- размер страницы: умолчание 200
	ПараметрРазмерСтраницы = ПараметрыЗапроса["size"];

	Если ПараметрРазмерСтраницы = Неопределено Тогда
		РазмерСтраницы = 200;
	Иначе
		Попытка
			РазмерСтраницы = Число(ПараметрРазмерСтраницы);
		Исключение
			Возврат ОтветСОшибкой(Производитель.Наименование, "size_invalid",
				"Параметр size не число: " + Строка(ПараметрРазмерСтраницы));
		КонецПопытки;
	КонецЕсли;

	// Границы, а не отказ: 0 и минус — это опечатка вызывающего, а не повод не отдать данные.
	Если Страница < 1 Тогда
		Страница = 1;
	КонецЕсли;

	Если РазмерСтраницы < 1 Тогда
		РазмерСтраницы = 200;
	КонецЕсли;

	Возврат ПолучитьТоварыПоПроизводителю(Производитель, ПараметрыЗапроса, Страница, РазмерСтраницы);

КонецФункции


// Ответ с ошибкой параметров — В ТОМ ЖЕ КОНВЕРТЕ, что удачный. Именно поэтому здесь
// структура, а не массив: клиент разбирает ответ одинаково в обоих случаях, а сериализация
// не спотыкается на неожиданном типе (из-за этого ошибки и превращались в HTTP 500).
Функция ОтветСОшибкой(ИмяТМ, КодОшибки, Текст)

	Ошибка = Новый Структура("ref,code,message", "", КодОшибки, Текст);

	Ошибки = Новый Массив;
	Ошибки.Добавить(Ошибка);

	Результат = Новый Структура;
	Результат.Вставить("tm", ИмяТМ);
	Результат.Вставить("total", 0);
	Результат.Вставить("offset", 1);
	Результат.Вставить("limit", 0);
	Результат.Вставить("items", Новый Массив);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции


Функция ПолучитьТоварыПоПроизводителю(Производитель, ПараметрыЗапроса, Страница, Лимит)

	Результат = Новый Структура;
	Ошибки = Новый Массив;

	// --- виды цен: один раз, с проверкой (НайтиПоКоду отдаёт ПУСТУЮ ССЫЛКУ, не Неопределено)
	КодыВидовЦен = Новый Соответствие;
	КодыВидовЦен.Вставить("purchase", "00-000003");
	КодыВидовЦен.Вставить("rrc",      "YO-000005");
	КодыВидовЦен.Вставить("retail",   "YO-000004");

	ВидыЦен = Новый Соответствие;
	Для Каждого ЭлементКода Из КодыВидовЦен Цикл
		ВидЦены = Справочники.ВидыЦен.НайтиПоКоду(ЭлементКода.Значение);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			ВидыЦен.Вставить(ЭлементКода.Ключ, ВидЦены);
		Иначе
			Ошибки.Добавить(Новый Структура("ref,code,message", "",
				"price_type_missing",
				"Не найден вид цены с кодом " + ЭлементКода.Значение));
		КонецЕсли;
	КонецЦикла;

	// --- реквизит «Коллекция» ищем один раз, а не на каждый товар
	СвойствоКоллекция = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Коллекция", Истина);

	Запрос = Новый Запрос;

	// разбираем фильтры
	ТекстОтборовДляЗапроса = "ИСТИНА";

	Если ПараметрыЗапроса.Получить("product_type") <> Неопределено Тогда
		КодТипаТовара = ПараметрыЗапроса["product_type"];

		Если КодТипаТовара <> Неопределено Тогда
			ТипТовара = Справочники.ёТипыНоменклатуры.НайтиПоКоду(КодТипаТовара);

			Если ТипТовара = Справочники.ёТипыНоменклатуры.ПустаяСсылка() Тогда
				Ошибки.Добавить(Новый Структура("ref,code,message", "",
					"product_type_missing",
					"Не найден тип товара с кодом " + КодТипаТовара));
			КонецЕсли;

			Запрос.УстановитьПараметр("ТипТовара", ТипТовара);
			ТекстОтборовДляЗапроса = "Номенклатура.ВидТовара = &ТипТовара";

		КонецЕсли;
	КонецЕсли;

	// Подзапрос по невыгружаемым группам нужен дважды: для отбора и для признака
	// not_exported. Держим его одной строкой, чтобы условия не разъехались.
	ТекстНевыгружаемыеГруппы =
		"Номенклатура.Родитель В ИЕРАРХИИ
		|                (ВЫБРАТЬ
		|                    Группы.Ссылка
		|                ИЗ
		|                    Справочник.Номенклатура КАК Группы
		|                ГДЕ
		|                    Группы.ЭтоГруппа = ИСТИНА
		|                    И Группы.НеВыгружать = ИСТИНА)";

	ТекстИсключитьНевыгружаемые = " И НЕ " + ТекстНевыгружаемыеГруппы;

	Если ПараметрыЗапроса.Получить("include_not_exported") <> Неопределено Тогда
		ВключатьНевыгружаемыеГруппы = ПараметрыЗапроса["include_not_exported"];

		Если ВключатьНевыгружаемыеГруппы = "1" Тогда
			ТекстИсключитьНевыгружаемые = "";
		КонецЕсли;
	КонецЕсли;

	ТекстОтборовДляЗапроса = ТекстОтборовДляЗапроса + ТекстИсключитьНевыгружаемые;

	// запускаем сам запрос
	ТекстЗапроса = "ВЫБРАТЬ
				   |    Номенклатура.Ссылка КАК Товар,
				   |    ВЫБОР
				   |        КОГДА %%ТекстНевыгружаемыеГруппы%%
				   |            ТОГДА ИСТИНА
				   |        ИНАЧЕ ЛОЖЬ
				   |    КОНЕЦ КАК НеВыгружается
				   |ИЗ
				   |    Справочник.Номенклатура КАК Номенклатура
				   |ГДЕ
				   |    Номенклатура.Производитель = &Производитель
				   |    И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
				   |    И Номенклатура.ЭтоГруппа = ЛОЖЬ
				   |    И НЕ Номенклатура.ПометкаУдаления
				   |    И %%ТекстОтборовДляЗапроса%%
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |    Номенклатура.Код";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ТекстНевыгружаемыеГруппы%%", ТекстНевыгружаемыеГруппы);
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "%%ТекстОтборовДляЗапроса%%", ТекстОтборовДляЗапроса);

	Запрос.УстановитьПараметр("Производитель", Производитель);
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ВсегоЗаписей = ТаблицаРезультат.Количество();

	Результат.Вставить("tm", Производитель.Наименование);
	Результат.Вставить("total", ВсегоЗаписей);
	Результат.Вставить("offset", Страница);
	Результат.Вставить("limit", Лимит);

	// --- границы страницы: без этого Страница = 0 давала отрицательный индекс
	НомерСтраницы = ?(Страница = Неопределено ИЛИ Страница < 1, 1, Страница);
	РазмерСтраницы = ?(Лимит = Неопределено ИЛИ Лимит < 1, 200, Лимит);

	Начало = (НомерСтраницы - 1) * РазмерСтраницы;
	Конец = Мин(Начало + РазмерСтраницы, ВсегоЗаписей);

	МассивДанныхТоваров = Новый Массив;

	Для Инд = Начало По Конец - 1 Цикл

		Если Инд < 0 ИЛИ Инд >= ВсегоЗаписей Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТаблицы = ТаблицаРезультат[Инд];
		Товар = СтрокаТаблицы.Товар;

		// Сбой на ОДНОМ товаре не должен отменять всю страницу: раньше любое
		// незаполненное поле превращалось в HTTP 500 на всю торговую марку.
		Попытка
			МассивДанныхТоваров.Добавить(
				ДанныеТовара(Товар, СвойствоКоллекция, ВидыЦен, СтрокаТаблицы.НеВыгружается));
		Исключение
			Ошибки.Добавить(Новый Структура("ref,code,message",
				Строка(Товар.Код), "item_failed", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Результат.Вставить("items", МассивДанныхТоваров);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции


// Данные одной позиции. Вынесено из цикла, чтобы обернуть в Попытка целиком.
Функция ДанныеТовара(Товар, СвойствоКоллекция, ВидыЦен, НеВыгружается)

	СтруктураТовара = Новый Структура();
	СтруктураТовара.Вставить("ref", Товар.Код);
	СтруктураТовара.Вставить("id", Безопасно("UID", Товар));
	СтруктураТовара.Вставить("name", Товар.Наименование);
	СтруктураТовара.Вставить("full_name", Товар.НаименованиеПолное);
	СтруктураТовара.Вставить("site_name", Товар.НаименованиеДляСайта);
	СтруктураТовара.Вставить("article", Товар.Артикул);
	СтруктураТовара.Вставить("unit", Товар.ЕдиницаИзмерения.Наименование);
	СтруктураТовара.Вставить("size", Безопасно("Размеры", Товар));
	СтруктураТовара.Вставить("product_type", Товар.ВидТовара.Наименование);
	СтруктураТовара.Вставить("product_type_ref", Товар.ВидТовара.Код);
	СтруктураТовара.Вставить("length_from", Товар.ДлинаОт);
	СтруктураТовара.Вставить("length_to", Товар.ДлинаДо);
	СтруктураТовара.Вставить("width_from", Товар.ШиринаОт);
	СтруктураТовара.Вставить("width_to", Товар.ШиринаДо);
	СтруктураТовара.Вставить("thickness", Товар.Толщина);
	СтруктураТовара.Вставить("collection", Безопасно("Коллекция", Товар, СвойствоКоллекция));
	СтруктураТовара.Вставить("collection_code", Безопасно("КодКоллекции", Товар, СвойствоКоллекция));
	СтруктураТовара.Вставить("parent",
		Новый Структура("code,name", Товар.Родитель.Код, Товар.Родитель.Наименование));
	СтруктураТовара.Вставить("not_exported", НеВыгружается);
	СтруктураТовара.Вставить("properties", Безопасно("Свойства", Товар));
	СтруктураТовара.Вставить("alt_units", Безопасно("КоэффициентыЕИ", Товар));

	СписокЦен = Новый Массив;
	Для Каждого ЭлементВида Из ВидыЦен Цикл
		Ответ = ПолучитьАктуальнуюЦену(Товар, ЭлементВида.Значение);
		Если НЕ Ответ = Неопределено Тогда
			СписокЦен.Добавить(Новый Структура(ЭлементВида.Ключ, Ответ));
		КонецЕсли;
	КонецЦикла;
	СтруктураТовара.Вставить("prices", СписокЦен);

	Возврат СтруктураТовара;

КонецФункции


// =====================================================================================
// Дополнительные реквизиты товара (§19.3). Плоский список того же вида, что и каталог
// свойств из get-products/properties, плюс коды — товар адресуется кодом (§19.2.2).
//
// Пустые строки пропускаем: незаполненный реквизит у товара — норма, а не ошибка.
// =====================================================================================
Функция СвойстваТовара(Товар)

	МассивСвойств = Новый Массив;

	Для Каждого СтрокаРеквизита Из Товар.ДополнительныеРеквизиты Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаРеквизита.Свойство) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаРеквизита.Значение) Тогда
			Продолжить;
		КонецЕсли;

		Свойство = Новый Структура;
		Свойство.Вставить("property", Строка(СтрокаРеквизита.Свойство.Наименование));
		Свойство.Вставить("code", КодОбъекта(СтрокаРеквизита.Свойство));
		Свойство.Вставить("value", ПредставлениеЗначения(СтрокаРеквизита.Значение));
		Свойство.Вставить("value_code", КодОбъекта(СтрокаРеквизита.Значение));

		МассивСвойств.Добавить(Свойство);

	КонецЦикла;

	Возврат МассивСвойств;

КонецФункции


// Код значения свойства «Коллекция» (§19.2.1). Имя коллекции по-прежнему отдаёт
// `КоллекцияТовара` — она проверена на бою, и трогать её ради кода незачем.
Функция КодКоллекцииТовара(Товар, СвойствоКоллекция)

	Если НЕ ЗначениеЗаполнено(СвойствоКоллекция) Тогда
		Возврат "";
	КонецЕсли;

	СтрокаКоллекция = Товар.ДополнительныеРеквизиты.Найти(СвойствоКоллекция, "Свойство");
	Если СтрокаКоллекция = Неопределено Тогда
		Возврат "";                        // у товара реквизит не заполнен — это НОРМА
	КонецЕсли;

	Возврат КодОбъекта(СтрокаКоллекция.Значение);

КонецФункции


// Код ссылочного значения. У примитивов (строка, число, дата, булево) кода нет —
// возвращаем пустую строку, и это нормальный случай, а не сбой.
Функция КодОбъекта(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Строка(Значение.Код));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции


// Значение допреквизита строкой: ссылочное — по наименованию, примитивное — как есть.
Функция ПредставлениеЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Строка(Значение.Наименование));
	Исключение
		Возврат СокрЛП(Строка(Значение));   // тип без Наименование (число, дата, булево)
	КонецПопытки;

КонецФункции


Функция КоллекцияТовара(Товар, СвойствоКоллекция)

	Если НЕ ЗначениеЗаполнено(СвойствоКоллекция) Тогда
		Возврат "";                        // реквизита «Коллекция» нет в конфигурации
	КонецЕсли;

	СтрокаКоллекция = Товар.ДополнительныеРеквизиты.Найти(СвойствоКоллекция, "Свойство");
	Если СтрокаКоллекция = Неопределено Тогда
		Возврат "";                        // у товара реквизит не заполнен — это НОРМА
	КонецЕсли;

	Значение = СтрокаКоллекция.Значение;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ИмяКоллекции(ПредставлениеЗначения(Значение));

КонецФункции


// =====================================================================================
// ОБЩАЯ ФУНКЦИЯ. Уже присутствует в specs/1c/set-prices.bsl — в модуле она должна быть
// РОВНО ОДНА. Если set-prices уже вставлен, этот блок пропустите; если вставляете
// by-tm первым, при вставке set-prices пропустите одноимённый блок там.
//
// Имя коллекции для сообщения админу: «Коллекция Brilliant - 10 декоров» → «Brilliant».
// =====================================================================================
Функция ИмяКоллекции(Наименование)

	Имя = СокрЛП(Наименование);

	Если ВРег(Лев(Имя, 10)) = "КОЛЛЕКЦИЯ " Тогда
		Имя = СокрЛП(Сред(Имя, 11));
	КонецЕсли;

	Позиция = Найти(Имя, " - ");
	Если Позиция > 1 Тогда
		Имя = СокрЛП(Лев(Имя, Позиция - 1));
	КонецЕсли;

	Возврат Имя;

КонецФункции


// Необязательное поле: сбой внутри не должен стоить всей позиции. Возвращает пустое
// значение подходящего типа и пишет причину в журнал регистрации, чтобы поломка
// вспомогательной функции не потерялась совсем.
Функция Безопасно(Поле, Товар, СвойствоКоллекция = Неопределено)

	Попытка
		Если Поле = "UID" Тогда
			Возврат UIDДляСайта(Товар);
		ИначеЕсли Поле = "Размеры" Тогда
			Возврат ПолучитьРазмеры(Товар);
		ИначеЕсли Поле = "Коллекция" Тогда
			Возврат КоллекцияТовара(Товар, СвойствоКоллекция);
		ИначеЕсли Поле = "КодКоллекции" Тогда
			Возврат КодКоллекцииТовара(Товар, СвойствоКоллекция);
		ИначеЕсли Поле = "Свойства" Тогда
			Возврат СвойстваТовара(Товар);
		ИначеЕсли Поле = "КоэффициентыЕИ" Тогда
			Возврат ПолучитьКоэффициентыЕИ(Товар);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ai-tools.by-tm", УровеньЖурналаРегистрации.Предупреждение,
			, Товар, "Поле " + Поле + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// пустое значение того же типа, что вернула бы удачная ветка
	Если Поле = "КоэффициентыЕИ" ИЛИ Поле = "Свойства" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат "";

КонецФункции


// UID сайта: если записи в регистре нет, Получить() отдаёт структуру с пустым UID —
// падать на этом не нужно, товар просто уйдёт без id.
Функция UIDДляСайта(Товар)

	СтруктураПоиска = Новый Структура("Номенклатура,Магазин", Товар, Справочники.ёМагазины.Норвик);
	UID = РегистрыСведений.ёРеквизитыНоменклатурыДляСайтов.Получить(СтруктураПоиска).UID;
	Если НЕ ЗначениеЗаполнено(UID) Тогда
		Возврат "";
	КонецЕсли;
	Возврат УбратьРазделительЧисел(Строка(UID));

КонецФункции
