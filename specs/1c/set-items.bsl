// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик POST get-products/set-items
//
// Кодировка файла: UTF-8. Контракт — specs/content-manager.md §19.2, §19.2.3, §19.4, §19.8.
//
// ЭТО ЕДИНСТВЕННАЯ ЗАПИСЬ В СПРАВОЧНИК НОМЕНКЛАТУРЫ. Операций шесть: create_folder,
// create_item, update_item, update_folder, add_property_value, update_property_value. УДАЛЕНИЯ НЕТ ВООБЩЕ и не будет: на товар
// ссылаются документы, а снятый с производства может вернуться. Уход из ассортимента — это
// смена родителя на папку снятых (§19.2.5), то есть частный случай update_item.
//
// КАК ПОДКЛЮЧИТЬ. В существующем POST-обработчике `ProductManagementPOST` (set-prices.bsl)
// добавьте ветку рядом с проверкой query-type:
//
//     ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "set-items" Тогда
//         ... разбор тела как в set-prices ...
//         Возврат ОтветJSON(200, ЗаписатьЭлементыСправочника(Данные));
//
// `ОтветJSON` и проверка токена уже есть в set-prices.bsl — их не дублируем. Сравнение имён
// (`ЧастиИмени`, `ИменаСовпадаютТочно`) берётся из properties.bsl: файлы живут в одном
// модуле, и второе определение этих функций не даст модулю собраться.
//
// -------------------------------------------------------------------------------------
// ССЫЛКА НА ОБЪЕКТ, СОЗДАННЫЙ В ЭТОМ ЖЕ БАТЧЕ (§19.2.3)
//
// У операции может быть `id`, и любое поле `*_ref` принимает `"$<id>"`. Главный сценарий —
// в прайсе новая коллекция: одним батчем создаётся папка и товары в ней.
//
// ОШИБКА РОДИТЕЛЯ ОТМЕНЯЕТ ЗАВИСИМЫЕ. Не создалась папка — товары в неё не создаются, и
// каждый такой пропуск попадает в ответ отдельным статусом `skipped_dependency` с индексом
// провалившейся операции. Без этого админ увидел бы одну ошибку про папку и решил, что
// товары записались, — а не записалось ничего.
//
// БАТЧ НЕ ОТКАТЫВАЕТСЯ ЦЕЛИКОМ — как в set-prices: ошибка одной операции не отменяет
// независимые от неё. Каждая операция пишет свой объект и живёт своей жизнью.
//
// -------------------------------------------------------------------------------------
// ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ
//
// * УДАЛЕНИЯ И ПОМЕТКИ УДАЛЕНИЯ — см. выше.
// * ЧАСТИЧНОЙ ЗАПИСИ ПОЛЕЙ, КОТОРЫХ НЕ ПЕРЕДАЛИ. `update_item` меняет ТОЛЬКО те поля,
//   что пришли в запросе. Отсутствие поля означает «не трогать», а не «очистить»: агент
//   присылает разницу, а не полную карточку, и очистка по умолчанию стирала бы данные,
//   которых он не видел.
// * ЗАПИСИ В ПОМЕЧЕННУЮ НА УДАЛЕНИЕ ПАПКУ — отклоняется с `parent_deleted`. Такие папки в
//   базе есть и товары в них живые (§19.2.4), но класть туда новое нельзя.
//
// -------------------------------------------------------------------------------------
// ДВА РАЗНЫХ СПРАВОЧНИКА ЕДИНИЦ, И ПУТАТЬ ИХ НЕЛЬЗЯ
//
// БАЗОВАЯ единица — реквизит `Номенклатура.ЕдиницаИзмерения` типа
// `Справочник.КлассификаторЕдиницИзмерения`. Это ОКЕИ: общий классификатор, одна «м2» на
// всю базу. Её только ИЩУТ — создавать элементы классификатора из нашего обработчика
// нельзя: это не наши данные, и «м2», заведённая второй раз, разошлась бы с ОКЕИ.
//
// ПРОЧИЕ единицы — `Справочник.ЕдиницыИзмерения`, подчинённый номенклатуре: у каждого
// товара свои элементы с `Коэффициент` относительно базовой (видно по
// `ПолучитьКоэффициентыЕИ` — отбор идёт по `Владелец`). Сюда и пишется `pack_coefficient`:
// `упак` с коэффициентом 1.84 при базовой `м2`. Ровно эту пару by-tm отдаёт в `alt_units`.
//
// ОТСЮДА ПОРЯДОК ЗАПИСИ. Базовая проставляется ДО записи товара — она уже существует.
// Упаковка создаётся ПОСЛЕ: справочник подчинённый, без записанного владельца элемент
// будет ничьим. Второй записи товара не нужно — на упаковку он не ссылается.
//
// Имя упаковки переопределяется полем `pack_unit`, по умолчанию «упак».
// =====================================================================================

Функция ЗаписатьЭлементыСправочника(Данные)

	Итог = НовыйИтогЗаписи();

	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ДобавитьОшибкуЗаписи(Итог, -1, "", "items_missing", "Тело запроса не объект");
		Возврат Итог;
	КонецЕсли;

	Операции = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство("items", Операции);
	Иначе
		Операции = Данные.Получить("items");
	КонецЕсли;

	Если ТипЗнч(Операции) <> Тип("Массив") ИЛИ Операции.Количество() = 0 Тогда
		ДобавитьОшибкуЗаписи(Итог, -1, "", "items_missing", "Не передан непустой массив items");
		Возврат Итог;
	КонецЕсли;

	// id → структура {ref, index, ok}: чем разрешаются ссылки "$id" (§19.2.3)
	СозданныеПоКлючу = Новый Соответствие;

	// Ставка НДС и склад ищутся ОДИН РАЗ на батч, а не на каждый товар: это поиск по
	// справочникам, а батч бывает и на сотню позиций.
	Умолчания = УмолчанияСоздания();

	Для Индекс = 0 По Операции.Количество() - 1 Цикл

		Операция = Операции[Индекс];

		Если ТипЗнч(Операция) <> Тип("Структура") И ТипЗнч(Операция) <> Тип("Соответствие") Тогда
			ДобавитьОшибкуЗаписи(Итог, Индекс, "", "operation_invalid", "Операция не объект");
			Продолжить;
		КонецЕсли;

		ВидОперации = ЗначениеПоля(Операция, "op");

		// Чистим очередь сообщений ПЕРЕД операцией: иначе к ошибке одной прилипнут
		// сообщения предыдущей, и админ будет искать причину не там.
		ТекстСообщенийПользователю();

		// Сбой на ОДНОЙ операции не должен ронять весь батч.
		Попытка
			ВыполнитьОперацию(Итог, Индекс, ВидОперации, Операция, СозданныеПоКлючу, Умолчания);
		Исключение

			// ПОЧЕМУ НЕ ХВАТАЕТ ОДНОГО ТЕКСТА ИСКЛЮЧЕНИЯ. `Записать()` на непройденной
			// проверке заполнения бросает «Failed to save: "Номенклатура"!», а НАЗВАНИЕ
			// незаполненного реквизита уходит отдельными сообщениями пользователю — в
			// исключение оно не попадает ни в кратком виде, ни в подробном. Проверено на
			// боевой пробе 08.09.2026: подробное представление дало стек вызовов и ту же
			// бесполезную причину. Поэтому сообщения забираем отдельно.
			Сведения = ИнформацияОбОшибке();
			Сообщения = ТекстСообщенийПользователю();

			Текст = КраткоеПредставлениеОшибки(Сведения);
			Если Сообщения <> "" Тогда
				Текст = Текст + " | " + Сообщения;
			КонецЕсли;

			ДобавитьОшибкуЗаписи(Итог, Индекс, "", "operation_failed", Текст);

			// В журнал — подробное: там место есть, а в ответе админу нужен смысл, а не стек.
			ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Ошибка,
				, , "Операция " + Строка(Индекс) + " (" + Строка(ВидОперации) + "): "
				+ ПодробноеПредставлениеОшибки(Сведения)
				+ ?(Сообщения = "", "", Символы.ПС + "Сообщения: " + Сообщения));

			ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Неопределено, Индекс, Ложь);
		КонецПопытки;

	КонецЦикла;

	Возврат Итог;

КонецФункции


Процедура ВыполнитьОперацию(Итог, Индекс, ВидОперации, Операция, СозданныеПоКлючу, Умолчания)

	Если ВидОперации = "create_folder" Тогда
		СоздатьПапку(Итог, Индекс, Операция, СозданныеПоКлючу);

	ИначеЕсли ВидОперации = "create_item" Тогда
		СоздатьТовар(Итог, Индекс, Операция, СозданныеПоКлючу, Умолчания);

	ИначеЕсли ВидОперации = "update_item" Тогда
		ИзменитьТовар(Итог, Индекс, Операция, СозданныеПоКлючу);

	ИначеЕсли ВидОперации = "add_property_value" Тогда
		ДобавитьЗначениеСвойства(Итог, Индекс, Операция, СозданныеПоКлючу);

	ИначеЕсли ВидОперации = "update_folder" Тогда
		ИзменитьПапку(Итог, Индекс, Операция, СозданныеПоКлючу);

	ИначеЕсли ВидОперации = "update_property_value" Тогда
		ИзменитьЗначениеСвойства(Итог, Индекс, Операция, СозданныеПоКлючу);

	Иначе
		ДобавитьОшибкуЗаписи(Итог, Индекс, "", "op_unknown",
			"Неизвестная операция: " + Строка(ВидОперации));
		ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Неопределено, Индекс, Ложь);
	КонецЕсли;

КонецПроцедуры


// =====================================================================================
// create_folder — папка вида товара / марки / коллекции. Кладётся туда, куда указали:
// смысл папки выводится из её места в дереве (§19.2.4), отдельного признака у неё нет.
// =====================================================================================
Процедура СоздатьПапку(Итог, Индекс, Операция, СозданныеПоКлючу)

	Имя = СокрЛП(Строка(ЗначениеПоля(Операция, "name")));

	Если Имя = "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "name_missing",
			"Не передано имя папки");
		Возврат;
	КонецЕсли;

	Родитель = Справочники.Номенклатура.ПустаяСсылка();
	СсылкаРодителя = ЗначениеПоля(Операция, "parent_ref");

	Если ЗначениеЗаполнено(СсылкаРодителя) Тогда
		Разрешение = РазрешитьСсылку(СсылкаРодителя, СозданныеПоКлючу);

		Если НЕ Разрешение.Найдено Тогда
			ПропуститьИлиОтклонить(Итог, Индекс, Операция, СозданныеПоКлючу, Разрешение);
			Возврат;
		КонецЕсли;

		Проверка = ПроверитьПапкуРодителя(Разрешение.Ссылка);
		Если Проверка <> "" Тогда
			ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, Проверка,
				"Папка-родитель " + Строка(СсылкаРодителя) + ": " + ТекстПроверки(Проверка));
			Возврат;
		КонецЕсли;

		Родитель = Разрешение.Ссылка;
	КонецЕсли;

	// ДУБЛЬ ПО ИМЕНИ В ТОЙ ЖЕ ПАПКЕ НЕ ЗАВОДИМ. Прайс присылают повторно — на этом
	// построены кеши разбора (§6.9), — и без проверки второй прогон создал бы вторую
	// «Allure» рядом с первой. Такие близнецы в базе уже есть: у CAMSAN две «Modern Long»
	// с разными кодами, и разошлись они когда-то ровно так.
	Существующая = НайтиПапкуПоИмени(Родитель, Имя);

	Если ЗначениеЗаполнено(Существующая) Тогда
		ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Существующая, Индекс, Истина);
		ДобавитьРезультат(Итог, Индекс, "create_folder", КодСсылки(Существующая), "exists");
		Возврат;
	КонецЕсли;

	Папка = Справочники.Номенклатура.СоздатьГруппу();
	Папка.Наименование = Имя;
	Папка.Родитель = Родитель;

	Папка.Записать();

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Папка.Ссылка, "Создана папка " + Имя);

	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Папка.Ссылка, Индекс, Истина);
	ДобавитьРезультат(Итог, Индекс, "create_folder", Папка.Ссылка.Код, "created");
	Итог.created = Итог.created + 1;

КонецПроцедуры


// Папка с таким именем в том же родителе. Именно В ТОМ ЖЕ: одноимённые коллекции у разных
// марок — норма, глобальный поиск вернул бы чужую.
//
// СРАВНЕНИЕ РАЗБИРАЕТ ДВУЯЗЫЧНЫЕ ИМЕНА, и это не украшение. У Atlas Concorde Rus коллекции
// названы «ALLURE/АЛЛЮР», «DRIFT/ДРИФТ», «EMPIRE/ЭМПАИР» — запрос на «Allure» точного
// равенства не даёт. Именно так 08.09.2026 рядом с существующей «ALLURE/АЛЛЮР»
// (YO-00067005) появился дубль «Allure» (YO-00078951).
//
// Сравниваем ТОЧНО по частям, а не по вхождению: «Allure» не должна совпасть с
// «Allure Gold», это разные коллекции.
Функция НайтиПапкуПоИмени(Родитель, Имя)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Родитель);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Папки.Ссылка КАК Ссылка,
		|	Папки.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Папки
		|ГДЕ
		|	Папки.ЭтоГруппа = ИСТИНА
		|	И Папки.Родитель = &Родитель
		|	И НЕ Папки.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Части = ЧастиИмени(Имя);

	Пока Выборка.Следующий() Цикл
		Если ИменаСовпадаютТочно(Части, ЧастиИмени(Выборка.Наименование)) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции


// =====================================================================================
// create_item — новый товар. Поля — §19.4. Обязательны родитель и наименование: товар без
// папки повиснет в корне, а без имени его не найдёт ни менеджер, ни сайт.
// =====================================================================================
Процедура СоздатьТовар(Итог, Индекс, Операция, СозданныеПоКлючу, Умолчания)

	Имя = СокрЛП(Строка(ЗначениеПоля(Операция, "name")));

	Если Имя = "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "name_missing",
			"Не передано наименование товара");
		Возврат;
	КонецЕсли;

	СсылкаРодителя = ЗначениеПоля(Операция, "parent_ref");

	Если НЕ ЗначениеЗаполнено(СсылкаРодителя) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "parent_missing",
			"Не передан parent_ref: товар без папки повиснет в корне");
		Возврат;
	КонецЕсли;

	Разрешение = РазрешитьСсылку(СсылкаРодителя, СозданныеПоКлючу);

	Если НЕ Разрешение.Найдено Тогда
		ПропуститьИлиОтклонить(Итог, Индекс, Операция, СозданныеПоКлючу, Разрешение);
		Возврат;
	КонецЕсли;

	Проверка = ПроверитьПапкуРодителя(Разрешение.Ссылка);
	Если Проверка <> "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, Проверка,
			"Папка-родитель " + Строка(СсылкаРодителя) + ": " + ТекстПроверки(Проверка));
		Возврат;
	КонецЕсли;

	Товар = Справочники.Номенклатура.СоздатьЭлемент();
	Товар.Родитель = Разрешение.Ссылка;
	Товар.Наименование = Имя;

	// УЧЁТНЫЕ РЕКВИЗИТЫ. Проверку заполнения товар проходит и без них, но работать не
	// будет: `by-tm` отбирает `ТипНоменклатуры = Запас` (§8), и позиция без него не видна
	// ни агенту, ни выгрузке на сайт — создана, а как будто её нет. Найдено на боевой
	// проверке 09.09.2026: восемь позиций SPC записались и пропали из by-tm. Остальные
	// реквизиты того же рода — без них карточка не встаёт в учёт.
	ЗаполнитьУчётныеРеквизиты(Товар, Умолчания);

	Если НЕ ЗначениеЗаполнено(ЗначениеПоля(Операция, "unit")) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "unit_missing",
			"Не передан unit: товар без базовой единицы измерения нерабочий");
		Возврат;
	КонецЕсли;

	Отказ = ЗаполнитьПоляТовара(Товар, Операция);
	Если Отказ <> "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, Отказ, ТекстПроверки(Отказ));
		Возврат;
	КонецЕсли;

	Товар.Записать();

	// Стартовая запись истории правок. ВНИМАНИЕ на две вещи, на которых 1С падает:
	// `Товар.Ссылка` — свойство, а не метод (скобок быть не должно), и дату нельзя
	// складывать со строкой напрямую — нужен Формат или Строка.
	ЗаписатьИсториюПравок(Товар.Ссылка, "Создан", Новый Массив);

	// Упаковка — ПОСЛЕ записи: справочник подчинён товару, без владельца элемент ничей.
	Отказ = ЗаписатьУпаковку(Товар.Ссылка, Операция);
	Если Отказ <> "" Тогда
		ДобавитьПредупреждение(Итог, Индекс, Отказ,
			"Товар создан, но упаковка не записана: " + ТекстПроверки(Отказ));
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Товар.Ссылка, "Создан товар " + Имя);

	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Товар.Ссылка, Индекс, Истина);
	ДобавитьРезультат(Итог, Индекс, "create_item", Товар.Ссылка.Код, "created");
	Итог.created = Итог.created + 1;

КонецПроцедуры


// =====================================================================================
// update_item — правка полей и ПЕРЕНОС между папками (смена parent_ref, §19.6.1).
// Меняются ТОЛЬКО переданные поля: отсутствие поля значит «не трогать».
// =====================================================================================
Процедура ИзменитьТовар(Итог, Индекс, Операция, СозданныеПоКлючу)

	КодТовара = ЗначениеПоля(Операция, "ref");

	Если НЕ ЗначениеЗаполнено(КодТовара) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "ref_missing",
			"Не передан ref изменяемого товара");
		Возврат;
	КонецЕсли;

	Ссылка = Справочники.Номенклатура.НайтиПоКоду(КодТовара);

	// НайтиПоКоду отдаёт ПУСТУЮ ССЫЛКУ, а не Неопределено
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "item_not_found",
			"Не найден товар с кодом " + Строка(КодТовара));
		Возврат;
	КонецЕсли;

	Товар = Ссылка.ПолучитьОбъект();

	// Починка того же: позиция с пустым типом номенклатуры не видна в by-tm. Правим молча —
	// это не данные поставщика, а обязательный реквизит, без которого карточка нерабочая.
	Если НЕ ЗначениеЗаполнено(Товар.ТипНоменклатуры) Тогда
		Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	КонецЕсли;

	// Снимок ДО любых присваиваний: сравнивать потом будет не с чем, объект уже изменён.
	Снимок = СнимокПолейТовара(Товар);

	// --- перенос: смена родителя
	СсылкаРодителя = ЗначениеПоля(Операция, "parent_ref");

	Если ЗначениеЗаполнено(СсылкаРодителя) Тогда

		Разрешение = РазрешитьСсылку(СсылкаРодителя, СозданныеПоКлючу);

		Если НЕ Разрешение.Найдено Тогда
			ПропуститьИлиОтклонить(Итог, Индекс, Операция, СозданныеПоКлючу, Разрешение);
			Возврат;
		КонецЕсли;

		Проверка = ПроверитьПапкуРодителя(Разрешение.Ссылка);
		Если Проверка <> "" Тогда
			ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, Проверка,
				"Папка-родитель " + Строка(СсылкаРодителя) + ": " + ТекстПроверки(Проверка));
			Возврат;
		КонецЕсли;

		Товар.Родитель = Разрешение.Ссылка;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЗначениеПоля(Операция, "name")) Тогда
		Товар.Наименование = СокрЛП(Строка(ЗначениеПоля(Операция, "name")));
	КонецЕсли;

	Отказ = ЗаполнитьПоляТовара(Товар, Операция);
	Если Отказ <> "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, Отказ, ТекстПроверки(Отказ));
		Возврат;
	КонецЕсли;

	Товар.Записать();

	// В историю пишем ТОЛЬКО содержательные изменения. Нормализация (схлопнутые пробелы,
	// обрезка краёв) значимых символов не меняет, и запись о ней превратила бы историю в
	// шум: разбор прайса трогает наименования пачками, а читать её будет человек.
	Изменения = ОписаниеИзменений(Снимок, Товар);

	Если Изменения.Количество() > 0 Тогда
		ЗаписатьИсториюПравок(Товар.Ссылка, "", Изменения);
	КонецЕсли;

	Отказ = ЗаписатьУпаковку(Товар.Ссылка, Операция);
	Если Отказ <> "" Тогда
		ДобавитьПредупреждение(Итог, Индекс, Отказ,
			"Товар изменён, но упаковка не записана: " + ТекстПроверки(Отказ));
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Товар.Ссылка, "Изменён товар " + Строка(КодТовара));

	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Товар.Ссылка, Индекс, Истина);

	// Правка, ничего содержательно не изменившая, помечается `unchanged`, а не `updated`.
	// Повторный прогон того же прайса — обычное дело (§6.9), и отчёт «обновлено 15» там,
	// где не изменилось ничего, заставил бы админа искать несуществующие правки. Слово то
	// же, что в set-prices (§10.3), чтобы отчёты читались одинаково.
	Если Изменения.Количество() > 0 Тогда
		ДобавитьРезультат(Итог, Индекс, "update_item", Строка(КодТовара), "updated");
		Итог.updated = Итог.updated + 1;
	Иначе
		ДобавитьРезультат(Итог, Индекс, "update_item", Строка(КодТовара), "unchanged");
		Итог.unchanged = Итог.unchanged + 1;
	КонецЕсли;

КонецПроцедуры


// =====================================================================================
// add_property_value — новое значение свойства. Агент создаёт ТОЛЬКО значения свойства
// «коллекция» (§19.4); прочие выбирает из существующих, и это ограничение на его стороне.
//
// `parent_ref` необязателен: у иерархического справочника значений коллекции разложены по
// папкам вида товара и марки, и если папку передали — значение ляжет в неё.
// =====================================================================================
Процедура ДобавитьЗначениеСвойства(Итог, Индекс, Операция, СозданныеПоКлючу)

	КодСвойства = ЗначениеПоля(Операция, "property");
	Значение = СокрЛП(Строка(ЗначениеПоля(Операция, "value")));

	Если НЕ ЗначениеЗаполнено(КодСвойства) ИЛИ Значение = "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "property_value_invalid",
			"Нужны property (код свойства) и непустое value");
		Возврат;
	КонецЕсли;

	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(КодСвойства);

	Если НЕ ЗначениеЗаполнено(Свойство) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "property_not_found",
			"Не найдено свойство с кодом " + Строка(КодСвойства));
		Возврат;
	КонецЕсли;

	ИмяСправочника = СправочникЗначенийСвойства(Свойство);

	Если ИмяСправочника = "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "values_catalog_missing",
			"Не найден справочник значений свойства " + Строка(КодСвойства));
		Возврат;
	КонецЕсли;

	// Папку определяем ДО поиска дубля: искать его нужно ИМЕННО В НЕЙ.
	Папка = Неопределено;
	СсылкаРодителя = ЗначениеПоля(Операция, "parent_ref");

	Если Метаданные.Справочники[ИмяСправочника].Иерархический Тогда

		Если ЗначениеЗаполнено(СсылкаРодителя) Тогда

			Папка = НайтиЗначениеПоКоду(ИмяСправочника, СсылкаРодителя);
			Если НЕ ЗначениеЗаполнено(Папка) Тогда
				ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу,
					"value_parent_not_found",
					"Не найдена папка значений с кодом " + Строка(СсылкаРодителя));
				Возврат;
			КонецЕсли;

		Иначе

			// ПАПКИ МАРКИ В ДЕРЕВЕ ЗНАЧЕНИЙ МОЖЕТ НЕ БЫТЬ — у новой марки её нет по
			// определению, и коллекцию для неё иначе не завести. Поэтому папка создаётся
			// здесь же, по имени, внутри ветки вида товара.
			//
			// Отдельной операции для этого не заводим: она понадобилась бы ровно в паре с
			// add_property_value и всегда следом за ней, а $id пришлось бы учить работать
			// со вторым справочником. Одно поле проще и не расширяет механизм ссылок.
			Папка = ОбеспечитьПапкуЗначений(ИмяСправочника, Свойство,
				ЗначениеПоля(Операция, "folder_name"), ЗначениеПоля(Операция, "product_type"));

			// В КОРЕНЬ трёх тысяч значений класть нельзя: значение потеряется, а найти его
			// потом можно будет только перебором. На бою 08.09.2026 так «Allure» уехала в
			// чужую ветку.
			Если НЕ ЗначениеЗаполнено(Папка) Тогда
				ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу,
					"value_parent_missing",
					"Нужен parent_ref либо пара folder_name + product_type: "
					+ "значение свойства кладётся в папку марки внутри ветки вида товара");
				Возврат;
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;

	// ДУБЛЬ ИЩЕМ В ПРЕДЕЛАХ ПАПКИ, а не по всему свойству. Значения коллекций по имени НЕ
	// уникальны: у CAMSAN в базе две «Modern Long» с разными кодами, и одноимённые
	// коллекции разных марок — норма. Глобальный поиск вернул бы чужую: проба «Allure»
	// для Atlas Concorde Rus нашла значение 0001963, принадлежащее другой ветке, и агент
	// связал бы новую коллекцию с чужим кодом.
	Существующее = НайтиЗначениеПоИмени(ИмяСправочника, Свойство, Значение, Папка);

	Если ЗначениеЗаполнено(Существующее) Тогда
		ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Существующее, Индекс, Истина);
		ДобавитьРезультат(Итог, Индекс, "add_property_value",
			КодСсылки(Существующее), "exists");
		Возврат;
	КонецЕсли;

	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Владелец = Свойство;
	Элемент.Наименование = Значение;

	Если ЗначениеЗаполнено(Папка) Тогда
		Элемент.Родитель = Папка;
	КонецЕсли;

	Элемент.Записать();

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Элемент.Ссылка, "Создано значение свойства: " + Значение);

	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Элемент.Ссылка, Индекс, Истина);
	ДобавитьРезультат(Итог, Индекс, "add_property_value", КодСсылки(Элемент.Ссылка), "created");
	Итог.created = Итог.created + 1;

КонецПроцедуры


// =====================================================================================
// Учётные реквизиты нового товара (§19.4.1). Список задан админом 09.09.2026.
//
// Почему не «по умолчанию из конфигурации»: карточка, созданная не из формы, этих значений
// не получает, и товар оказывается заведён, но не работоспособен — не встаёт в учёт, не
// попадает в выгрузку, не считается по себестоимости. Внешне при этом он выглядит готовым,
// поэтому пропуск обнаруживается не сразу.
// =====================================================================================
Процедура ЗаполнитьУчётныеРеквизиты(Товар, Умолчания)

	Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
	Товар.Статус = Перечисления.ёСтатусыТовара.ВНаличии;
	Товар.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.ОсновнаяГруппа;
	Товар.СчетУчетаЗапасов = ПланыСчетов.Управленческий.СырьеИМатериалы;
	Товар.СчетУчетаЗатрат = ПланыСчетов.Управленческий.НезавершенноеПроизводство;
	Товар.МетодОценки = Перечисления.МетодОценкиЗапасов.ПоСредней;
	Товар.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
	Товар.СрокПополнения = 1;
	Товар.Автор = ПараметрыСеанса.ТекущийПользователь;
	Товар.ДатаСоздания = ТекущаяДата();

	Если ЗначениеЗаполнено(Умолчания.СтавкаНДС) Тогда
		Товар.СтавкаНДС = Умолчания.СтавкаНДС;
	КонецЕсли;

	Если ЗначениеЗаполнено(Умолчания.Склад) Тогда
		Товар.Склад = Умолчания.Склад;
	КонецЕсли;

КонецПроцедуры


// Значения, которые ищутся по справочникам: считаем ОДИН РАЗ на батч. Если не нашлись —
// оставляем пустыми, а не выдумываем: товар запишется, и админ увидит незаполненное поле,
// что честнее подставленного наугад.
Функция УмолчанияСоздания()

	Умолчания = Новый Структура("СтавкаНДС,Склад",
		Справочники.СтавкиНДС.ПустаяСсылка(), Справочники.СтруктурныеЕдиницы.ПустаяСсылка());

	Попытка
		Умолчания.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС", Истина);
	Исключение
		ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Предупреждение,
			, , "Не найдена ставка НДС «Без НДС»: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Умолчания.Склад = Справочники.СтруктурныеЕдиницы.НайтиПоКоду("000000001");
	Исключение
		ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Предупреждение,
			, , "Не найден склад 000000001: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Умолчания;

КонецФункции


// =====================================================================================
// Папка марки в дереве значений свойства: найти или создать.
//
// Дерево здесь «вид товара → ТМ → коллекции», и у НОВОЙ марки папки нет по определению —
// а без неё не завести и коллекцию. Ветка вида товара при этом уже существует всегда:
// виды товара заводятся не нами.
//
// Ищем ТОЛЬКО внутри ветки вида товара и ТОЛЬКО по точному совпадению имени — по тем же
// причинам, что и в properties.bsl: «Atlas Concorde» входит в «Atlas Concorde Rus», и
// поиск по вхождению подсунул бы папку соседней марки.
//
// ЗАВИСИМОСТЬ: `ПапкаВидаВЗначениях`, `ЧастиИмени` и `ИменаСовпадаютТочно` определены в
// properties.bsl. Файлы живут в одном модуле; дублировать их нельзя.
// =====================================================================================
Функция ОбеспечитьПапкуЗначений(ИмяСправочника, Свойство, ИмяПапки, КодВидаТовара)

	Пустая = Справочники[ИмяСправочника].ПустаяСсылка();
	Имя = СокрЛП(Строка(ИмяПапки));

	Если Имя = "" ИЛИ НЕ ЗначениеЗаполнено(КодВидаТовара) Тогда
		Возврат Пустая;
	КонецЕсли;

	ТипТовара = Справочники.ёТипыНоменклатуры.НайтиПоКоду(КодВидаТовара);
	Если НЕ ЗначениеЗаполнено(ТипТовара) Тогда
		Возврат Пустая;
	КонецЕсли;

	ВеткаВида = ПапкаВидаВЗначениях(ИмяСправочника, Свойство, ТипТовара);
	Если НЕ ЗначениеЗаполнено(ВеткаВида) Тогда
		Возврат Пустая;        // ветки вида товара нет — создавать её мы не беремся
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Ветка", ВеткаВида);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Папки.Ссылка КАК Ссылка,
		|	Папки.Наименование КАК Наименование
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Папки
		|ГДЕ
		|	Папки.Владелец = &Свойство
		|	И Папки.ЭтоГруппа = ИСТИНА
		|	И НЕ Папки.ПометкаУдаления
		|	И Папки.Ссылка В ИЕРАРХИИ (&Ветка)
		|	И Папки.Ссылка <> &Ветка";

	Выборка = Запрос.Выполнить().Выбрать();
	Части = ЧастиИмени(Имя);

	Пока Выборка.Следующий() Цикл
		Если ИменаСовпадаютТочно(Части, ЧастиИмени(Выборка.Наименование)) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Папка = Справочники[ИмяСправочника].СоздатьГруппу();
	Папка.Владелец = Свойство;
	Папка.Родитель = ВеткаВида;
	Папка.Наименование = Имя;
	Папка.Записать();

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Папка.Ссылка, "Создана папка значений свойства: " + Имя);

	Возврат Папка.Ссылка;

КонецФункции


// =====================================================================================
// update_folder — переименование папки и перенос её в другого родителя.
//
// ЗАЧЕМ ОТДЕЛЬНАЯ ОПЕРАЦИЯ. Создавать папки мы умели с самого начала, а исправлять имя —
// нет, и первая же боевая правка в это упёрлась: коллекцию назвали `QUARTZ`, а по правилу
// имён (§19.10) она `Quartz`. Переименование папки — не то же самое, что `update_item`:
// у группы нет ни артикула, ни свойств, ни единиц, и путать их в одной операции значит
// разрешить случайно записать товару поля папки.
//
// УДАЛЕНИЯ ЗДЕСЬ ТОЖЕ НЕТ. Папку можно переименовать и перенести, но не убрать — на неё
// ссылаются товары.
// =====================================================================================
Процедура ИзменитьПапку(Итог, Индекс, Операция, СозданныеПоКлючу)

	КодПапки = ЗначениеПоля(Операция, "ref");

	Если НЕ ЗначениеЗаполнено(КодПапки) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "ref_missing",
			"Не передан ref изменяемой папки");
		Возврат;
	КонецЕсли;

	Ссылка = Справочники.Номенклатура.НайтиПоКоду(КодПапки);

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "item_not_found",
			"Не найдена папка с кодом " + Строка(КодПапки));
		Возврат;
	КонецЕсли;

	Если НЕ Ссылка.ЭтоГруппа Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "parent_not_a_folder",
			"Объект " + Строка(КодПапки) + " не папка — для товаров есть update_item");
		Возврат;
	КонецЕсли;

	Папка = Ссылка.ПолучитьОбъект();
	Изменилось = Ложь;

	// В РЕГИСТР ИСТОРИИ ПАПКИ НЕ ПИШУТСЯ. Регистр заведён под правки ТОВАРА (§19.8.1), и
	// строка о папке в его ленте читалась бы как правка позиции. Переименование папки
	// видно админу в ответе и в уведомлении (§19.9), этого довольно.
	//
	// ИМЕННО ПОЭТОМУ СРАВНЕНИЕ ЗДЕСЬ ТОЧНОЕ, а не через `ИзменениеЗначимое`. У товара
	// нормализация регистра намеренно не считается правкой — её делают пачками, и в ленте
	// она была бы шумом. У папки ленты нет: единственный след правки — статус в ответе, и
	// `unchanged` на состоявшемся переименовании означает, что админ о нём не узнает.
	// Проверено на бою 09.09.2026: «QUARTZ» → «Quartz» записалось со статусом `unchanged`.
	Имя = СокрЛП(Строка(ЗначениеПоля(Операция, "name")));
	Если Имя <> "" Тогда
		Изменилось = Изменилось ИЛИ (Папка.Наименование <> Имя);
		Папка.Наименование = Имя;
	КонецЕсли;

	СсылкаРодителя = ЗначениеПоля(Операция, "parent_ref");

	Если ЗначениеЗаполнено(СсылкаРодителя) Тогда

		Разрешение = РазрешитьСсылку(СсылкаРодителя, СозданныеПоКлючу);

		Если НЕ Разрешение.Найдено Тогда
			ПропуститьИлиОтклонить(Итог, Индекс, Операция, СозданныеПоКлючу, Разрешение);
			Возврат;
		КонецЕсли;

		Проверка = ПроверитьПапкуРодителя(Разрешение.Ссылка);
		Если Проверка <> "" Тогда
			ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, Проверка,
				"Папка-родитель " + Строка(СсылкаРодителя) + ": " + ТекстПроверки(Проверка));
			Возврат;
		КонецЕсли;

		// ПЕТЛЮ В ИЕРАРХИИ (папка в собственного потомка) ловит сама платформа при записи;
		// исключение поднимется до цикла батча и станет обычной ошибкой операции.
		Если Разрешение.Ссылка <> Папка.Родитель Тогда
			Папка.Родитель = Разрешение.Ссылка;
			Изменилось = Истина;
		КонецЕсли;

	КонецЕсли;

	Папка.Записать();

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Папка.Ссылка, "Изменена папка " + Строка(КодПапки));

	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Папка.Ссылка, Индекс, Истина);

	Если Изменилось Тогда
		ДобавитьРезультат(Итог, Индекс, "update_folder", Строка(КодПапки), "updated");
		Итог.updated = Итог.updated + 1;
	Иначе
		ДобавитьРезультат(Итог, Индекс, "update_folder", Строка(КодПапки), "unchanged");
		Итог.unchanged = Итог.unchanged + 1;
	КонецЕсли;

КонецПроцедуры


// =====================================================================================
// update_property_value — переименование значения свойства и перенос его между папками.
//
// Работает и с ЭЛЕМЕНТОМ (само значение), и с ГРУППОЙ (папка марки в дереве значений):
// у обоих правится имя и родитель, а различать их вызывающему незачем — он оперирует
// кодом, который вернул `add_property_value` или `matched_folder`.
//
// Родителя можно задать двумя способами: `parent_ref` — код конкретной папки, либо
// `product_type` — код вида товара, и тогда значение переезжает в ВЕТКУ этого вида.
//
// Понадобилась дважды в один день: переименовать `QUARTZ` в `Quartz` и перенести папку
// марки, которую поиск по вхождению уложил в ветку обычного ламината вместо винилового.
// =====================================================================================
Процедура ИзменитьЗначениеСвойства(Итог, Индекс, Операция, СозданныеПоКлючу)

	КодСвойства = ЗначениеПоля(Операция, "property");
	КодЗначения = ЗначениеПоля(Операция, "ref");

	Если НЕ ЗначениеЗаполнено(КодСвойства) ИЛИ НЕ ЗначениеЗаполнено(КодЗначения) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "property_value_invalid",
			"Нужны property (код свойства) и ref (код значения или папки)");
		Возврат;
	КонецЕсли;

	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(КодСвойства);

	Если НЕ ЗначениеЗаполнено(Свойство) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "property_not_found",
			"Не найдено свойство с кодом " + Строка(КодСвойства));
		Возврат;
	КонецЕсли;

	ИмяСправочника = СправочникЗначенийСвойства(Свойство);

	Если ИмяСправочника = "" Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "values_catalog_missing",
			"Не найден справочник значений свойства " + Строка(КодСвойства));
		Возврат;
	КонецЕсли;

	Ссылка = НайтиЗначениеПоКоду(ИмяСправочника, КодЗначения);

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "property_value_not_found",
			"Не найдено значение свойства с кодом " + Строка(КодЗначения));
		Возврат;
	КонецЕсли;

	Значение = Ссылка.ПолучитьОбъект();
	БылоИмя = Значение.Наименование;
	Изменилось = Ложь;

	// Сравнение точное — по той же причине, что и у папки: истории у значения свойства нет,
	// и `unchanged` на переименовании скрыло бы правку от админа.
	Имя = СокрЛП(Строка(ЗначениеПоля(Операция, "value")));
	Если Имя <> "" Тогда
		Изменилось = Изменилось ИЛИ (БылоИмя <> Имя);
		Значение.Наименование = Имя;
	КонецЕсли;

	КодРодителя = ЗначениеПоля(Операция, "parent_ref");
	КодВидаТовара = ЗначениеПоля(Операция, "product_type");

	Если Метаданные.Справочники[ИмяСправочника].Иерархический
		И (ЗначениеЗаполнено(КодРодителя) ИЛИ ЗначениеЗаполнено(КодВидаТовара)) Тогда

		Если ЗначениеЗаполнено(КодРодителя) Тогда

			Папка = НайтиЗначениеПоКоду(ИмяСправочника, КодРодителя);
			Адрес = "папка значений с кодом " + Строка(КодРодителя);

		Иначе

			// ПЕРЕНОС В ВЕТКУ ВИДА ТОВАРА ПО КОДУ ВИДА, а не по коду папки. Ветка — это
			// папка верхнего уровня в дереве значений, и её кода агент ниоткуда не знает:
			// properties-by-type отдаёт код папки МАРКИ, а не ветки. Заставлять его искать
			// ветку перебором ради того, чтобы передать сюда код, значит гонять три тысячи
			// значений в контекст (§9.6.3).
			//
			// Ровно этот перенос и понадобился первым: папка «Linderwood» осела в ветке
			// обычного «Ламината», потому что поиск по вхождению считал его совпадением с
			// «Виниловым ламинатом».
			ТипТовара = Справочники.ёТипыНоменклатуры.НайтиПоКоду(СокрЛП(Строка(КодВидаТовара)));
			Папка = ПапкаВидаВЗначениях(ИмяСправочника, Свойство, ТипТовара);
			Адрес = "ветка вида товара " + Строка(КодВидаТовара) + " в дереве значений";

		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Папка) Тогда
			ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу,
				"value_parent_not_found", "Не найдена " + Адрес);
			Возврат;
		КонецЕсли;

		Если Папка <> Значение.Родитель Тогда
			Значение.Родитель = Папка;
			Изменилось = Истина;
		КонецЕсли;

	КонецЕсли;

	Значение.Записать();

	ЗаписьЖурналаРегистрации("ai-tools.set-items", УровеньЖурналаРегистрации.Информация,
		, Значение.Ссылка, "Изменено значение свойства " + Строка(КодЗначения));

	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Значение.Ссылка, Индекс, Истина);

	Если Изменилось Тогда
		ДобавитьРезультат(Итог, Индекс, "update_property_value", КодСсылки(Значение.Ссылка),
			"updated");
		Итог.updated = Итог.updated + 1;
	Иначе
		ДобавитьРезультат(Итог, Индекс, "update_property_value", КодСсылки(Значение.Ссылка),
			"unchanged");
		Итог.unchanged = Итог.unchanged + 1;
	КонецЕсли;

КонецПроцедуры


// =====================================================================================
// Поля товара, общие для создания и правки (§19.4). Пустая строка — всё хорошо; иначе
// возвращается КОД ОТКАЗА, и операция не пишется вовсе: товар с половиной полей хуже,
// чем ненаписанный, потому что выглядит готовым.
// =====================================================================================
Функция ЗаполнитьПоляТовара(Товар, Операция)

	Установить(Товар, "НаименованиеПолное", ЗначениеПоля(Операция, "full_name"));
	Установить(Товар, "НаименованиеДляСайта", ЗначениеПоля(Операция, "site_name"));
	Установить(Товар, "Артикул", ЗначениеПоля(Операция, "article"));
	Установить(Товар, "ДлинаОт", ЗначениеПоля(Операция, "length_from"));
	Установить(Товар, "ДлинаДо", ЗначениеПоля(Операция, "length_to"));
	Установить(Товар, "ШиринаОт", ЗначениеПоля(Операция, "width_from"));
	Установить(Товар, "ШиринаДо", ЗначениеПоля(Операция, "width_to"));
	Установить(Товар, "Толщина", ЗначениеПоля(Операция, "thickness"));

	// --- вид товара
	КодВида = ЗначениеПоля(Операция, "product_type");
	Если ЗначениеЗаполнено(КодВида) Тогда
		ВидТовара = Справочники.ёТипыНоменклатуры.НайтиПоКоду(КодВида);
		Если НЕ ЗначениеЗаполнено(ВидТовара) Тогда
			Возврат "product_type_not_found";
		КонецЕсли;
		Товар.ВидТовара = ВидТовара;
	КонецЕсли;

	// --- марка
	КодМарки = ЗначениеПоля(Операция, "manufacturer");
	Если ЗначениеЗаполнено(КодМарки) Тогда
		Производитель = Справочники.Производители.НайтиПоКоду(КодМарки);
		Если НЕ ЗначениеЗаполнено(Производитель) Тогда
			Возврат "tm_not_found";
		КонецЕсли;
		Товар.Производитель = Производитель;
	КонецЕсли;

	// --- базовая единица: ОКЕИ, общий классификатор. Ищем, никогда не создаём.
	ИмяЕИ = ЗначениеПоля(Операция, "unit");
	Если ЗначениеЗаполнено(ИмяЕИ) Тогда
		Базовая = НайтиЕдиницуКлассификатора(ИмяЕИ);
		Если НЕ ЗначениеЗаполнено(Базовая) Тогда
			Возврат "unit_not_found";
		КонецЕсли;
		Товар.ЕдиницаИзмерения = Базовая;
	КонецЕсли;

	// --- дополнительные свойства
	Свойства = ЗначениеПоля(Операция, "properties");
	Если ТипЗнч(Свойства) = Тип("Массив") Тогда
		Отказ = ЗаполнитьСвойстваТовара(Товар, Свойства);
		Если Отказ <> "" Тогда
			Возврат Отказ;
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции


// Дополнительные реквизиты: значения адресуются КОДАМИ (§19.2.2). Незнакомый код — отказ
// всей операции: товар с молча пропущенным свойством выглядит заполненным, и ошибку никто
// не заметит.
Функция ЗаполнитьСвойстваТовара(Товар, Свойства)

	Для Каждого Элемент Из Свойства Цикл

		КодСвойства = ЗначениеПоля(Элемент, "property");
		КодЗначения = ЗначениеПоля(Элемент, "value_code");

		Если НЕ ЗначениеЗаполнено(КодСвойства) Тогда
			Возврат "property_not_found";
		КонецЕсли;

		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(КодСвойства);
		Если НЕ ЗначениеЗаполнено(Свойство) Тогда
			Возврат "property_not_found";
		КонецЕсли;

		ИмяСправочника = СправочникЗначенийСвойства(Свойство);
		Если ИмяСправочника = "" Тогда
			Возврат "values_catalog_missing";
		КонецЕсли;

		Значение = НайтиЗначениеПоКоду(ИмяСправочника, КодЗначения);
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат "property_value_not_found";
		КонецЕсли;

		// Переменную нельзя назвать «Строка»: это имя встроенной функции, и она же
		// вызывается ниже по файлу.
		СтрокаРеквизита = Товар.ДополнительныеРеквизиты.Найти(Свойство, "Свойство");
		Если СтрокаРеквизита = Неопределено Тогда
			СтрокаРеквизита = Товар.ДополнительныеРеквизиты.Добавить();
			СтрокаРеквизита.Свойство = Свойство;
		КонецЕсли;
		СтрокаРеквизита.Значение = Значение;

	КонецЦикла;

	Возврат "";

КонецФункции


// =====================================================================================
// Базовая единица измерения — элемент ОКЕИ (`КлассификаторЕдиницИзмерения`), общий на всю
// базу. ТОЛЬКО ПОИСК: создавать элементы классификатора нельзя, это не наши данные, и
// вторая «м2» разошлась бы с ОКЕИ.
//
// Ищем по наименованию, а если не нашли — по коду: агент может прислать и «м2», и код ОКЕИ.
// =====================================================================================
Функция НайтиЕдиницуКлассификатора(Имя)

	Текст = СокрЛП(Строка(Имя));

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Текст);

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Классификатор.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КлассификаторЕдиницИзмерения КАК Классификатор
		|ГДЕ
		|	Классификатор.Наименование = &Имя
		|	И НЕ Классификатор.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ПоКоду = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(Текст);
	Возврат ?(ЗначениеЗаполнено(ПоКоду), ПоКоду, Неопределено);

КонецФункции


// =====================================================================================
// Упаковка — элемент ПОДЧИНЁННОГО справочника `ЕдиницыИзмерения`: у каждого товара свои,
// с коэффициентом относительно базовой. Вызывается ТОЛЬКО после записи товара: без
// записанного владельца элемент будет ничьим.
// =====================================================================================
Функция ЗаписатьУпаковку(СсылкаТовара, Операция)

	Коэффициент = ЗначениеПоля(Операция, "pack_coefficient");

	Если НЕ ЗначениеЗаполнено(Коэффициент) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ЧисловойКоэффициент = Число(Коэффициент);
	Исключение
		Возврат "pack_coefficient_invalid";
	КонецПопытки;

	Если ЧисловойКоэффициент <= 0 Тогда
		Возврат "pack_coefficient_invalid";
	КонецЕсли;

	ИмяУпаковки = СокрЛП(Строка(ЗначениеПоля(Операция, "pack_unit")));
	Если ИмяУпаковки = "" Тогда
		ИмяУпаковки = "упак";
	КонецЕсли;

	Найденная = НайтиЕдиницуТовара(СсылкаТовара, ИмяУпаковки);

	Если ЗначениеЗаполнено(Найденная) Тогда

		// Коэффициент правим, если он изменился: упаковку у поставщика меняют, и молча
		// оставить старую значило бы испортить пересчёт цены за упаковку (§6.3).
		Если Найденная.Коэффициент <> ЧисловойКоэффициент Тогда
			Объект = Найденная.ПолучитьОбъект();
			Объект.Коэффициент = ЧисловойКоэффициент;
			Объект.Записать();
		КонецЕсли;

		Возврат "";
	КонецЕсли;

	Элемент = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
	Элемент.Владелец = СсылкаТовара;
	Элемент.Наименование = ИмяУпаковки;
	Элемент.Коэффициент = ЧисловойКоэффициент;
	Элемент.Записать();

	Возврат "";

КонецФункции


// Единица товара по имени. Отбор по владельцу обязателен: справочник подчинённый, и
// «упак» без него принадлежала бы чужой позиции.
Функция НайтиЕдиницуТовара(СсылкаТовара, Имя)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", СсылкаТовара);
	Запрос.УстановитьПараметр("Имя", Имя);

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕдиницыИзмерения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Владелец = &Владелец
		|	И ЕдиницыИзмерения.Наименование = &Имя
		|	И НЕ ЕдиницыИзмерения.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


// =====================================================================================
// Разрешение ссылки: код существующего объекта или "$id" объекта из этого же батча.
// Возвращает {Найдено, Ссылка, Пропуск, ИндексРодителя}: Пропуск = Истина означает, что
// операция-родитель провалилась и эту надо не отклонить, а ПРОПУСТИТЬ каскадом (§19.8).
// =====================================================================================
Функция РазрешитьСсылку(Значение, СозданныеПоКлючу)

	Ответ = Новый Структура("Найдено,Ссылка,Пропуск,ИндексРодителя",
		Ложь, Справочники.Номенклатура.ПустаяСсылка(), Ложь, -1);

	Текст = СокрЛП(Строка(Значение));

	Если Лев(Текст, 1) = "$" Тогда

		Ключ = Сред(Текст, 2);
		Созданный = СозданныеПоКлючу.Получить(Ключ);

		Если Созданный = Неопределено Тогда
			Возврат Ответ;                      // ссылка на неизвестный id — обычный отказ
		КонецЕсли;

		Ответ.ИндексРодителя = Созданный.Индекс;

		Если НЕ Созданный.Успех Тогда
			Ответ.Пропуск = Истина;             // родитель провалился — каскадный пропуск
			Возврат Ответ;
		КонецЕсли;

		Ответ.Найдено = Истина;
		Ответ.Ссылка = Созданный.Ссылка;
		Возврат Ответ;

	КонецЕсли;

	Ссылка = Справочники.Номенклатура.НайтиПоКоду(Текст);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Ответ.Найдено = Истина;
		Ответ.Ссылка = Ссылка;
	КонецЕсли;

	Возврат Ответ;

КонецФункции


// Папка-родитель пригодна для записи? Пустая строка — да.
Функция ПроверитьПапкуРодителя(Папка)

	Если НЕ Папка.ЭтоГруппа Тогда
		Возврат "parent_not_a_folder";
	КонецЕсли;

	// Помеченные на удаление папки в базе есть, и товары в них живые (§19.2.4) — но класть
	// туда НОВОЕ нельзя: объект уже назначен к удалению.
	Если Папка.ПометкаУдаления Тогда
		Возврат "parent_deleted";
	КонецЕсли;

	Возврат "";

КонецФункции


Функция ТекстПроверки(Код)

	Если Код = "parent_not_a_folder" Тогда
		Возврат "это не папка";
	ИначеЕсли Код = "parent_deleted" Тогда
		Возврат "папка помечена на удаление";
	ИначеЕсли Код = "product_type_not_found" Тогда
		Возврат "не найден вид товара";
	ИначеЕсли Код = "tm_not_found" Тогда
		Возврат "не найдена торговая марка";
	ИначеЕсли Код = "unit_missing" Тогда
		Возврат "не передана базовая единица измерения";
	ИначеЕсли Код = "unit_not_found" Тогда
		Возврат "единица измерения не найдена в классификаторе ОКЕИ";
	ИначеЕсли Код = "pack_coefficient_invalid" Тогда
		Возврат "коэффициент упаковки не положительное число";
	ИначеЕсли Код = "property_not_found" Тогда
		Возврат "не найдено свойство";
	ИначеЕсли Код = "property_value_not_found" Тогда
		Возврат "не найдено значение свойства по коду";
	ИначеЕсли Код = "value_parent_missing" Тогда
		Возврат "не передана папка для нового значения свойства";
	ИначеЕсли Код = "value_parent_not_found" Тогда
		Возврат "не найдена папка в справочнике значений";
	ИначеЕсли Код = "values_catalog_missing" Тогда
		Возврат "не найден справочник значений свойства";
	КонецЕсли;

	Возврат Код;

КонецФункции


// Отказ операции: в errors, и её id помечается неуспешным — зависимые уйдут в пропуск.
Процедура ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, КодОшибки, Текст)

	ДобавитьОшибкуЗаписи(Итог, Индекс, Строка(ЗначениеПоля(Операция, "ref")), КодОшибки, Текст);
	ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Неопределено, Индекс, Ложь);

КонецПроцедуры


// Родитель провалился — это ПРОПУСК каскадом, а не собственная ошибка операции (§19.8).
Процедура ПропуститьИлиОтклонить(Итог, Индекс, Операция, СозданныеПоКлючу, Разрешение)

	Если Разрешение.Пропуск Тогда
		ДобавитьРезультат(Итог, Индекс, Строка(ЗначениеПоля(Операция, "op")), "",
			"skipped_dependency");
		Итог.results[Итог.results.Количество() - 1].Вставить("depends_on",
			Разрешение.ИндексРодителя);
		Итог.skipped = Итог.skipped + 1;
		ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Неопределено, Индекс, Ложь);
	Иначе
		ОтклонитьОперацию(Итог, Индекс, Операция, СозданныеПоКлючу, "parent_not_found",
			"Не найдена папка-родитель");
	КонецЕсли;

КонецПроцедуры


Процедура ЗапомнитьПоКлючу(СозданныеПоКлючу, Операция, Ссылка, Индекс, Успех)

	Ключ = ЗначениеПоля(Операция, "id");

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	СозданныеПоКлючу.Вставить(СокрЛП(Строка(Ключ)),
		Новый Структура("Ссылка,Индекс,Успех", Ссылка, Индекс, Успех));

КонецПроцедуры


// Справочник значений конкретного свойства: берём из типа значения самого свойства, а не
// из списка имён — так же, как единица измерения.
Функция СправочникЗначенийСвойства(Свойство)

	ОписаниеТипа = Свойство.ТипЗначения;

	Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
		Если ОписаниеТипа.СодержитТип(Тип("СправочникСсылка." + МетаданныеСправочника.Имя)) Тогда
			Возврат МетаданныеСправочника.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции


Функция НайтиЗначениеПоКоду(ИмяСправочника, Код)

	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденное = Справочники[ИмяСправочника].НайтиПоКоду(СокрЛП(Строка(Код)));
	Возврат ?(ЗначениеЗаполнено(Найденное), Найденное, Неопределено);

КонецФункции


// Дубль значения ищется В ЗАДАННОЙ ПАПКЕ. Папка не передана — ищем по всему свойству; так
// бывает у плоских справочников значений, где одноимённых значений действительно быть не
// должно.
Функция НайтиЗначениеПоИмени(ИмяСправочника, Свойство, Имя, Папка = Неопределено)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Имя", СокрЛП(Строка(Имя)));
	Запрос.УстановитьПараметр("Папка", Папка);
	Запрос.УстановитьПараметр("ЕстьПапка", ЗначениеЗаполнено(Папка));

	УсловиеПапки = ?(Метаданные.Справочники[ИмяСправочника].Иерархический,
		"
		|	И (НЕ &ЕстьПапка ИЛИ Значения.Ссылка В ИЕРАРХИИ (&Папка))", "");

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Значения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Значения
		|ГДЕ
		|	Значения.Владелец = &Свойство
		|	И Значения.Наименование = &Имя
		|	И НЕ Значения.ПометкаУдаления" + УсловиеПапки + ";";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


// =====================================================================================
// ИСТОРИЯ ПРАВОК АГЕНТОМ — РегистрСведений.ИсторияПравокТовараИИАгентом
//
// Формат записи задан админом:
//
//     <пустая строка>
//     <дата изменения>
//     <Имя поля>: старое значение -> новое значение
//     …
//
// Накапливаем, а не перезаписываем: регистр независимый, измерение — номенклатура, и
// смысл его в том, чтобы видеть ВСЮ историю правок позиции, а не последнюю.
//
// ЧТО В ИСТОРИЮ НЕ ПОПАДАЕТ. Изменения, не затронувшие значимых символов: схлопнутые
// двойные пробелы, обрезанные края. Такие правки массовые — только по Peli их 25 штук, —
// и запись о них превратила бы историю в шум, сквозь который человек не найдёт настоящую
// правку. Само значение при этом в справочнике меняется: чистим, но не отчитываемся.
// =====================================================================================
Процедура ЗаписатьИсториюПравок(СсылкаТовара, Заголовок, Изменения)

	Момент = ТекущаяДата();

	Запись = РегистрыСведений.ИсторияПравокТовараИИАгентом.СоздатьМенеджерЗаписи();
	Запись.Номенклатура = СсылкаТовара;
	Запись.Прочитать();

	// Если записи не было, Прочитать() очищает и измерения — проставляем заново.
	Запись.Номенклатура = СсылкаТовара;

	// НОВОЕ СВЕРХУ. Историю открывают, чтобы посмотреть последнее изменение, а не первое;
	// при дописывании в конец пришлось бы каждый раз проматывать её целиком, и чем дольше
	// живёт позиция, тем дальше уезжает нужное.
	Блок = Формат(Момент, "ДФ=dd.MM.yyyy HH:mm:ss") + Символы.ПС;

	Если ЗначениеЗаполнено(Заголовок) Тогда
		Блок = Блок + Заголовок + Символы.ПС;
	КонецЕсли;

	Для Каждого Строка Из Изменения Цикл
		Блок = Блок + Строка + Символы.ПС;
	КонецЦикла;

	Прежнее = Запись.ИсторияИзменений;

	// Пустая строка — РАЗДЕЛИТЕЛЬ между записями. У самой верхней её быть не должно,
	// поэтому добавляется только когда снизу что-то есть.
	Текст = Блок + ?(ЗначениеЗаполнено(Прежнее), Символы.ПС + Прежнее, "");

	Запись.ИсторияИзменений = Текст;
	Запись.ДатаПоследнегоИзменения = Момент;
	Запись.Записать();

КонецПроцедуры


// Снимок полей ДО правки. Берётся до первого присваивания: после него сравнивать не с чем.
Функция СнимокПолейТовара(Товар)

	Снимок = Новый Структура;

	Для Каждого ЭлементПоля Из ПоляИстории() Цикл
		Снимок.Вставить(ЭлементПоля.Ключ, Строка(Товар[ЭлементПоля.Ключ]));
	КонецЦикла;

	Снимок.Вставить("__Свойства", СвойстваСнимком(Товар));

	Возврат Снимок;

КонецФункции


// Поля, за которыми следим, и их человеческие имена: историю читает человек, «ДлинаОт»
// ему ничего не скажет.
Функция ПоляИстории()

	Поля = Новый Соответствие;
	Поля.Вставить("Наименование", "Наименование");
	Поля.Вставить("НаименованиеПолное", "Полное наименование");
	Поля.Вставить("НаименованиеДляСайта", "Наименование для сайта");
	Поля.Вставить("Артикул", "Артикул");
	Поля.Вставить("Родитель", "Папка");
	Поля.Вставить("ВидТовара", "Вид товара");
	Поля.Вставить("Производитель", "Торговая марка");
	Поля.Вставить("ЕдиницаИзмерения", "Единица измерения");
	Поля.Вставить("ДлинаОт", "Длина от");
	Поля.Вставить("ДлинаДо", "Длина до");
	Поля.Вставить("ШиринаОт", "Ширина от");
	Поля.Вставить("ШиринаДо", "Ширина до");
	Поля.Вставить("Толщина", "Толщина");

	Возврат Поля;

КонецФункции


// Дополнительные реквизиты снимком: «имя свойства» → «представление значения».
Функция СвойстваСнимком(Товар)

	Значения = Новый Соответствие;

	Для Каждого СтрокаРеквизита Из Товар.ДополнительныеРеквизиты Цикл
		Если ЗначениеЗаполнено(СтрокаРеквизита.Свойство) Тогда
			Значения.Вставить(Строка(СтрокаРеквизита.Свойство),
				Строка(СтрокаРеквизита.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Значения;

КонецФункции


// Строки «Поле: старое -> новое» по всем содержательно изменившимся полям.
Функция ОписаниеИзменений(Снимок, Товар)

	Изменения = Новый Массив;

	Для Каждого ЭлементПоля Из ПоляИстории() Цикл

		Было = "";
		Снимок.Свойство(ЭлементПоля.Ключ, Было);
		Стало = Строка(Товар[ЭлементПоля.Ключ]);

		Если ИзменениеЗначимое(Было, Стало) Тогда
			Изменения.Добавить(ЭлементПоля.Значение + ": "
				+ ПредставлениеДляИстории(Было) + " -> " + ПредставлениеДляИстории(Стало));
		КонецЕсли;

	КонецЦикла;

	// --- дополнительные реквизиты
	БылоСвойства = Новый Соответствие;
	Снимок.Свойство("__Свойства", БылоСвойства);
	СталоСвойства = СвойстваСнимком(Товар);

	Для Каждого ЭлементСвойства Из СталоСвойства Цикл
		Прежнее = БылоСвойства.Получить(ЭлементСвойства.Ключ);
		Прежнее = ?(Прежнее = Неопределено, "", Прежнее);
		Если ИзменениеЗначимое(Прежнее, ЭлементСвойства.Значение) Тогда
			Изменения.Добавить(ЭлементСвойства.Ключ + ": "
				+ ПредставлениеДляИстории(Прежнее) + " -> "
				+ ПредставлениеДляИстории(ЭлементСвойства.Значение));
		КонецЕсли;
	КонецЦикла;

	// Свойство могли не изменить, а СНЯТЬ — это тоже правка, и её надо видеть.
	Для Каждого ЭлементСвойства Из БылоСвойства Цикл
		Если СталоСвойства.Получить(ЭлементСвойства.Ключ) = Неопределено
			И ЗначениеЗаполнено(ЭлементСвойства.Значение) Тогда
			Изменения.Добавить(ЭлементСвойства.Ключ + ": "
				+ ПредставлениеДляИстории(ЭлементСвойства.Значение) + " -> (снято)");
		КонецЕсли;
	КонецЦикла;

	Возврат Изменения;

КонецФункции


// Значимо ли изменение. НЕТ, если строки различаются только пробелами или регистром:
// «Ламинат Peli  Vintage» → «Ламинат Peli Vintage» и «Дуб МЕДОВЫЙ» → «Дуб Медовый» — это
// приведение в порядок, а не новое значение. Значение в справочнике при этом меняется:
// чиним, но в историю не пишем, иначе она утонет в шуме.
Функция ИзменениеЗначимое(Было, Стало)

	Возврат ЗначимаяФорма(Было) <> ЗначимаяФорма(Стало);

КонецФункции


// Форма для сравнения: пробелы схлопнуты, края обрезаны, регистр снят. Используется ТОЛЬКО
// при сравнении — записывается в справочник всегда то, что прислал агент.
Функция ЗначимаяФорма(Текст)

	Возврат НРег(СхлопнутьПробелы(Текст));

КонецФункции


// Пробельные участки в один пробел, края обрезаются.
Функция СхлопнутьПробелы(Знач Текст)

	Результат = СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.Таб, " "), Символы.ПС, " ");

	Пока Найти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции


// Пустое значение в истории показываем явно: «(пусто) -> AN DSG 901» читается, а
// « -> AN DSG 901» выглядит опечаткой.
Функция ПредставлениеДляИстории(Значение)

	Текст = СокрЛП(Строка(Значение));
	Возврат ?(Текст = "", "(пусто)", Текст);

КонецФункции


// =====================================================================================
// Мелочи: чтение поля из Структуры или Соответствия, установка реквизита, конверт ответа.
// =====================================================================================

// Читаем БЕЗОПАСНО: обращение по индексу к отсутствующему ключу бросает «Поле объекта не
// обнаружено» — на этом мы уже теряли круг выкладки в properties-by-type.
Функция ЗначениеПоля(Объект, Имя)

	Если ТипЗнч(Объект) = Тип("Структура") ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") Тогда
		Значение = Неопределено;
		Объект.Свойство(Имя, Значение);
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Объект.Получить(Имя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции


// Поле, которого нет в запросе, НЕ ТРОГАЕМ: отсутствие означает «не менять», а не
// «очистить». Агент присылает разницу, а не полную карточку.
Процедура Установить(Товар, ИмяРеквизита, Значение)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Товар[ИмяРеквизита] = СокрЛП(Значение);
	Иначе
		Товар[ИмяРеквизита] = Значение;
	КонецЕсли;

КонецПроцедуры


Функция КодСсылки(Ссылка)

	Попытка
		Возврат СокрЛП(Строка(Ссылка.Код));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции


// Сообщения пользователю, накопленные платформой. Именно в них 1С кладёт причину отказа
// записи: какой реквизит не заполнен, какая проверка не прошла. Забираем с очисткой
// (параметр Истина), чтобы они не достались следующей операции.
Функция ТекстСообщенийПользователю()

	Тексты = "";

	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Если СокрЛП(Сообщение.Текст) = "" Тогда
			Продолжить;
		КонецЕсли;
		Тексты = Тексты + ?(Тексты = "", "", "; ") + СокрЛП(Сообщение.Текст);
	КонецЦикла;

	Возврат Тексты;

КонецФункции


Функция НовыйИтогЗаписи()

	Итог = Новый Структура;
	Итог.Вставить("date", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd"));
	Итог.Вставить("created", 0);
	Итог.Вставить("updated", 0);
	Итог.Вставить("unchanged", 0);
	Итог.Вставить("skipped", 0);
	Итог.Вставить("failed", 0);
	Итог.Вставить("results", Новый Массив);
	Итог.Вставить("errors", Новый Массив);

	Возврат Итог;

КонецФункции


Процедура ДобавитьРезультат(Итог, Индекс, ВидОперации, КодОбъекта, Статус)

	Запись = Новый Структура;
	Запись.Вставить("index", Индекс);
	Запись.Вставить("op", Строка(ВидОперации));
	Запись.Вставить("ref", Строка(КодОбъекта));
	Запись.Вставить("status", Статус);

	Итог.results.Добавить(Запись);

КонецПроцедуры


// Предупреждение: попадает в errors, чтобы админ увидел, но НЕ увеличивает failed —
// операция состоялась.
Процедура ДобавитьПредупреждение(Итог, Индекс, КодОшибки, Текст)

	Ошибка = Новый Структура;
	Ошибка.Вставить("index", Индекс);
	Ошибка.Вставить("ref", "");
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", Текст);

	Итог.errors.Добавить(Ошибка);

КонецПроцедуры


Процедура ДобавитьОшибкуЗаписи(Итог, Индекс, Ссылка, КодОшибки, Текст)

	Ошибка = Новый Структура;
	Ошибка.Вставить("index", Индекс);
	Ошибка.Вставить("ref", Строка(Ссылка));
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", Текст);

	Итог.errors.Добавить(Ошибка);
	Итог.failed = Итог.failed + 1;

КонецПроцедуры
