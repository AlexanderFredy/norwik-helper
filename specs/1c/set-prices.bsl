// =====================================================================================
// HTTP-сервис 1С: ai-tools / ProductManagement — обработчик POST set-prices
//
// Исправленный вариант кода (см. specs/content-manager.md §10).
// Кодировка файла: UTF-8. Перед вставкой в конфигуратор сверить с примечаниями внизу.
//
// Что изменено относительно исходной версии:
//   1. Результат УстановитьЦены() больше не затирается объектом HTTPСервисОтвет.
//   2. УстановитьЦены() всегда возвращает значение.
//   3. Результаты собираются в Массив (был Структура + вызов .Добавить()).
//   4. Проверки "не найдено" — через .Пустая(), а не = Неопределено
//      (НайтиПоКоду возвращает ПУСТУЮ ССЫЛКУ, а не Неопределено).
//   5. Убран Item.Индекс (у Структуры такого свойства нет) — свой счётчик.
//   6. Разбор JSON и вся работа обёрнуты в Попытка → при сбое отдаётся JSON, а не HTML 1С.
//   7. Проверяются виды цен, ЭтоГруппа, НеВыгружать; отбор по коллекции — фильтрами запроса.
//   8. Пустая выборка по коллекции больше не «тихий успех» — попадает в errors.
//   9. Цена валидируется по типу и знаку; текст исключения не теряется.
//  10. Период записи — НачалоДня(ТекущаяДатаСеанса()) (регистр с периодичностью ДЕНЬ).
// =====================================================================================


Функция ProductManagementPOST(Запрос)

	Если НЕ МодульHTTPСервисов.ПроверитьТокен(Запрос) Тогда
		Возврат ОтветJSON(401, Новый Структура("error", "Unauthorized"));
	КонецЕсли;

	Если Запрос.ПараметрыURL.Получить("query-type") <> "set-prices" Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "unknown query-type"));
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат ОтветJSON(400, Новый Структура("error", "invalid json"));
	КонецПопытки;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = УстановитьЦены(Данные);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат ОтветJSON(200, Результат);

КонецФункции


Функция ОтветJSON(Код, Данные)

	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(МодульHTTPСервисов.ЗаписьJSONВСтруктуру(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции


Функция ИтогЗаписи(Записано, Результаты, Ошибки)

	Возврат Новый Структура("updated, results, errors", Записано, Результаты, Ошибки);

КонецФункции


Функция УстановитьЦены(Данные)

	Результаты = Новый Массив;
	Ошибки     = Новый Массив;
	Записано   = 0;

	Если НЕ Данные.Свойство("items") ИЛИ ТипЗнч(Данные["items"]) <> Тип("Массив") Тогда
		Ошибки.Добавить("items not found");
		Возврат ИтогЗаписи(0, Результаты, Ошибки);
	КонецЕсли;

	ВидЗакупки = Справочники.ВидыЦен.НайтиПоКоду("00-000003");
	ВидРРЦ     = Справочники.ВидыЦен.НайтиПоКоду("YO-000005");
	Если ВидЗакупки.Пустая() ИЛИ ВидРРЦ.Пустая() Тогда
		Ошибки.Добавить("price types are not configured");
		Возврат ИтогЗаписи(0, Результаты, Ошибки);
	КонецЕсли;

	Индекс = -1;
	Для Каждого Item Из Данные["items"] Цикл

		Индекс = Индекс + 1;
		Префикс = Формат(Индекс, "ЧГ=0") + "th item";

		Если НЕ Item.Свойство("prices") ИЛИ ТипЗнч(Item["prices"]) <> Тип("Структура") Тогда
			Ошибки.Добавить("prices not found for " + Префикс);
			Продолжить;
		КонецЕсли;

		Если НЕ Item.Свойство("tm") Тогда
			Ошибки.Добавить("tm not found for " + Префикс);
			Продолжить;
		КонецЕсли;

		КодТМ = Строка(Item["tm"]);
		Производитель = Справочники.Производители.НайтиПоКоду(КодТМ);
		Если Производитель.Пустая() Тогда
			Ошибки.Добавить("tm " + КодТМ + " not found");
			Продолжить;
		ИначеЕсли Производитель.ПометкаУдаления Тогда
			Ошибки.Добавить("tm " + КодТМ + " has a delete mark");
			Продолжить;
		КонецЕсли;

		Если Item.Свойство("collection_ref") Тогда
			// --- форма (а): цены на всю коллекцию ---

			КодКоллекции = Строка(Item["collection_ref"]);
			Коллекция = НайтиКоллекцию(КодКоллекции, Ошибки);
			Если Коллекция = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ЗаписанныеКоды = Новый Массив;
			ЗаполнитьЦеныПоКоллекции(Коллекция, Производитель, Item["prices"], ВидЗакупки, ВидРРЦ, ЗаписанныеКоды, Ошибки);

			Если ЗаписанныеКоды.Количество() = 0 Тогда
				Ошибки.Добавить("no items found for collection " + КодКоллекции + " and tm " + КодТМ);
			Иначе
				Результаты.Добавить(Новый Структура("collection_ref, written_refs, count",
					КодКоллекции, ЗаписанныеКоды, ЗаписанныеКоды.Количество()));
				Записано = Записано + ЗаписанныеКоды.Количество();
			КонецЕсли;

		ИначеЕсли Item.Свойство("ref") Тогда
			// --- форма (б): цена на конкретный товар (tm — защитная сверка бренда) ---

			Товар = НайтиТовар(Строка(Item["ref"]), КодТМ, Ошибки);
			Если Товар = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Запись = ЗаписатьЦеныТовара(Товар, Item["prices"], ВидЗакупки, ВидРРЦ, Ошибки);
			Если Запись <> Неопределено Тогда
				Результаты.Добавить(Запись);
				Записано = Записано + 1;
			КонецЕсли;

		Иначе
			Ошибки.Добавить("neither ref nor collection_ref for " + Префикс);
		КонецЕсли;

	КонецЦикла;

	Возврат ИтогЗаписи(Записано, Результаты, Ошибки);

КонецФункции


Функция НайтиКоллекцию(КодРодителя, Ошибки)

	Родитель = Справочники.Номенклатура.НайтиПоКоду(КодРодителя);

	Если Родитель.Пустая() Тогда
		Ошибки.Добавить("collection folder " + КодРодителя + " not found");
	ИначеЕсли НЕ Родитель.ЭтоГруппа Тогда
		Ошибки.Добавить("collection folder " + КодРодителя + " is not a folder");
	ИначеЕсли Родитель.ПометкаУдаления Тогда
		Ошибки.Добавить("collection folder " + КодРодителя + " has a delete mark");
	ИначеЕсли Родитель.НеВыгружать Тогда
		Ошибки.Добавить("collection folder " + КодРодителя + " has a not use mark");
	Иначе
		Возврат Родитель;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


Функция НайтиТовар(КодТовара, КодТМ, Ошибки)

	Товар = Справочники.Номенклатура.НайтиПоКоду(КодТовара);

	Если Товар.Пустая() Тогда
		Ошибки.Добавить("product " + КодТовара + " not found");
	ИначеЕсли Товар.ЭтоГруппа Тогда
		Ошибки.Добавить("product " + КодТовара + " is a folder");
	ИначеЕсли Товар.ПометкаУдаления Тогда
		Ошибки.Добавить("product " + КодТовара + " has a delete mark");
	ИначеЕсли Товар.НеВыгружать Тогда
		Ошибки.Добавить("product " + КодТовара + " has a not use mark");
	ИначеЕсли Товар.Производитель.Пустая() Тогда
		Ошибки.Добавить("product " + КодТовара + " doesn't have a tm");
	ИначеЕсли Товар.Производитель.Код <> КодТМ Тогда
		Ошибки.Добавить("product " + КодТовара + " has a different tm. from query=" + КодТМ
			+ ", but from db=" + Товар.Производитель.Код);
	Иначе
		Возврат Товар;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


Процедура ЗаполнитьЦеныПоКоллекции(Группа, Производитель, Цены, ВидЗакупки, ВидРРЦ, ЗаписанныеКоды, Ошибки)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Номенклатура.Ссылка КАК Ссылка,
	                      |	Номенклатура.Код КАК Код
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	Номенклатура.Родитель = &Родитель
	                      |	И Номенклатура.Производитель = &Производитель
	                      |	И НЕ Номенклатура.ЭтоГруппа
	                      |	И НЕ Номенклатура.ПометкаУдаления
	                      |	И НЕ Номенклатура.НеВыгружать");

	Запрос.УстановитьПараметр("Родитель", Группа);
	Запрос.УстановитьПараметр("Производитель", Производитель);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗаписатьЦеныТовара(Выборка.Ссылка, Цены, ВидЗакупки, ВидРРЦ, Ошибки) <> Неопределено Тогда
			ЗаписанныеКоды.Добавить(Выборка.Код);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


Функция ЗаписатьЦеныТовара(Товар, Цены, ВидЗакупки, ВидРРЦ, Ошибки)

	Записано = Новый Структура;
	ЗаписатьОднуЦену(Товар, Цены, "purchase", ВидЗакупки, Записано, Ошибки);
	ЗаписатьОднуЦену(Товар, Цены, "rrc",      ВидРРЦ,     Записано, Ошибки);

	Если Записано.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ref, written", Товар.Код, Записано);

КонецФункции


Процедура ЗаписатьОднуЦену(Товар, Цены, Ключ, ВидЦены, Записано, Ошибки)

	Если НЕ Цены.Свойство(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Цена = Цены[Ключ];
	Если ТипЗнч(Цена) <> Тип("Число") ИЛИ Цена <= 0 Тогда
		Ошибки.Добавить("invalid " + Ключ + " price for " + Товар.Код);
		Возврат;
	КонецЕсли;

	Попытка
		Запись = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
		Запись.Период           = НачалоДня(ТекущаяДатаСеанса());
		Запись.Номенклатура     = Товар;
		Запись.ВидЦен           = ВидЦены;
		Запись.ЕдиницаИзмерения = Товар.ЕдиницаИзмерения;
		Запись.Цена             = Цена;
		Запись.Актуальность     = Истина;
		Запись.Автор            = ПараметрыСеанса.ТекущийПользователь;
		Запись.Записать(Истина);          // замещаем запись того же дня — §10.5 спеки
		Записано.Вставить(Ключ, Цена);
	Исключение
		Ошибки.Добавить("cannot write " + Ключ + " for " + Товар.Код + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры


// =====================================================================================
// ПРОВЕРИТЬ В КОНФИГУРАЦИИ (не видно со стороны спеки):
//
//  * Точное имя реквизита единицы измерения у Номенклатуры (здесь: ЕдиницаИзмерения).
//  * Реквизит НеВыгружать: есть ли он у САМОЙ номенклатуры (в коде он проверяется и у
//    товара, и у папки). Если флаг каскадный по иерархии — подставить ту же функцию
//    определения экспортируемости, что используется в selling-tm.
//  * ПараметрыСеанса.ТекущийПользователь: заполняется ли в сеансе HTTP-сервиса. Если нет —
//    вынести в отдельную проверку перед циклом, иначе каждая позиция упадёт в
//    "cannot write ...".
//  * Наличие метода МодульHTTPСервисов.ЗаписьJSONВСтруктуру для произвольной структуры
//    (здесь ему передаётся {updated, results, errors}).
// =====================================================================================
