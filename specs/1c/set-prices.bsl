// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик POST get-products/set-prices
//
// Контракт — specs/content-manager.md §10. Кодировка файла: UTF-8.
//
// Запрос:
//   { "items": [
//       { "tm": "000000311", "collection_ref": "YO-00075139",          // форма (а)
//         "prices": { "purchase": 900, "retail": 1080, "rrc": 2070 } },
//       { "tm": "000000298", "ref": "YO-00068864",                     // форма (б)
//         "prices": { "purchase": 999, "retail": 1199 } } ] }
//
// Виды цен: purchase = 00-000003, retail = YO-000004, rrc = YO-000005. Розничная цена
// вычисляется на нашей стороне по specs/retail-price-rules.md, из прайса не берётся.
// Передавать можно любое подмножество — пишутся только присланные виды.
//
// Ответ спроектирован так, чтобы агент собрал сообщение админу в Telegram БЕЗ повторных
// запросов в 1С: в каждой записи есть наименование, коллекция, ТМ и старое значение цены
// с датой, а ошибки — объекты с машинным `code`, номером позиции запроса и `ref`.
//
//   { "date": "2026-08-10",          // день, которым проставлены цены
//     "updated": 21,                 // товаров, где записана хотя бы одна цена
//     "unchanged": 1,                // товаров, где все цены уже равны переданным
//     "failed": 2,                   // позиций запроса, отвергнутых с ошибкой
//     "results": [
//       // форма (а) — изменения СГРУППИРОВАНЫ по одинаковому переходу цены:
//       { "index": 0, "collection_ref": "YO-00075139", "collection": "Excellent",
//         "tm": "000000311", "tm_name": "Most Flooring",
//         "count": 8, "updated": 8, "unchanged": 0,
//         "changes": [
//           { "price_type": "rrc", "old": 2270, "old_date": "2025-10-20", "new": 2070,
//             "count": 7, "refs": ["YO-00075141", "…"] },
//           { "price_type": "rrc", "old": null, "old_date": "", "new": 2070,
//             "count": 1, "refs": ["YO-00077618"] } ] },   // РРЦ проставлена впервые
//       // форма (б) — по товару, как было:
//       { "index": 1, "ref": "YO-00068864", "name": "Ламинат Peli Vintage ...",
//         "collection": "Vintage", "collection_ref": "YO-00068859",
//         "tm": "000000298", "tm_name": "Peli",
//         "written": { "purchase": { "old": 949, "old_date": "2026-07-20", "new": 999 } } } ],
//     "errors": [
//       { "index": 2, "ref": "YO-99999999", "code": "product_not_found",
//         "message": "product YO-99999999 not found" } ] }
//
// `old` = null, если цены этого вида раньше не было (проставляется впервые).
// Если переданная цена равна текущей — запись НЕ делается, позиция попадает в `skipped`
// с reason "same": так дата последнего изменения в регистре остаётся правдивой, а админ
// видит «уже актуально» вместо ложного «обновлено». В форме (а) такие товары образуют
// свою группу с "skipped": true.
//
// Почему в форме (а) группы, а не список товаров: цена по коллекции обычно единая, поэтому
// на 200 SKU поштучный список с наименованиями раздувает ответ в десятки раз, повторяя одни
// и те же old/new. Аудит сохраняется — все коды перечислены в `refs`; наименования агент
// берёт из by-tm, который у него уже загружен. Товары-исключения (цена впервые / уже
// актуальна) выделяются в отдельную группу автоматически.
//
// Коды ошибок (`code`): items_missing, prices_missing, price_types_missing, tm_missing,
// tm_not_found, tm_deleted, target_missing, collection_not_found, collection_not_a_folder,
// collection_deleted, collection_not_exported, collection_empty, product_not_found,
// product_is_folder, product_deleted, product_not_exported, product_without_tm,
// product_tm_mismatch, price_invalid, write_failed.
//
// Реквизиты справочника читаются ЗАПРОСОМ, а не через точку от ссылки: если у реквизита
// «Использование» = «Для группы» (как может быть у НеВыгружать), обращение Товар.НеВыгружать
// бросает «Поле объекта не обнаружено», а запрос вернёт NULL → ЕСТЬNULL.
// =====================================================================================


Функция ProductManagementPOST(Запрос)

	Если НЕ МодульHTTPСервисов.ПроверитьТокен(Запрос) Тогда
		Возврат ОтветJSON(401, Новый Структура("error", "Unauthorized"));
	КонецЕсли;

	Если Запрос.ПараметрыURL.Получить("query-type") <> "set-prices" Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "unknown query-type"));
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат ОтветJSON(400, Новый Структура("error", "invalid json"));
	КонецПопытки;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = УстановитьЦены(Данные);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Попытка
		Возврат ОтветJSON(200, Результат);
	Исключение
		// сериализация ответа не должна возвращать HTML-страницу IIS
		Возврат ОтветJSON(500, Новый Структура("error",
			"cannot serialize response: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецФункции


Функция ОтветJSON(Код, Данные)

	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(МодульHTTPСервисов.ЗаписьJSONВСтруктуру(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции


Функция НовыйИтог(ДеньЗаписи)

	Итог = Новый Структура;
	Итог.Вставить("date", Формат(ДеньЗаписи, "ДФ=yyyy-MM-dd"));
	Итог.Вставить("updated", 0);
	Итог.Вставить("unchanged", 0);
	Итог.Вставить("failed", 0);
	Итог.Вставить("results", Новый Массив);
	Итог.Вставить("errors", Новый Массив);
	Возврат Итог;

КонецФункции


Процедура ДобавитьОшибку(Итог, Индекс, Ссылка, КодОшибки, Текст)

	Ошибка = Новый Структура;
	Ошибка.Вставить("index", Индекс);
	Ошибка.Вставить("ref", Ссылка);
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", Текст);
	Итог["errors"].Добавить(Ошибка);
	Итог["failed"] = Итог["failed"] + 1;

КонецПроцедуры


Функция УстановитьЦены(Данные)

	ДеньЗаписи = НачалоДня(ТекущаяДатаСеанса());
	Итог = НовыйИтог(ДеньЗаписи);

	Если НЕ Данные.Свойство("items") ИЛИ ТипЗнч(Данные["items"]) <> Тип("Массив") Тогда
		ДобавитьОшибку(Итог, -1, "", "items_missing", "items not found");
		Возврат Итог;
	КонецЕсли;

	// Ключ JSON → вид цены. Добавить новый вид = дописать строку сюда.
	ВидыЦен = Новый Соответствие;
	Ненайденные = "";
	КодыВидовЦен = Новый Соответствие;
	КодыВидовЦен.Вставить("purchase", "00-000003");   // цена закупки
	КодыВидовЦен.Вставить("retail",   "YO-000004");   // розничная цена (specs/retail-price-rules.md)
	КодыВидовЦен.Вставить("rrc",      "YO-000005");   // РРЦ

	Для Каждого КлючЗначение Из КодыВидовЦен Цикл
		Вид = Справочники.ВидыЦен.НайтиПоКоду(КлючЗначение.Значение);
		Если Вид.Пустая() Тогда
			Ненайденные = Ненайденные + ?(ПустаяСтрока(Ненайденные), "", ", ") + КлючЗначение.Значение;
		Иначе
			ВидыЦен.Вставить(КлючЗначение.Ключ, Вид);
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПустаяСтрока(Ненайденные) Тогда
		ДобавитьОшибку(Итог, -1, "", "price_types_missing",
			"price types not found: " + Ненайденные);
		Возврат Итог;
	КонецЕсли;

	Автор = Неопределено;
	Попытка
		Автор = ПараметрыСеанса.ТекущийПользователь;
	Исключение
		Автор = Неопределено;   // сеанс HTTP-сервиса без интерактивного пользователя
	КонецПопытки;

	Индекс = -1;
	Для Каждого Item Из Данные["items"] Цикл

		Индекс = Индекс + 1;

		Если ТипЗнч(Item) <> Тип("Структура") Тогда
			ДобавитьОшибку(Итог, Индекс, "", "prices_missing", "item is not an object");
			Продолжить;
		КонецЕсли;

		Если НЕ Item.Свойство("prices") ИЛИ ТипЗнч(Item["prices"]) <> Тип("Структура") Тогда
			ДобавитьОшибку(Итог, Индекс, "", "prices_missing",
				"prices not found for " + Формат(Индекс, "ЧГ=0; ЧН=0") + "th item");
			Продолжить;
		КонецЕсли;

		Если НЕ Item.Свойство("tm") Тогда
			ДобавитьОшибку(Итог, Индекс, "", "tm_missing",
				"tm not found for " + Формат(Индекс, "ЧГ=0; ЧН=0") + "th item");
			Продолжить;
		КонецЕсли;

		КодТМ = Строка(Item["tm"]);
		Производитель = Справочники.Производители.НайтиПоКоду(КодТМ);
		Если Производитель.Пустая() Тогда
			ДобавитьОшибку(Итог, Индекс, "", "tm_not_found", "tm " + КодТМ + " not found");
			Продолжить;
		ИначеЕсли Производитель.ПометкаУдаления Тогда
			ДобавитьОшибку(Итог, Индекс, "", "tm_deleted", "tm " + КодТМ + " has a delete mark");
			Продолжить;
		КонецЕсли;
		НаименованиеТМ = СокрЛП(Производитель.Наименование);

		Если Item.Свойство("collection_ref") Тогда
			ОбработатьКоллекцию(Итог, Индекс, Строка(Item["collection_ref"]), КодТМ, НаименованиеТМ,
				Производитель, Item["prices"], ВидыЦен, ДеньЗаписи, Автор);
		ИначеЕсли Item.Свойство("ref") Тогда
			ОбработатьТовар(Итог, Индекс, Строка(Item["ref"]), КодТМ, НаименованиеТМ,
				Item["prices"], ВидыЦен, ДеньЗаписи, Автор);
		Иначе
			ДобавитьОшибку(Итог, Индекс, "", "target_missing",
				"neither ref nor collection_ref for " + Формат(Индекс, "ЧГ=0; ЧН=0") + "th item");
		КонецЕсли;

	КонецЦикла;

	Возврат Итог;

КонецФункции


// ---------------------------------------------------------------- форма (а): коллекция

Процедура ОбработатьКоллекцию(Итог, Индекс, КодПапки, КодТМ, НаименованиеТМ, Производитель,
		Цены, ВидыЦен, ДеньЗаписи, Автор)

	Папка = РеквизитыПоКоду(КодПапки);

	Если Папка = Неопределено Тогда
		ДобавитьОшибку(Итог, Индекс, КодПапки, "collection_not_found",
			"collection folder " + КодПапки + " not found");
		Возврат;
	ИначеЕсли НЕ Папка.ЭтоГруппа Тогда
		ДобавитьОшибку(Итог, Индекс, КодПапки, "collection_not_a_folder",
			"collection folder " + КодПапки + " is not a folder");
		Возврат;
	ИначеЕсли Папка.ПометкаУдаления Тогда
		ДобавитьОшибку(Итог, Индекс, КодПапки, "collection_deleted",
			"collection folder " + КодПапки + " has a delete mark");
		Возврат;
	ИначеЕсли Папка.НеВыгружать Тогда
		ДобавитьОшибку(Итог, Индекс, КодПапки, "collection_not_exported",
			"collection folder " + КодПапки + " has a not use mark");
		Возврат;
	КонецЕсли;

	Товары = ТоварыКоллекции(Папка.Ссылка, Производитель);

	Если Товары.Количество() = 0 Тогда
		ДобавитьОшибку(Итог, Индекс, КодПапки, "collection_empty",
			"no exportable items found for collection " + КодПапки + " and tm " + КодТМ);
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Ссылки.Добавить(Товар.Ссылка);
	КонецЦикла;
	ТекущиеЦены = ТекущиеЦеныТоваров(Ссылки, ВидыЦен);

	// Группы «одинаковый переход цены» вместо строки на товар: у коллекции цена обычно
	// единая, и на 200 SKU поштучный список раздувает ответ в десятки раз без пользы.
	// Ключ группы: вид цены + старое значение + новое. Исключения (у товара цены не было
	// или она уже равна новой) отделяются в свою группу сами.
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Обновлено = 0;
	БезИзменений = 0;

	Для Каждого Товар Из Товары Цикл
		Строка = ЗаписатьЦеныТовара(Итог, Индекс, Товар, ТекущиеЦены, Цены,
			ВидыЦен, ДеньЗаписи, Автор);
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Строка.Свойство("written") Тогда
			Обновлено = Обновлено + 1;
			Для Каждого КлючЗначение Из Строка.written Цикл
				ДобавитьВГруппу(Группы, Порядок, Товар.Код, КлючЗначение.Ключ,
					КлючЗначение.Значение, Ложь);
			КонецЦикла;
		Иначе
			БезИзменений = БезИзменений + 1;
		КонецЕсли;

		Если Строка.Свойство("skipped") Тогда
			Для Каждого КлючЗначение Из Строка.skipped Цикл
				ДобавитьВГруппу(Группы, Порядок, Товар.Код, КлючЗначение.Ключ,
					КлючЗначение.Значение, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если Порядок.Количество() = 0 Тогда
		Возврат;   // все позиции упали в errors
	КонецЕсли;

	Изменения = Новый Массив;
	Для Каждого Ключ Из Порядок Цикл
		Изменения.Добавить(Группы.Получить(Ключ));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("index", Индекс);
	Результат.Вставить("collection_ref", КодПапки);
	Результат.Вставить("collection", ИмяКоллекции(Папка.Наименование));
	Результат.Вставить("tm", КодТМ);
	Результат.Вставить("tm_name", НаименованиеТМ);
	Результат.Вставить("count", Обновлено + БезИзменений);
	Результат.Вставить("updated", Обновлено);
	Результат.Вставить("unchanged", БезИзменений);
	Результат.Вставить("changes", Изменения);

	Итог["results"].Добавить(Результат);
	Итог["updated"] = Итог["updated"] + Обновлено;
	Итог["unchanged"] = Итог["unchanged"] + БезИзменений;

КонецПроцедуры


// Копит группы «одинаковый переход цены». Деталь — структура из ЗаписатьЦеныТовара:
// для записанного {old, old_date, new}, для пропущенного {value, date, reason}.
Процедура ДобавитьВГруппу(Группы, Порядок, КодТовара, ВидЦены, Деталь, ЭтоПропуск)

	Если ЭтоПропуск Тогда
		Ключ = ВидЦены + "|skip|" + Строка(Деталь.value);
	Иначе
		Ключ = ВидЦены + "|" + ?(Деталь.old = Неопределено, "-", Строка(Деталь.old))
			+ "|" + Строка(Деталь.new);
	КонецЕсли;

	Группа = Группы.Получить(Ключ);

	Если Группа = Неопределено Тогда
		Группа = Новый Структура;
		Группа.Вставить("price_type", ВидЦены);
		Если ЭтоПропуск Тогда
			Группа.Вставить("old", Деталь.value);
			Группа.Вставить("old_date", Деталь.date);
			Группа.Вставить("new", Деталь.value);
			Группа.Вставить("skipped", Истина);
			Группа.Вставить("reason", Деталь.reason);
		Иначе
			Группа.Вставить("old", Деталь.old);          // null = цена проставлена впервые
			Группа.Вставить("old_date", Деталь.old_date);
			Группа.Вставить("new", Деталь.new);
		КонецЕсли;
		Группа.Вставить("count", 0);
		Группа.Вставить("refs", Новый Массив);
		Группы.Вставить(Ключ, Группа);
		Порядок.Добавить(Ключ);
	КонецЕсли;

	Группа["count"] = Группа["count"] + 1;
	Группа["refs"].Добавить(КодТовара);

КонецПроцедуры


// =====================================================================================
// ОБЩАЯ ФУНКЦИЯ. Такой же блок есть в specs/1c/by-tm.bsl (там её вызывает
// КоллекцияТовара) — в модуле она должна быть РОВНО ОДНА. Если by-tm уже вставлен,
// этот блок пропустите, иначе модуль не скомпилируется.
//
// Имя коллекции для сообщения админу: из «Коллекция Brilliant - 10 декоров» → «Brilliant».
// by-tm прогоняет через неё же значение допреквизита «Коллекция», поэтому коллекция
// называется одинаково в обоих ответах.
// =====================================================================================
Функция ИмяКоллекции(Наименование)

	Имя = СокрЛП(Наименование);

	Если ВРег(Лев(Имя, 10)) = "КОЛЛЕКЦИЯ " Тогда
		Имя = СокрЛП(Сред(Имя, 11));
	КонецЕсли;

	Позиция = Найти(Имя, " - ");
	Если Позиция > 1 Тогда
		Имя = СокрЛП(Лев(Имя, Позиция - 1));
	КонецЕсли;

	Возврат Имя;

КонецФункции


// ------------------------------------------------------------------- форма (б): товар

Процедура ОбработатьТовар(Итог, Индекс, КодТовара, КодТМ, НаименованиеТМ, Цены,
		ВидыЦен, ДеньЗаписи, Автор)

	Товар = РеквизитыПоКоду(КодТовара);

	Если Товар = Неопределено Тогда
		ДобавитьОшибку(Итог, Индекс, КодТовара, "product_not_found",
			"product " + КодТовара + " not found");
		Возврат;
	ИначеЕсли Товар.ЭтоГруппа Тогда
		ДобавитьОшибку(Итог, Индекс, КодТовара, "product_is_folder",
			"product " + КодТовара + " is a folder");
		Возврат;
	ИначеЕсли Товар.ПометкаУдаления Тогда
		ДобавитьОшибку(Итог, Индекс, КодТовара, "product_deleted",
			"product " + КодТовара + " has a delete mark");
		Возврат;
	ИначеЕсли Товар.НеВыгружать Тогда
		ДобавитьОшибку(Итог, Индекс, КодТовара, "product_not_exported",
			"product " + КодТовара + " has a not use mark");
		Возврат;
	ИначеЕсли ПустаяСтрока(Товар.КодТМ) Тогда
		ДобавитьОшибку(Итог, Индекс, КодТовара, "product_without_tm",
			"product " + КодТовара + " doesn't have a tm");
		Возврат;
	ИначеЕсли Товар.КодТМ <> КодТМ Тогда
		ДобавитьОшибку(Итог, Индекс, КодТовара, "product_tm_mismatch",
			"product " + КодТовара + " belongs to tm " + Товар.КодТМ + ", not " + КодТМ);
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Ссылки.Добавить(Товар.Ссылка);
	ТекущиеЦены = ТекущиеЦеныТоваров(Ссылки, ВидыЦен);

	Строка = ЗаписатьЦеныТовара(Итог, Индекс, Товар, ТекущиеЦены, Цены,
		ВидыЦен, ДеньЗаписи, Автор);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("index", Индекс);
	Результат.Вставить("ref", Товар.Код);
	Результат.Вставить("name", СокрЛП(Товар.Наименование));
	Результат.Вставить("collection", ИмяКоллекции(Товар.Коллекция));
	Результат.Вставить("collection_ref", Товар.КодРодителя);
	Результат.Вставить("tm", КодТМ);
	Результат.Вставить("tm_name", НаименованиеТМ);
	Если Строка.Свойство("written") Тогда
		Результат.Вставить("written", Строка.written);
		Итог["updated"] = Итог["updated"] + 1;
	КонецЕсли;
	Если Строка.Свойство("skipped") Тогда
		Результат.Вставить("skipped", Строка.skipped);
		Если НЕ Строка.Свойство("written") Тогда
			Итог["unchanged"] = Итог["unchanged"] + 1;
		КонецЕсли;
	КонецЕсли;

	Итог["results"].Добавить(Результат);

КонецПроцедуры


// ------------------------------------------------------------------------ запись цен

// Возвращает Структура("ref, name[, written][, skipped]") либо Неопределено, если по товару
// не записано и не пропущено ничего (все переданные цены оказались невалидными).
Функция ЗаписатьЦеныТовара(Итог, Индекс, Товар, ТекущиеЦены, Цены,
		ВидыЦен, ДеньЗаписи, Автор)

	Было = ТекущиеЦены.Получить(Товар.Ссылка);
	Если Было = Неопределено Тогда
		Было = Новый Соответствие;
	КонецЕсли;

	Записано = Новый Структура;
	Пропущено = Новый Структура;

	// Порядок фиксированный: закупка, розница, РРЦ — чтобы ответ читался предсказуемо.
	Порядок = Новый Массив;
	Порядок.Добавить("purchase");
	Порядок.Добавить("retail");
	Порядок.Добавить("rrc");

	Для Каждого Ключ Из Порядок Цикл
		ОбработатьВидЦены(Итог, Индекс, Товар, Было, Цены, Ключ, ВидыЦен.Получить(Ключ),
			Записано, Пропущено, ДеньЗаписи, Автор);
	КонецЦикла;

	Если Записано.Количество() = 0 И Пропущено.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Строка = Новый Структура;
	Строка.Вставить("ref", Товар.Код);
	Строка.Вставить("name", СокрЛП(Товар.Наименование));
	Если Записано.Количество() > 0 Тогда
		Строка.Вставить("written", Записано);
	КонецЕсли;
	Если Пропущено.Количество() > 0 Тогда
		Строка.Вставить("skipped", Пропущено);
	КонецЕсли;

	Возврат Строка;

КонецФункции


Процедура ОбработатьВидЦены(Итог, Индекс, Товар, Было, Цены, Ключ, ВидЦены,
		Записано, Пропущено, ДеньЗаписи, Автор)

	Если НЕ Цены.Свойство(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Цена = Цены[Ключ];
	Если (ТипЗнч(Цена) <> Тип("Число")) ИЛИ (Цена <= 0) Тогда
		// тип в тексте важен: "2070" строкой и 2070 числом иначе неотличимы в отчёте
		ДобавитьОшибку(Итог, Индекс, Товар.Код, "price_invalid",
			"invalid " + Ключ + " price for " + Товар.Код + ": " + Строка(Цена)
			+ " (" + Строка(ТипЗнч(Цена)) + ")");
		Возврат;
	КонецЕсли;

	СтараяЦена = Неопределено;
	СтараяДата = "";
	Прошлое = Было.Получить(ВидЦены);
	Если Прошлое <> Неопределено Тогда
		СтараяЦена = Прошлое.Цена;
		СтараяДата = Формат(Прошлое.Период, "ДФ=yyyy-MM-dd");
	КонецЕсли;

	Если СтараяЦена <> Неопределено И СтараяЦена = Цена Тогда
		Деталь = Новый Структура;
		Деталь.Вставить("value", Цена);
		Деталь.Вставить("date", СтараяДата);
		Деталь.Вставить("reason", "same");
		Пропущено.Вставить(Ключ, Деталь);
		Возврат;
	КонецЕсли;

	Попытка
		Запись = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
		Запись.Период           = ДеньЗаписи;
		Запись.Номенклатура     = Товар.Ссылка;
		Запись.ВидЦен           = ВидЦены;
		Запись.ЕдиницаИзмерения = Товар.ЕдиницаИзмерения;
		Запись.Цена             = Цена;
		Запись.Актуальность     = Истина;
		Если Автор <> Неопределено Тогда
			Запись.Автор = Автор;
		КонецЕсли;
		Запись.Записать(Истина);
	Исключение
		ДобавитьОшибку(Итог, Индекс, Товар.Код, "write_failed",
			"cannot write " + Ключ + " for " + Товар.Код + ": "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Деталь = Новый Структура;
	Деталь.Вставить("old", СтараяЦена);         // null, если цены раньше не было
	Деталь.Вставить("old_date", СтараяДата);
	Деталь.Вставить("new", Цена);
	Записано.Вставить(Ключ, Деталь);

КонецПроцедуры


// ------------------------------------------------------------------ выборки из базы

// Реквизиты элемента/группы по коду. Запросом, а не через точку от ссылки: реквизит с
// «Использование = Для группы» при обращении через точку бросает исключение.
Функция РеквизитыПоКоду(Код)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Номенклатура.Ссылка КАК Ссылка,
	                      |	Номенклатура.Код КАК Код,
	                      |	Номенклатура.Наименование КАК Наименование,
	                      |	Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	                      |	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	                      |	ЕСТЬNULL(Номенклатура.НеВыгружать, ЛОЖЬ) КАК НеВыгружать,
	                      |	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                      |	ЕСТЬNULL(Номенклатура.Производитель.Код, """") КАК КодТМ,
	                      |	ЕСТЬNULL(Номенклатура.Родитель.Код, """") КАК КодРодителя,
	                      |	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Коллекция
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	Номенклатура.Код = &Код");
	Запрос.УстановитьПараметр("Код", Код);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Реквизиты = Новый Структура(
		"Ссылка, Код, Наименование, ЭтоГруппа, ПометкаУдаления, НеВыгружать,"
		+ "ЕдиницаИзмерения, КодТМ, КодРодителя, Коллекция");
	ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
	Возврат Реквизиты;

КонецФункции


// Конечные экспортируемые товары папки, принадлежащие указанному производителю.
Функция ТоварыКоллекции(Папка, Производитель)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Номенклатура.Ссылка КАК Ссылка,
	                      |	Номенклатура.Код КАК Код,
	                      |	Номенклатура.Наименование КАК Наименование,
	                      |	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                      |	ЕСТЬNULL(Номенклатура.Родитель.Код, """") КАК КодРодителя,
	                      |	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Коллекция
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	Номенклатура.Родитель = &Родитель
	                      |	И Номенклатура.Производитель = &Производитель
	                      |	И НЕ Номенклатура.ЭтоГруппа
	                      |	И НЕ Номенклатура.ПометкаУдаления
	                      |	И ЕСТЬNULL(Номенклатура.НеВыгружать, ЛОЖЬ) = ЛОЖЬ
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Номенклатура.Код");
	Запрос.УстановитьПараметр("Родитель", Папка);
	Запрос.УстановитьПараметр("Производитель", Производитель);

	Товары = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Товар = Новый Структура("Ссылка, Код, Наименование, ЕдиницаИзмерения, КодРодителя, Коллекция");
		ЗаполнитьЗначенияСвойств(Товар, Выборка);
		Товары.Добавить(Товар);
	КонецЦикла;

	Возврат Товары;

КонецФункции


// Текущие цены ДО записи: Соответствие[Ссылка товара] = Соответствие[ВидЦен] = {Цена, Период}.
// Одна выборка на всю партию — не по запросу на товар.
Функция ТекущиеЦеныТоваров(Ссылки, ВидыЦен)

	Виды = Новый Массив;
	Для Каждого КлючЗначение Из ВидыЦен Цикл
		Виды.Добавить(КлючЗначение.Значение);
	КонецЦикла;

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Цены.Номенклатура КАК Номенклатура,
	                      |	Цены.ВидЦен КАК ВидЦен,
	                      |	Цены.Цена КАК Цена,
	                      |	Цены.Период КАК Период
	                      |ИЗ
	                      |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	                      |		,
	                      |		Номенклатура В (&Товары)
	                      |			И ВидЦен В (&Виды)) КАК Цены");
	Запрос.УстановитьПараметр("Товары", Ссылки);
	Запрос.УстановитьПараметр("Виды", Виды);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоВидам = Результат.Получить(Выборка.Номенклатура);
		Если ПоВидам = Неопределено Тогда
			ПоВидам = Новый Соответствие;
			Результат.Вставить(Выборка.Номенклатура, ПоВидам);
		КонецЕсли;
		ПоВидам.Вставить(Выборка.ВидЦен, Новый Структура("Цена, Период", Выборка.Цена, Выборка.Период));
	КонецЦикла;

	Возврат Результат;

КонецФункции


// =====================================================================================
// ПРОВЕРИТЬ В КОНФИГУРАЦИИ (не видно со стороны спеки):
//
//  * Имя реквизита единицы измерения у Номенклатуры (здесь: ЕдиницаИзмерения).
//  * Имя регистра и его измерений: РегистрСведений.ЦеныНоменклатуры (Номенклатура, ВидЦен),
//    ресурс Цена, реквизиты Период/Актуальность/ЕдиницаИзмерения/Автор.
//    Если Актуальность — ИЗМЕРЕНИЕ, а не реквизит, она входит в ключ записи, и перезапись
//    за тот же день сработает только при совпадении значения.
//  * Реквизит НеВыгружать: если флаг каскадный по иерархии (наследуется от родителя),
//    подставить в оба запроса ту же функцию/признак, что используется в selling-tm, —
//    сейчас проверяется только собственный флаг элемента и его прямой папки.
//  * Метод МодульHTTPСервисов.ЗаписьJSONВСтруктуру должен принимать произвольную
//    структуру с вложенными массивами и структурами.
// =====================================================================================
