// =====================================================================================
// Экранирование значений для XML-выгрузки на сайт (specs/content-manager.md §19.5)
//
// ЗАЧЕМ. Выгрузка собирается `ЗаписьТекста` и пишется построчно, то есть платформа ничего
// не экранирует — строка уходит в файл как есть. `УдалитьНедопустимыеСимволыXML` снимает
// только символы, НЕДОПУСТИМЫЕ в XML (управляющие коды). Символы РАЗМЕТКИ — `&`, `<`, `>`,
// `"`, `'` — она не трогает, и документ рвётся именно на них.
//
// На боевой базе 05.09.2026: 26 497 позиций, из них 502 содержат символы разметки
// (`Onyx&More`, `White&Co`, `L'Antic Colonial`, `Elemento Ad "L" Old Chicago`), управляющих
// символов — ноль. Переименовывать эти 502 нельзя: имена настоящие. Чинится выгрузка.
//
// -------------------------------------------------------------------------------------
// ГЛАВНОЕ: ЭКРАНИРОВАТЬ НАДО ЗНАЧЕНИЕ, А НЕ СТРОКУ С ТЕГАМИ
//
// Правильно:   Строка = "<name>" + ЗначениеДляXML(Товар.Наименование) + "</name>";
// Неправильно: ЗаписатьСтроку(ЗначениеДляXML("<name>" + Товар.Наименование + "</name>"));
//
// Во втором случае экранируются и сами теги: `<name>` станет `&lt;name&gt;`, и разметки в
// файле не останется вовсе.
//
// Поэтому вопрос «куда вставить экранирование внутрь УдалитьНедопустимыеСимволыXML»
// решается только после ответа на другой: ЧТО в неё приходит.
//
//   * приходит ГОЛОЕ ЗНАЧЕНИЕ  -> можно объединить, см. ЗначениеДляXML ниже;
//   * приходит СОБРАННАЯ СТРОКА -> объединять НЕЛЬЗЯ, экранирование переносится
//     в места, где значения вставляются в строку.
//
// БЕЗОПАСНЫЙ ПОРЯДОК ДЕЙСТВИЙ. Не дописывать экранирование в существующую функцию, а
// завести ЗначениеДляXML и переименовать вызовы по одному. Тогда компилятор покажет все
// места вызова, и по каждому будет видно, значение там или строка. Молча объединить —
// значит поставить на то, что все вызовы одинаковы; на боевой выгрузке это ставка вслепую.
//
// ЭКРАНИРОВАТЬ РОВНО ОДИН РАЗ. Второе применение к уже экранированному значению даст
// `&amp;amp;`. Отсюда правило: функция вызывается в момент вставки значения в строку и
// больше нигде.
// =====================================================================================

// Значение, готовое для вставки в XML: сначала снимаем недопустимые символы, потом
// экранируем разметку.
Функция ЗначениеДляXML(Значение)

	Стр = Строка(Значение);

	// Версия указана ОБОИМ вызовам и та же, что в объявлении документа
	// (<?xml version="1.0"?>). В исходной функции "1.1" стояла только в первом вызове,
	// а XML 1.1 допускает часть управляющих символов, которых не допускает 1.0: на строке,
	// где такой символ единственный, первая проверка возвращала 0, цикл не выполнялся ни
	// разу и символ оставался — в документе 1.0 он невалиден.
	Позиция = НайтиНедопустимыеСимволыXML(Стр, , "1.0");

	Пока Позиция <> 0 Цикл
		Стр = Лев(Стр, Позиция - 1) + Сред(Стр, Позиция + 1);
		Позиция = НайтиНедопустимыеСимволыXML(Стр, , "1.0");
	КонецЦикла;

	// «&» ТОЛЬКО ПЕРВОЙ: иначе она испортит уже поставленные `&lt;`, превратив их
	// в `&amp;lt;`.
	Стр = СтрЗаменить(Стр, "&", "&amp;");
	Стр = СтрЗаменить(Стр, "<", "&lt;");
	Стр = СтрЗаменить(Стр, ">", "&gt;");
	Стр = СтрЗаменить(Стр, """", "&quot;");
	Стр = СтрЗаменить(Стр, "'", "&apos;");

	Возврат Стр;

КонецФункции


// Прежняя функция остаётся для строк, которые уже собраны С ТЕГАМИ: там экранировать
// нельзя, а снять недопустимые символы нужно. Версия XML исправлена на «1.0» в обоих
// вызовах — по той же причине, что выше.
Функция УдалитьНедопустимыеСимволыXML(Стр)

	Позиция = НайтиНедопустимыеСимволыXML(Стр, , "1.0");

	Пока Позиция <> 0 Цикл
		Стр = Лев(Стр, Позиция - 1) + Сред(Стр, Позиция + 1);
		Позиция = НайтиНедопустимыеСимволыXML(Стр, , "1.0");
	КонецЦикла;

	Возврат Стр;

КонецФункции
