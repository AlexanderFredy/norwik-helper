// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик GET get-products/properties-by-type
//
// Кодировка файла: UTF-8. Контракт ответа — specs/content-manager.md §19.2.1 и §19.2.2.
//
// ЭТО ПРАВКА СУЩЕСТВУЮЩЕЙ ФУНКЦИИ `ПолучитьСвойстваТоварнойКатегории`, а не новый
// обработчик. Имя маршрута, имя функции и имя параметра (`type-code`) сохранены: второй
// эндпоинт под ту же задачу был бы ровно той избыточностью, которую мы выпалывали, когда
// сводили пять запросов ТЗ к трём чтениям и одной записи (§19.2).
//
// ЧТО ИСПРАВЛЕНО И ПОЧЕМУ
//
// 1. ОШИБКИ ВОЗВРАЩАЛИСЬ МАССИВОМ, а удачный ответ — структурой. Сериализация рассчитана на
//    структуру, поэтому любая ошибка параметра превращалась в HTTP 500 с HTML-страницей IIS
//    вместо текста «there is not product type code». Проверено на бою: с любым НЕВЕРНЫМ
//    именем параметра — 500, и отличить «не угадал имя» от «сервис упал» невозможно.
//    Теперь ошибка идёт в том же конверте, что удачный ответ, с машинным кодом — как в
//    set-prices (§10.3), folders (§19.2.4) и by-tm.
//
// 2. `НайтиПоКоду` ОТДАЁТ ПУСТУЮ ССЫЛКУ, А НЕ `Неопределено`. Проверка `Если Категория =
//    Неопределено` не срабатывала никогда: с несуществующим кодом функция шла дальше,
//    запрос ничего не находил, и агент получал пустой список свойств вместо ошибки — то
//    есть «у этого вида товара свойств нет» вместо «такого вида товара нет». Та же ловушка
//    уже ловила нас в by-tm.bsl.
//
// 3. ЛЕВОЕ СОЕДИНЕНИЕ ПРЕВРАЩАЛОСЬ ВО ВНУТРЕННЕЕ. Условие
//    `ЗначенияСвойствОбъектов.ПометкаУдаления = ЛОЖЬ` стояло в ГДЕ, а для свойства без
//    значений там NULL, и `NULL = ЛОЖЬ` — не истина. Из ответа молча пропадали все
//    свойства, у которых нет справочника значений: строковые, числовые, булевы. Агент их
//    не видел и заполнить не мог.
//
// ЧТО ДОБАВЛЕНО
//
// 4. КОДЫ СВОЙСТВ И ЗНАЧЕНИЙ (§19.2.2). Раньше отдавались только наименования. Записывать
//    по именам нельзя: в справочнике соседствуют «Гикори» и «Хикори», есть «Клён» и
//    «Ёлочка» с «ё» — совпадение слишком легко испортить регистром, пробелом или заменой
//    «ё», а переименование значения в 1С молча разорвало бы сопоставление. `set-items`
//    принимает коды.
//
// 5. ФИЛЬТРЫ `property` И `tm`. Нужны для «Коллекции»: у неё тысячи значений, и без отбора
//    ответ по ней перевесил бы всё остальное на порядок. Обычный путь к коллекциям другой —
//    `collection_code` из by-tm (§19.2.1); здесь она страховка от дубля и запрашивается явно.
//
// ПАРАМЕТРЫ:
//   type-code=<код вида товара>   обязателен (имя сохранено)
//   property=<код свойства>       необязателен: только это свойство, включая «Коллекцию»
//   tm=<код Производителя>        необязателен: сузить значения до папки марки
//
// «Коллекция» по-прежнему исключена из общего ответа — это поведение было и осталось.
// Отдаётся только при явном `property=<её код>`.
//
// ОТБОР ПО МАРКЕ — ПО ИМЕНИ ПАПКИ, И ОТВЕТ ОБ ЭТОМ ГОВОРИТ. Ссылки на Производителя у
// справочника значений нет, сопоставлять приходится по имени, а имена марок бывают
// двуязычными («Atlas Concorde / Атлас конкорд»). Поэтому сравниваются обе части, а в
// ответе приходит `matched_folder` — какую папку 1С сопоставила. Без этого поля риск был бы
// молчаливым; с ним агент сверит имя сам и предупредит админа при расхождении.
//
// ПРО СПРАВОЧНИК ЗНАЧЕНИЙ. Основной — `ЗначенияСвойствОбъектов`, он уже использовался здесь.
// Но «Коллекция» иерархическая (вид товара → ТМ → коллекции), а в типовой БСП под иерархию
// заведён отдельный `ЗначенияСвойствОбъектовИерархия`. Наличие второго проверяется ЧЕРЕЗ
// МЕТАДАННЫЕ в момент выполнения, а текст запроса собирается строкой — модуль компилируется
// независимо от того, есть он в конфигурации или нет.
//
// ПАРАМЕТРЫ ЧИТАЮТСЯ ЧЕРЕЗ `.Получить(...)`, А НЕ ЧЕРЕЗ `[...]`. Обращение по индексу к
// ОТСУТСТВУЮЩЕМУ ключу бросает «Поле объекта не обнаружено», и обработчик падает на любом
// необязательном параметре, который не передали. Найдено на бою 08.09.2026: ответ пришёл с
// `handler_failed` и текстом `Object field not found (type-code)`. Тем же болела точка входа
// by-tm — её исправление тоже читало `["page"]` и упало бы ровно так же, просто мы этого
// ещё не проверяли.
//
// `ОтветJSON` берётся из set-prices.bsl. Прочие функции этого файла уникальны.
// =====================================================================================

// Точка входа. Любое исключение внутри превращается в JSON с текстом ошибки: GET-обработчик
// в отличие от POST не обёрнут в Попытка, поэтому исключение уходит в платформу и клиент
// получает HTTP 500 с HTML-страницей IIS — по ней причину не узнать. Это уже стоило нам
// одного круга выкладки.
Функция ПолучитьСвойстваТоварнойКатегории(ПараметрыЗапроса)

	Попытка
		Возврат СвойстваКатегории(ПараметрыЗапроса);
	Исключение
		Возврат ОтветСОшибкойСвойств("", "", "handler_failed",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции


Функция СвойстваКатегории(ПараметрыЗапроса)

	КодКатегории = ПараметрыЗапроса.Получить("type-code");

	Если КодКатегории = Неопределено Тогда
		Возврат ОтветСОшибкойСвойств("", "", "product_type_missing",
			"Не передан параметр type-code");
	КонецЕсли;

	Категория = Справочники.ёТипыНоменклатуры.НайтиПоКоду(КодКатегории);

	// ВАЖНО: НайтиПоКоду отдаёт ПУСТУЮ ССЫЛКУ, а не Неопределено (см. п.2 в шапке).
	Если НЕ ЗначениеЗаполнено(Категория) Тогда
		Возврат ОтветСОшибкойСвойств("", КодКатегории, "product_type_not_found",
			"Не найден вид товара с кодом """ + КодКатегории + """");
	КонецЕсли;

	СвойствоКоллекция = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Коллекция", Истина);

	// --- необязательный отбор по одному свойству
	ОтборСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка();
	КодСвойства = ПараметрыЗапроса.Получить("property");

	Если КодСвойства <> Неопределено Тогда
		ОтборСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(КодСвойства);
		Если НЕ ЗначениеЗаполнено(ОтборСвойство) Тогда
			Возврат ОтветСОшибкойСвойств(Категория.Наименование, КодКатегории,
				"property_not_found", "Не найдено свойство с кодом """ + КодСвойства + """");
		КонецЕсли;
	КонецЕсли;

	// --- необязательный отбор по марке
	Производитель = Справочники.Производители.ПустаяСсылка();
	КодМарки = ПараметрыЗапроса.Получить("tm");

	Если КодМарки <> Неопределено Тогда
		Производитель = Справочники.Производители.НайтиПоКоду(КодМарки);
		Если НЕ ЗначениеЗаполнено(Производитель) Тогда
			Возврат ОтветСОшибкойСвойств(Категория.Наименование, КодКатегории,
				"tm_not_found", "Не найдена торговая марка с кодом """ + КодМарки + """");
		КонецЕсли;
	КонецЕсли;

	// --- свойства вида товара
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипНоменклатуры", Категория);
	Запрос.УстановитьПараметр("Коллекция", СвойствоКоллекция);
	Запрос.УстановитьПараметр("ОтборСвойство", ОтборСвойство);
	Запрос.УстановитьПараметр("ЕстьОтборСвойства", ЗначениеЗаполнено(ОтборСвойство));

	// Значения НЕ присоединяем: из-за левого соединения с условием в ГДЕ пропадали
	// свойства без справочника значений (см. п.3 в шапке). Значения берутся отдельно, на
	// свойство — запрос; вызывается это раз на вид товара за прогон прайса (§19.2.1).
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СвойстваВида.Свойство КАК Свойство,
		|	СвойстваВида.Свойство.Наименование КАК Имя
		|ИЗ
		|	Справочник.ёТипыНоменклатуры.Свойства КАК СвойстваВида
		|ГДЕ
		|	СвойстваВида.Ссылка = &ТипНоменклатуры
		|	И СвойстваВида.Свойство <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка)
		|	И (НЕ &ЕстьОтборСвойства ИЛИ СвойстваВида.Свойство = &ОтборСвойство)
		|	И (&ЕстьОтборСвойства ИЛИ СвойстваВида.Свойство <> &Коллекция)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Имя";

	Выборка = Запрос.Выполнить().Выбрать();

	МассивДанных = Новый Массив;
	Ошибки = Новый Массив;

	// НЕ Неопределено: запись JSON на нём спотыкается, и ответ превращается в HTTP 500 с
	// HTML-страницей IIS. Ровно так же роняло by-tm, когда в offset попадало Неопределено.
	// Пустые строки внутри означают «сопоставления не было» — форма поля при этом одна и
	// та же всегда, и клиенту не нужно различать два типа.
	СопоставленнаяПапка = Новый Структура("code,name", "", "");

	Пока Выборка.Следующий() Цикл

		// Сбой на ОДНОМ свойстве не должен отменять весь ответ — как в by-tm и folders.
		Попытка
			Запись = Новый Структура;
			Запись.Вставить("property", СокрЛП(Строка(Выборка.Свойство.Наименование)));
			Запись.Вставить("code", КодЭлемента(Выборка.Свойство));
			Запись.Вставить("values", ЗначенияСвойства(Выборка.Свойство, Производитель, Категория,
				СопоставленнаяПапка));
			МассивДанных.Добавить(Запись);
		Исключение
			Ошибки.Добавить(Новый Структура("ref,code,message", КодЭлемента(Выборка.Свойство),
				"property_failed", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("product_type", СокрЛП(Строка(Категория.Наименование)));
	Результат.Вставить("product_type_ref", СокрЛП(Строка(Категория.Код)));
	Результат.Вставить("matched_folder", СопоставленнаяПапка);
	Результат.Вставить("total", МассивДанных.Количество());
	Результат.Вставить("properties", МассивДанных);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции


// Значения свойства с кодами. Свойство без справочника значений (строка, число, булево)
// отдаёт пустой список — это норма, а не ошибка: раньше такие свойства просто исчезали.
//
// СопоставленнаяПапка — ВЫХОДНОЙ параметр: если задана марка и папка по имени нашлась,
// сюда кладётся {code, name}, и агент увидит, с чем именно 1С сопоставила марку.
Функция ЗначенияСвойства(Свойство, Производитель, Категория, СопоставленнаяПапка)

	Значения = Новый Массив;

	Для Каждого ИмяСправочника Из СправочникиЗначений() Цикл

		ОтборПапки = Справочники[ИмяСправочника].ПустаяСсылка();
		Иерархический = Метаданные.Справочники[ИмяСправочника].Иерархический;

		Если ЗначениеЗаполнено(Производитель) И Иерархический Тогда
			ОтборПапки = ПапкаМаркиВЗначениях(ИмяСправочника, Свойство, Производитель, Категория);
			Если ЗначениеЗаполнено(ОтборПапки) Тогда
				СопоставленнаяПапка.code = КодЭлемента(ОтборПапки);
				СопоставленнаяПапка.name = СокрЛП(Строка(ОтборПапки.Наименование));
			КонецЕсли;
		КонецЕсли;

		// `ЭтоГруппа` и `В ИЕРАРХИИ` есть только у иерархического справочника, поэтому
		// условия подставляются в текст, а не пишутся всегда.
		УсловиеГруппы = ?(Иерархический, " И Значения.ЭтоГруппа = ЛОЖЬ", "");
		УсловиеПапки = ?(Иерархический,
			" И (НЕ &ЕстьОтборПапки ИЛИ Значения.Ссылка В ИЕРАРХИИ (&Папка))", "");

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Свойство", Свойство);

		Если Иерархический Тогда
			Запрос.УстановитьПараметр("Папка", ОтборПапки);
			Запрос.УстановитьПараметр("ЕстьОтборПапки", ЗначениеЗаполнено(ОтборПапки));
		КонецЕсли;

		Запрос.Текст =
			"ВЫБРАТЬ
			|	Значения.Ссылка КАК Ссылка,
			|	Значения.Наименование КАК Наименование
			|ИЗ
			|	Справочник." + ИмяСправочника + " КАК Значения
			|ГДЕ
			|	Значения.Владелец = &Свойство
			|	И НЕ Значения.ПометкаУдаления" + УсловиеГруппы + УсловиеПапки + "
			|
			|УПОРЯДОЧИТЬ ПО
			|	Наименование";

		ВыборкаЗначений = Запрос.Выполнить().Выбрать();

		Пока ВыборкаЗначений.Следующий() Цикл
			Значения.Добавить(Новый Структура("value,code",
				СокрЛП(Строка(ВыборкаЗначений.Наименование)),
				КодЭлемента(ВыборкаЗначений.Ссылка)));
		КонецЦикла;

	КонецЦикла;

	Возврат Значения;

КонецФункции


// =====================================================================================
// Папка марки внутри иерархии значений свойства.
//
// ДВЕ ОШИБКИ ПЕРВОЙ РЕДАКЦИИ, ОБЕ НАЙДЕНЫ НА БОЮ 08.09.2026 — и обе привели к тому, что
// значение коллекции было создано в чужой ветке:
//
// 1. ПОИСК ШЁЛ ПО ВСЕМ ГРУППАМ СВОЙСТВА, без учёта вида товара. Иерархия здесь
//    «вид товара → ТМ → коллекции», и папка «Atlas Concorde» нашлась в ветке КЕРАМОГРАНИТА,
//    хотя запрашивалась керамическая плитка. Теперь марка ищется ВНУТРИ ветки вида товара.
//
// 2. СРАВНЕНИЕ ПО ВХОЖДЕНИЮ БРАЛО БОЛЕЕ ОБЩЕЕ ИМЯ. «Atlas Concorde» входит в
//    «Atlas Concorde Rus», поэтому для марки «Atlas Concorde Rus/ Атлас конкорд рус»
//    возвращалась папка «Atlas Concorde» — а рядом лежит правильная «Atlas Concorde rus».
//    Это разные ТМ. Теперь сначала ТОЧНОЕ совпадение, вхождение — только если кандидат
//    ровно один. Несколько кандидатов — не выбираем ничего: молча взять одну из двух марок
//    хуже, чем не взять никакой.
// =====================================================================================
Функция ПапкаМаркиВЗначениях(ИмяСправочника, Свойство, Производитель, ТипТовара)

	Пустая = Справочники[ИмяСправочника].ПустаяСсылка();

	ВеткаВида = ПапкаВидаВЗначениях(ИмяСправочника, Свойство, ТипТовара);
	Если НЕ ЗначениеЗаполнено(ВеткаВида) Тогда
		Возврат Пустая;                    // ветки вида товара нет — искать марку негде
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Ветка", ВеткаВида);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Папки.Ссылка КАК Ссылка,
		|	Папки.Наименование КАК Наименование
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Папки
		|ГДЕ
		|	Папки.Владелец = &Свойство
		|	И Папки.ЭтоГруппа = ИСТИНА
		|	И НЕ Папки.ПометкаУдаления
		|	И Папки.Ссылка В ИЕРАРХИИ (&Ветка)
		|	И Папки.Ссылка <> &Ветка";

	Возврат ВыбратьПоИмени(Запрос, Производитель.Наименование, Пустая);

КонецФункции


// Ветка вида товара в дереве значений: верхний уровень иерархии «вид товара → ТМ → …».
Функция ПапкаВидаВЗначениях(ИмяСправочника, Свойство, ТипТовара)

	Пустая = Справочники[ИмяСправочника].ПустаяСсылка();

	Если НЕ ЗначениеЗаполнено(ТипТовара) Тогда
		Возврат Пустая;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Папки.Ссылка КАК Ссылка,
		|	Папки.Наименование КАК Наименование
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Папки
		|ГДЕ
		|	Папки.Владелец = &Свойство
		|	И Папки.ЭтоГруппа = ИСТИНА
		|	И НЕ Папки.ПометкаУдаления";

	Возврат ВыбратьПоИмени(Запрос, ТипТовара.Наименование, Пустая);

КонецФункции


// Выбор папки по имени: СНАЧАЛА точное совпадение, и только если точного нет — вхождение,
// и только когда кандидат ровно один. Неоднозначность — отказ, а не выбор наугад.
Функция ВыбратьПоИмени(Запрос, Эталон, Пустая)

	Выборка = Запрос.Выполнить().Выбрать();
	Части = ЧастиИмени(Эталон);

	Точная = Пустая;
	Приблизительные = Новый Массив;

	Пока Выборка.Следующий() Цикл

		ЧастиПапки = ЧастиИмени(Выборка.Наименование);

		Если ИменаСовпадаютТочно(Части, ЧастиПапки) Тогда
			Точная = Выборка.Ссылка;
			Прервать;
		КонецЕсли;

		Если ИменаСовпадают(Части, ЧастиПапки) Тогда
			Приблизительные.Добавить(Выборка.Ссылка);
		КонецЕсли;

	КонецЦикла;

	Если ЗначениеЗаполнено(Точная) Тогда
		Возврат Точная;
	КонецЕсли;

	Если Приблизительные.Количество() = 1 Тогда
		Возврат Приблизительные[0];
	КонецЕсли;

	Возврат Пустая;

КонецФункции


// Точное совпадение хотя бы одной пары частей: «Atlas Concorde Rus/ Атлас конкорд рус» и
// «Atlas Concorde rus» совпадут, а «Atlas Concorde» — нет.
Функция ИменаСовпадаютТочно(ЧастиОдного, ЧастиДругого)

	Для Каждого Одна Из ЧастиОдного Цикл
		Для Каждого Другая Из ЧастиДругого Цикл
			Если Одна = Другая Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции


// Справочники значений свойств, которые есть в конфигурации. Ищем через метаданные, а
// текст запроса собираем строкой — тогда модуль компилируется независимо от того, заведён
// ли иерархический вариант. Значения свойства лежат ровно в одном из них, поэтому обойти
// оба и склеить безопасно.
Функция СправочникиЗначений()

	Имена = Новый Массив;

	Если Метаданные.Справочники.Найти("ЗначенияСвойствОбъектов") <> Неопределено Тогда
		Имена.Добавить("ЗначенияСвойствОбъектов");
	КонецЕсли;

	Если Метаданные.Справочники.Найти("ЗначенияСвойствОбъектовИерархия") <> Неопределено Тогда
		Имена.Добавить("ЗначенияСвойствОбъектовИерархия");
	КонецЕсли;

	Возврат Имена;

КонецФункции


// Двуязычное имя → массив нормализованных частей: «Atlas Concorde / Атлас конкорд» →
// ["atlas concorde", "атлас конкорд"].
Функция ЧастиИмени(Наименование)

	Части = Новый Массив;

	Для Каждого Кусок Из РазделитьСтроку(Наименование, "/") Цикл
		Нормализованный = НРег(СокрЛП(СтрЗаменить(Кусок, "ё", "е")));
		Пока Найти(Нормализованный, "  ") > 0 Цикл
			Нормализованный = СтрЗаменить(Нормализованный, "  ", " ");
		КонецЦикла;
		Если Нормализованный <> "" Тогда
			Части.Добавить(Нормализованный);
		КонецЕсли;
	КонецЦикла;

	Возврат Части;

КонецФункции


// Разбиение строки по разделителю. Написано вручную, а не через `СтрРазделить`: та
// появилась в платформе 8.3.6, а конфигурация работает на более ранней. Использованы только
// `Найти`, `Лев`, `Сред` и `СтрДлина` — они есть во всех версиях.
//
// Пустые части пропускаются: «Atlas Concorde / » не должен давать пустой кусок, по которому
// потом совпадёт что угодно.
Функция РазделитьСтроку(Знач Стр, Разделитель)

	Части = Новый Массив;
	Остаток = Строка(Стр);

	// Пустой разделитель зациклил бы поиск: возвращаем строку целиком.
	Если Разделитель = "" Тогда
		Если СокрЛП(Остаток) <> "" Тогда
			Части.Добавить(Остаток);
		КонецЕсли;
		Возврат Части;
	КонецЕсли;

	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Остаток, Разделитель);

	Пока Позиция > 0 Цикл

		Кусок = Лев(Остаток, Позиция - 1);
		Если СокрЛП(Кусок) <> "" Тогда
			Части.Добавить(Кусок);
		КонецЕсли;

		Остаток = Сред(Остаток, Позиция + ДлинаРазделителя);
		Позиция = Найти(Остаток, Разделитель);

	КонецЦикла;

	Если СокрЛП(Остаток) <> "" Тогда
		Части.Добавить(Остаток);
	КонецЕсли;

	Возврат Части;

КонецФункции

// Совпадением считается равенство или вхождение любой части в любую: имена марок пишут то
// полностью, то сокращённо, и требовать точного равенства значило бы не находить ничего.
Функция ИменаСовпадают(ЧастиОдного, ЧастиДругого)

	Для Каждого Одна Из ЧастиОдного Цикл
		Для Каждого Другая Из ЧастиДругого Цикл
			Если Одна = Другая ИЛИ Найти(Одна, Другая) > 0 ИЛИ Найти(Другая, Одна) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции


// Код ссылки. У примитивных значений кода нет — пустая строка, и это норма, а не сбой.
Функция КодЭлемента(Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Строка(Ссылка.Код));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции


// Ответ с ошибкой — В ТОМ ЖЕ КОНВЕРТЕ, что удачный. Именно поэтому здесь структура, а не
// массив: сериализация не спотыкается на неожиданном типе, и вместо HTTP 500 с
// HTML-страницей IIS клиент получает читаемую причину (см. п.1 в шапке).
Функция ОтветСОшибкойСвойств(ИмяВида, КодВида, КодОшибки, Текст)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("ref,code,message", "", КодОшибки, Текст));

	Результат = Новый Структура;
	Результат.Вставить("product_type", ИмяВида);
	Результат.Вставить("product_type_ref", КодВида);
	Результат.Вставить("matched_folder", Новый Структура("code,name", "", ""));
	Результат.Вставить("total", 0);
	Результат.Вставить("properties", Новый Массив);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции
