// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик GET get-products/properties
//
// Кодировка файла: UTF-8. Контракт ответа — specs/content-manager.md §19.2.1 и §19.2.2.
//
// ЗАЧЕМ. Чтобы завести товар, агент должен знать, какие дополнительные свойства бывают у
// вида товара и какие значения у них допустимы — иначе он либо выдумает значение, либо
// заведёт дубль уже существующего. Адресуются свойства и значения КОДАМИ (§19.2.2): имя
// ненадёжный ключ, в справочнике соседствуют «Гикори» и «Хикори», а переименование значения
// молча разорвало бы сопоставление.
//
// КАК ПОДКЛЮЧИТЬ. Файл кладётся в ТОТ ЖЕ модуль, что by-tm.bsl, folders.bsl и
// set-prices.bsl. В существующем GET-обработчике добавьте ветку:
//
//     ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "properties" Тогда
//         Возврат ОтветJSON(200, ПолучитьСвойстваВидаТовара(Запрос.ПараметрыЗапроса));
//
// `ОтветJSON` уже есть в set-prices.bsl — второй раз вставлять не нужно. Остальные функции
// этого файла уникальны, но ЗАПАСНОЙ путь `ЗначенияИзТоваров` вызывает `ПредставлениеЗначения`
// из by-tm.bsl: файлы живут в одном модуле, и by-tm там уже есть. Если вставлять properties
// отдельно, эту функцию нужно взять с собой.
//
// ПАРАМЕТРЫ:
//   product_type=<код вида товара>   обязателен
//   property=<код свойства>          необязателен: вернуть только это свойство
//   tm=<код Производителя>           необязателен: сузить значения до марки
//
// -------------------------------------------------------------------------------------
// «КОЛЛЕКЦИЯ» ПО УМОЛЧАНИЮ НЕ ОТДАЁТСЯ. У неё тысячи значений — все коллекции базы, — и в
// общем ответе она перевесила бы всё остальное на порядок. Обычный путь к коллекциям другой:
// `by-tm` отдаёт `collection` и `collection_code` у каждого товара, то есть набор коллекций
// марки виден из её же товаров, без обращения к этому справочнику (§19.2.1). Здесь она
// нужна лишь как страховка от дубля — когда значение в справочнике есть, но ни одним
// товаром марки не используется, — и запрашивается явно:
//
//     properties?product_type=000000002&property=<код Коллекции>&tm=000000302
//
// -------------------------------------------------------------------------------------
// ДВА МЕСТА, ГДЕ Я НЕ ЗНАЮ ВАШЕЙ КОНФИГУРАЦИИ, И ЧТО С ЭТИМ СДЕЛАНО
//
// 1. КАКИЕ СВОЙСТВА У ВИДА ТОВАРА. Ссылочной связи «вид товара → набор свойств» я в базе не
//    видел, поэтому набор выводится ИЗ ТОВАРОВ: какие допреквизиты реально заполнены у
//    номенклатуры этого вида. Способ проверенный — так же в folders.bsl определяется вид
//    товара папки. Он честен (показывает то, что есть) и не зависит от метаданных, но не
//    покажет свойство, не заполненное НИ У ОДНОГО товара вида. Если у `ёТипыНоменклатуры`
//    есть реквизит с набором свойств — замените `СвойстваВидаТовара`, остальное не изменится.
//
// 2. КАК НАЗЫВАЕТСЯ СПРАВОЧНИК ЗНАЧЕНИЙ. В типовой БСП это `ЗначенияСвойствОбъектов` и
//    `ЗначенияСвойствОбъектовИерархия`. Имя ищется ЧЕРЕЗ МЕТАДАННЫЕ в момент выполнения, а
//    текст запроса собирается строкой — поэтому модуль компилируется независимо от того,
//    есть эти справочники в конфигурации или нет. Если нет ни одного, значения берутся из
//    товаров: тогда список беднее (только используемые значения), но ответ не ломается.
//
// ОТБОР ПО МАРКЕ — ПО ИМЕНИ ПАПКИ, И ОТВЕТ ОБ ЭТОМ ГОВОРИТ. Справочник значений
// «Коллекция» иерархический (вид товара → ТМ → коллекции), но ссылки на Производителя у
// него нет — сопоставлять приходится по имени. Имена марок бывают двуязычными
// («Atlas Concorde / Атлас конкорд»), поэтому сравниваются обе части, а в ответе приходит
// `matched_folder` — какую папку 1С сопоставила. Без этого поля риск был бы молчаливым: с
// ним агент сверит имя сам и предупредит админа при расхождении (§19.2.1).
// =====================================================================================

Функция ПолучитьСвойстваВидаТовара(ПараметрыЗапроса)

	КодВидаТовара = ПараметрыЗапроса["product_type"];

	Если КодВидаТовара = Неопределено Тогда
		Возврат ОтветСОшибкойСвойств("", "", "product_type_missing",
			"Не передан параметр product_type");
	КонецЕсли;

	ТипТовара = Справочники.ёТипыНоменклатуры.НайтиПоКоду(КодВидаТовара);

	// НайтиПоКоду отдаёт ПУСТУЮ ССЫЛКУ, а не Неопределено
	Если НЕ ЗначениеЗаполнено(ТипТовара) Тогда
		Возврат ОтветСОшибкойСвойств("", КодВидаТовара, "product_type_not_found",
			"Не найден вид товара с кодом " + КодВидаТовара);
	КонецЕсли;

	// --- необязательный отбор по одному свойству
	ОтборСвойство = Неопределено;
	КодСвойства = ПараметрыЗапроса["property"];

	Если КодСвойства <> Неопределено Тогда
		ОтборСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоКоду(КодСвойства);
		Если НЕ ЗначениеЗаполнено(ОтборСвойство) Тогда
			Возврат ОтветСОшибкойСвойств(ТипТовара.Наименование, КодВидаТовара,
				"property_not_found", "Не найдено свойство с кодом " + КодСвойства);
		КонецЕсли;
	КонецЕсли;

	// --- необязательный отбор по марке
	Производитель = Справочники.Производители.ПустаяСсылка();
	КодМарки = ПараметрыЗапроса["tm"];

	Если КодМарки <> Неопределено Тогда
		Производитель = Справочники.Производители.НайтиПоКоду(КодМарки);
		Если НЕ ЗначениеЗаполнено(Производитель) Тогда
			Возврат ОтветСОшибкойСвойств(ТипТовара.Наименование, КодВидаТовара,
				"tm_not_found", "Не найдена торговая марка с кодом " + КодМарки);
		КонецЕсли;
	КонецЕсли;

	СвойствоКоллекция = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Коллекция", Истина);

	МассивСвойств = Новый Массив;
	Ошибки = Новый Массив;
	СопоставленнаяПапка = Неопределено;

	Для Каждого Свойство Из СвойстваВидаТовара(ТипТовара) Цикл

		Если ЗначениеЗаполнено(ОтборСвойство) И Свойство <> ОтборСвойство Тогда
			Продолжить;
		КонецЕсли;

		// «Коллекция» в общий ответ не идёт — только по явному запросу (см. шапку файла).
		// Если свойства «Коллекция» в конфигурации нет, СвойствоКоллекция окажется пустым,
		// и сравнение просто никогда не сработает — отдельной проверки это не требует.
		Если НЕ ЗначениеЗаполнено(ОтборСвойство) И Свойство = СвойствоКоллекция Тогда
			Продолжить;
		КонецЕсли;

		// Сбой на ОДНОМ свойстве не должен отменять весь ответ — как в by-tm и folders.
		Попытка
			Запись = Новый Структура;
			Запись.Вставить("property", СокрЛП(Строка(Свойство.Наименование)));
			Запись.Вставить("code", КодЭлемента(Свойство));

			Значения = ЗначенияСвойства(Свойство, Производитель, СопоставленнаяПапка);
			Запись.Вставить("values", Значения);

			МассивСвойств.Добавить(Запись);
		Исключение
			Ошибки.Добавить(Новый Структура("ref,code,message", КодЭлемента(Свойство),
				"property_failed", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("product_type", СокрЛП(Строка(ТипТовара.Наименование)));
	Результат.Вставить("product_type_ref", СокрЛП(Строка(ТипТовара.Код)));
	Результат.Вставить("matched_folder", СопоставленнаяПапка);
	Результат.Вставить("total", МассивСвойств.Количество());
	Результат.Вставить("items", МассивСвойств);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции


// Свойства вида товара — ВЫВОДЯТСЯ ИЗ ТОВАРОВ (см. п.1 в шапке файла): какие допреквизиты
// реально заполнены у номенклатуры этого вида. Порядок — по имени, чтобы ответ был
// одинаковым от запроса к запросу и разница в нём означала разницу в данных.
Функция СвойстваВидаТовара(ТипТовара)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипТовара", ТипТовара);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Реквизиты.Свойство КАК Свойство,
		|	Реквизиты.Свойство.Наименование КАК Имя
		|ИЗ
		|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Ссылка.ВидТовара = &ТипТовара
		|	И Реквизиты.Ссылка.ЭтоГруппа = ЛОЖЬ
		|	И НЕ Реквизиты.Ссылка.ПометкаУдаления
		|	И Реквизиты.Свойство <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Имя";

	Выборка = Запрос.Выполнить().Выбрать();
	Свойства = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Свойства.Добавить(Выборка.Свойство);
	КонецЦикла;

	Возврат Свойства;

КонецФункции


// Значения свойства. Основной путь — справочник значений БСП; имя справочника ищется через
// метаданные, а запрос собирается строкой, поэтому модуль компилируется в любой
// конфигурации (см. п.2 в шапке файла).
//
// СопоставленнаяПапка — ВЫХОДНОЙ параметр: если задана марка и папка по имени нашлась,
// сюда кладётся {code, name}, и агент увидит, с чем именно 1С сопоставила марку.
Функция ЗначенияСвойства(Свойство, Производитель, СопоставленнаяПапка)

	ИмяСправочника = ИмяСправочникаЗначений();

	Если ИмяСправочника = "" Тогда
		Возврат ЗначенияИзТоваров(Свойство);
	КонецЕсли;

	ОтборПапки = Справочники[ИмяСправочника].ПустаяСсылка();

	Если ЗначениеЗаполнено(Производитель) Тогда
		ОтборПапки = ПапкаМаркиВЗначениях(ИмяСправочника, Свойство, Производитель);
		Если ЗначениеЗаполнено(ОтборПапки) Тогда
			СопоставленнаяПапка = Новый Структура("code,name",
				КодЭлемента(ОтборПапки), СокрЛП(Строка(ОтборПапки.Наименование)));
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Папка", ОтборПапки);
	Запрос.УстановитьПараметр("ЕстьОтборПапки", ЗначениеЗаполнено(ОтборПапки));

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Значения.Ссылка КАК Ссылка,
		|	Значения.Наименование КАК Наименование
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Значения
		|ГДЕ
		|	Значения.Владелец = &Свойство
		|	И Значения.ЭтоГруппа = ЛОЖЬ
		|	И НЕ Значения.ПометкаУдаления
		|	И (НЕ &ЕстьОтборПапки ИЛИ Значения.Ссылка В ИЕРАРХИИ (&Папка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Значения = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Значения.Добавить(Новый Структура("value,code",
			СокрЛП(Строка(Выборка.Наименование)), КодЭлемента(Выборка.Ссылка)));
	КонецЦикла;

	Возврат Значения;

КонецФункции


// Папка марки внутри иерархии значений свойства. Сопоставление ПО ИМЕНИ — ссылки на
// Производителя у справочника значений нет. Двуязычные имена («Atlas Concorde / Атлас
// конкорд») разбираются по «/», совпадением считается любая часть.
Функция ПапкаМаркиВЗначениях(ИмяСправочника, Свойство, Производитель)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Папки.Ссылка КАК Ссылка,
		|	Папки.Наименование КАК Наименование
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Папки
		|ГДЕ
		|	Папки.Владелец = &Свойство
		|	И Папки.ЭтоГруппа = ИСТИНА
		|	И НЕ Папки.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	ЧастиМарки = ЧастиИмени(Производитель.Наименование);

	Пока Выборка.Следующий() Цикл
		Если ИменаСовпадают(ЧастиМарки, ЧастиИмени(Выборка.Наименование)) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции


// Запасной путь: значения, реально проставленные у товаров. Беднее справочника — покажет
// только используемые, — но не зависит от того, как назван справочник значений.
Функция ЗначенияИзТоваров(Свойство)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", Свойство);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Реквизиты.Значение КАК Значение
		|ИЗ
		|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК Реквизиты
		|ГДЕ
		|	Реквизиты.Свойство = &Свойство
		|	И НЕ Реквизиты.Ссылка.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Значения = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Добавить(Новый Структура("value,code",
			ПредставлениеЗначения(Выборка.Значение), КодЭлемента(Выборка.Значение)));
	КонецЦикла;

	Возврат Значения;

КонецФункции


// Имя справочника значений свойств. Ищется через метаданные, поэтому модуль компилируется
// и там, где этих справочников нет. Иерархический вариант предпочтительнее: «Коллекция»
// разложена по папкам вида товара и марки, и отбор по марке возможен только в нём.
Функция ИмяСправочникаЗначений()

	Если Метаданные.Справочники.Найти("ЗначенияСвойствОбъектовИерархия") <> Неопределено Тогда
		Возврат "ЗначенияСвойствОбъектовИерархия";
	КонецЕсли;

	Если Метаданные.Справочники.Найти("ЗначенияСвойствОбъектов") <> Неопределено Тогда
		Возврат "ЗначенияСвойствОбъектов";
	КонецЕсли;

	Возврат "";

КонецФункции


// Двуязычное имя → массив нормализованных частей: «Atlas Concorde / Атлас конкорд» →
// ["atlas concorde", "атлас конкорд"].
Функция ЧастиИмени(Наименование)

	Части = Новый Массив;

	Для Каждого Кусок Из СтрРазделить(Строка(Наименование), "/", Ложь) Цикл
		Нормализованный = НРег(СокрЛП(СтрЗаменить(Кусок, "ё", "е")));
		Пока Найти(Нормализованный, "  ") > 0 Цикл
			Нормализованный = СтрЗаменить(Нормализованный, "  ", " ");
		КонецЦикла;
		Если Нормализованный <> "" Тогда
			Части.Добавить(Нормализованный);
		КонецЕсли;
	КонецЦикла;

	Возврат Части;

КонецФункции


// Совпадением считается равенство или вхождение любой части в любую: имена марок пишут то
// полностью, то сокращённо, и требовать точного равенства значило бы не находить ничего.
Функция ИменаСовпадают(ЧастиОдного, ЧастиДругого)

	Для Каждого Одна Из ЧастиОдного Цикл
		Для Каждого Другая Из ЧастиДругого Цикл
			Если Одна = Другая ИЛИ Найти(Одна, Другая) > 0 ИЛИ Найти(Другая, Одна) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции


// Код ссылки. У примитивных значений кода нет — пустая строка, и это норма, а не сбой.
Функция КодЭлемента(Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Строка(Ссылка.Код));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции


// Ответ с ошибкой — В ТОМ ЖЕ КОНВЕРТЕ, что удачный (по той же причине, что в by-tm:
// иначе сериализация спотыкается, и вместо JSON приходит HTTP 500 с HTML-страницей IIS).
Функция ОтветСОшибкойСвойств(ИмяВида, КодВида, КодОшибки, Текст)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("ref,code,message", "", КодОшибки, Текст));

	Результат = Новый Структура;
	Результат.Вставить("product_type", ИмяВида);
	Результат.Вставить("product_type_ref", КодВида);
	Результат.Вставить("matched_folder", Неопределено);
	Результат.Вставить("total", 0);
	Результат.Вставить("items", Новый Массив);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции
