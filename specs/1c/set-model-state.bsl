// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик POST get-products/set-model-state
//
// Кодировка файла: UTF-8. Контракт — specs/1c-model-form.md §2.1–2.5, §3.3.
//
// ЗАЧЕМ. Агент не может дотянуться до открытой формы: обработчик HTTP-сервиса работает в
// своём сеансе, и механизма «сервер толкнул данные в управляемую форму» в платформе нет
// (§2.5 спеки). Поэтому состояние модели оседает в 1С зеркалом, а форма читает его.
//
// КАК ПОДКЛЮЧИТЬ. Файл кладётся в ТОТ ЖЕ модуль, что by-tm.bsl и set-prices.bsl. В
// `ProductManagementPOST`, рядом с веткой set-prices:
//
//     ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "set-model-state" Тогда
//         Попытка
//             Чтение = Новый ЧтениеJSON;
//             Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
//             Данные = ПрочитатьJSON(Чтение, Истина);
//             Чтение.Закрыть();
//         Исключение
//             Возврат ОтветJSON(400, Новый Структура("error", "invalid json"));
//         КонецПопытки;
//         УстановитьПривилегированныйРежим(Истина);
//         Попытка
//             Возврат ОтветJSON(200, ПринятьСостояниеМодели(Данные));
//         Исключение
//             Возврат ОтветJSON(500, Новый Структура("error",
//                 КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
//         КонецПопытки;
//
// МАРШРУТ ЖИВЁТ НА ШАБЛОНЕ `get-products/{query-type}`, как и всё остальное:
// `ProductManagementPOST` это ИМЯ обработчика метода POST у этого шаблона, а не отдельный
// путь. `POST .../product-management/set-model-state` отдаёт 404 — проверено.
//
// `Попытка` вокруг вызова обязательна: без неё веб-сервер отдаёт свою страницу «500 -
// Internal server error», в которой текста ошибки 1С нет, и отличить «нет регистра» от
// «не тот реквизит» по ответу невозможно.
//
// Функция `ЗначениеИли` живёт в agent-commands.bsl — файлы кладутся в один модуль, второй
// раз её вставлять НЕ НУЖНО.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// Оба регистра — **независимые непериодические регистры сведений**. Строки в них пишет
// ТОЛЬКО этот обработчик; форма их читает и никогда не меняет.
//
// **`РегистрСведений.ии_МодельПрайсы`**
//   Измерение:
//     Идентификатор      Число  9,0   — номер прайса в модели
//   Ресурсы:
//     Файл               Строка 255
//     Поставщик          Строка 150
//     Статус             Строка  50
//     Готов              Булево
//     ЕстьБолееСвежий    Булево
//     НомерБолееСвежего  Число  9,0   — 0, если более свежего нет
//     ЗанятКем           Строка 100   — пусто = свободен
//     ЗанятДо            Дата (дата и время)
//     Принят             Дата (дата и время)
//
// **`РегистрСведений.ии_МодельЗадачи`**
//   Измерения:
//     Идентификатор      Число  9,0   — номер задачи в модели
//     Прайс              Число  9,0   — к какому прайсу относится
//   Ресурсы:
//     Вид                Строка  50
//     Порядок            Число  2,0   — 1–5, порядок видов задан спекой и не алфавитный
//     Предмет            Строка  20   — коллекция либо товар
//     Адрес              Строка 255   — «марка / коллекция», для показа
//     Статус             Строка  50
//     Описание           Строка (неограниченная)
//     Результат          Строка (неограниченная)
//     Выполнена          Дата (дата и время)
//
// **`Константа.ии_МодельАгентаВерсияСостояния`** — Число 15,0. Счётчик, который растёт ТОЛЬКО при
// непустой разнице. Единственное, что читает таймер формы (§2.4, §4.1).
//
// ВСЕ СТРОКОВЫЕ РЕКВИЗИТЫ — ПЕРЕМЕННОЙ ДЛИНЫ. Строка фиксированной длины дополняется
// пробелами при записи, и сравнение «то же самое или изменилось» давало бы разницу на
// каждом снимке: версия росла бы непрерывно, форма перечитывала бы списки каждые пять
// секунд, и вся экономия из §2.5 пропала бы.
//
// -------------------------------------------------------------------------------------
// ПОЧЕМУ РАЗНИЦА, А НЕ ПЕРЕЗАПИСЬ НАБОРА
//
// Снимок приходит ЦЕЛИКОМ, и соблазн велик: очистить регистр и записать заново. Тогда
// каждый снимок трогал бы все строки, и отличить «ничего не поменялось» от «поменялось
// всё» стало бы нечем — счётчик версии рос бы всегда, а форма перерисовывалась бы под
// руками у админа каждые пять секунд.
//
// Поэтому: читаем текущее, сравниваем по значению, пишем только расхождения, удаляем
// пропавшее. Ничего не изменилось — не делаем НИ ОДНОЙ записи и не трогаем версию.
//
// ОТСУТСТВУЮЩИЙ `prices` И ПУСТОЙ `prices` — РАЗНОЕ. Пустой массив значит «прайсов нет»
// и честно вычищает зеркало. Отсутствующий ключ значит, что тело пришло не то, и зеркало
// не трогается: обрезанный запрос не имеет права стереть список прайсов.
// =====================================================================================


Функция ПринятьСостояниеМодели(Данные) Экспорт

	// Ошибка возвращается ТЕКСТОМ, а не улетает наружу: необработанное исключение веб-
	// сервер подменяет страницей «500 - Internal server error» без сообщения 1С.
	// `ВСоответствие` (agent-commands.bsl) снимает зависимость от того, каким флагом
	// ветка обработчика читала JSON.
	Попытка
		Возврат СостояниеМодели(ВСоответствие(Данные));
	Исключение
		Итог = Новый Структура;
		Итог.Вставить("version", 0);
		Итог.Вставить("prices", 0);
		Итог.Вставить("tasks", 0);
		Итог.Вставить("changed", 0);
		Итог.Вставить("error", "handler_failed");
		// `Подробное…` ДОПОЛНЯЕТ краткое, а не заменяет: оно называет модуль, строку и сам
		// оператор, на котором всё сломалось. Краткое сообщение дважды приводило к лишнему
		// кругу выкладки — по нему видно ЧТО не так, но не ГДЕ.
		Итог.Вставить("message", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Вставить("detail", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

КонецФункции


Функция СостояниеМодели(Данные)

	Итог = Новый Структура;
	Итог.Вставить("version", ТекущаяВерсияСостояния());
	Итог.Вставить("prices", 0);
	Итог.Вставить("tasks", 0);
	Итог.Вставить("changed", 0);

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Итог.Вставить("error", "body_not_object");
		Возврат Итог;
	КонецЕсли;

	Прайсы = Данные.Получить("prices");

	Если ТипЗнч(Прайсы) <> Тип("Массив") Тогда
		Итог.Вставить("error", "prices_missing");
		Возврат Итог;
	КонецЕсли;

	// --- разбор снимка в две таблицы «как должно стать»
	НовыеПрайсы = Новый Соответствие;
	НовыеЗадачи = Новый Соответствие;

	Для Каждого СыройПрайс Из Прайсы Цикл

		Если ТипЗнч(СыройПрайс) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		НомерПрайса = ЧислоИли(СыройПрайс.Получить("id"), -1);

		// Прайс без номера адресовать нечем: команда по нему всё равно никуда не поедет.
		Если НомерПрайса < 0 Тогда
			Продолжить;
		КонецЕсли;

		НовыеПрайсы.Вставить(НомерПрайса, ЗначенияПрайса(НомерПрайса, СыройПрайс));

		// ПЕРЕМЕННАЯ НЕ НАЗЫВАЕТСЯ `Задачи`. Это ИМЯ ГЛОБАЛЬНОЙ КОЛЛЕКЦИИ объектов
		// метаданных — такой же, как `Справочники`, `Документы` или `РегистрыСведений`, —
		// и присваивание ей падает с «Поле объекта недоступно для записи (Задачи)».
		// Сообщение называет имя, но не место, поэтому искать пришлось отладчиком.
		//
		// Коварство в том, что имя выглядит совершенно обычным и в этом коде уместным:
		// разбираем список задач — как ещё назвать переменную. Проверка в
		// `check_bsl.py` знает этот список имён именно поэтому.
		ЗадачиПоПрайсу = СыройПрайс.Получить("tasks");

		Если ТипЗнч(ЗадачиПоПрайсу) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СыраяЗадача Из ЗадачиПоПрайсу Цикл

			Если ТипЗнч(СыраяЗадача) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;

			НомерЗадачи = ЧислоИли(СыраяЗадача.Получить("id"), -1);

			Если НомерЗадачи < 0 Тогда
				Продолжить;
			КонецЕсли;

			НовыеЗадачи.Вставить(НомерЗадачи,
				ЗначенияЗадачи(НомерЗадачи, НомерПрайса, СыраяЗадача));

		КонецЦикла;

	КонецЦикла;

	Итог.prices = НовыеПрайсы.Количество();
	Итог.tasks  = НовыеЗадачи.Количество();

	// --- применение
	//
	// Всё в одной транзакции: снимок описывает СОГЛАСОВАННОЕ состояние, и форма не должна
	// увидеть прайс без его задач или задачу без прайса. Набор маленький — десятки строк.
	НачатьТранзакцию();

	Попытка
		Изменений = ПрименитьПрайсы(НовыеПрайсы) + ПрименитьЗадачи(НовыеЗадачи);

		Если Изменений > 0 Тогда
			ПоднятьВерсиюСостояния();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог.Вставить("error", "apply_failed");
		Итог.Вставить("message", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	Итог.changed = Изменений;
	Итог.version = ТекущаяВерсияСостояния();

	Возврат Итог;

КонецФункции


// ======================================================================================
// Применение разницы
// ======================================================================================

Функция ПрименитьПрайсы(Новые)

	Изменений = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Прайсы.Идентификатор КАК Идентификатор,
		|	Прайсы.Файл КАК Файл,
		|	Прайсы.Поставщик КАК Поставщик,
		|	Прайсы.Статус КАК Статус,
		|	Прайсы.Готов КАК Готов,
		|	Прайсы.ЕстьБолееСвежий КАК ЕстьБолееСвежий,
		|	Прайсы.НомерБолееСвежего КАК НомерБолееСвежего,
		|	Прайсы.ЗанятКем КАК ЗанятКем,
		|	Прайсы.ЗанятДо КАК ЗанятДо,
		|	Прайсы.Принят КАК Принят
		|ИЗ
		|	РегистрСведений.ии_МодельПрайсы КАК Прайсы";

	Выборка = Запрос.Выполнить().Выбрать();
	Текущие = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		// Начинаем С ОБРАЗЦА, а не с пустой структуры: `ЗаполнитьЗначенияСвойств`
		// заполняет только СУЩЕСТВУЮЩИЕ свойства приёмника, и в пустую структуру
		// не попало бы ничего — сравнение показывало бы «совпало» всегда.
		Значения = ОбразецПрайса();
		ЗаполнитьЗначенияСвойств(Значения, Выборка);
		Текущие.Вставить(Выборка.Идентификатор, Значения);
	КонецЦикла;

	// пропавшее — удалить
	Для Каждого КЗ Из Текущие Цикл
		Если Новые.Получить(КЗ.Ключ) = Неопределено Тогда
			Запись = РегистрыСведений.ии_МодельПрайсы.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = КЗ.Ключ;
			Запись.Удалить();
			Изменений = Изменений + 1;
		КонецЕсли;
	КонецЦикла;

	// новое и изменившееся — записать
	Для Каждого КЗ Из Новые Цикл

		Было = Текущие.Получить(КЗ.Ключ);

		Если Было <> Неопределено И ОдинаковыеЗначения(КЗ.Значение, Было) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельПрайсы.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КЗ.Значение);
		Запись.Записать(Истина);
		Изменений = Изменений + 1;

	КонецЦикла;

	Возврат Изменений;

КонецФункции


Функция ПрименитьЗадачи(Новые)

	Изменений = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.Идентификатор КАК Идентификатор,
		|	Задачи.Прайс КАК Прайс,
		|	Задачи.Вид КАК Вид,
		|	Задачи.Порядок КАК Порядок,
		|	Задачи.Предмет КАК Предмет,
		|	Задачи.Адрес КАК Адрес,
		|	Задачи.Статус КАК Статус,
		|	Задачи.Описание КАК Описание,
		|	Задачи.Результат КАК Результат,
		|	Задачи.Выполнена КАК Выполнена
		|ИЗ
		|	РегистрСведений.ии_МодельЗадачи КАК Задачи";

	Выборка = Запрос.Выполнить().Выбрать();
	Текущие = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		// Начинаем С ОБРАЗЦА, а не с пустой структуры: `ЗаполнитьЗначенияСвойств`
		// заполняет только СУЩЕСТВУЮЩИЕ свойства приёмника, и в пустую структуру
		// не попало бы ничего — сравнение показывало бы «совпало» всегда.
		Значения = ОбразецЗадачи();
		ЗаполнитьЗначенияСвойств(Значения, Выборка);
		Текущие.Вставить(Выборка.Идентификатор, Значения);
	КонецЦикла;

	Для Каждого КЗ Из Текущие Цикл

		Стало = Новые.Получить(КЗ.Ключ);

		// Удаляем и когда задача пропала, и когда она ПЕРЕЕХАЛА НА ДРУГОЙ ПРАЙС. Второе
		// не должно случаться — `replace_tasks` не переиспользует номера, — но ключ
		// регистра составной, и запись по новому прайсу не затёрла бы строку по старому:
		// в списке появился бы призрак под тем же номером.
		Если Стало = Неопределено ИЛИ Стало.Прайс <> КЗ.Значение.Прайс Тогда
			Запись = РегистрыСведений.ии_МодельЗадачи.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = КЗ.Ключ;
			Запись.Прайс = КЗ.Значение.Прайс;
			Запись.Удалить();
			Изменений = Изменений + 1;
		КонецЕсли;

	КонецЦикла;

	Для Каждого КЗ Из Новые Цикл

		Было = Текущие.Получить(КЗ.Ключ);

		Если Было <> Неопределено И ОдинаковыеЗначения(КЗ.Значение, Было) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельЗадачи.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КЗ.Значение);
		Запись.Записать(Истина);
		Изменений = Изменений + 1;

	КонецЦикла;

	Возврат Изменений;

КонецФункции


// ======================================================================================
// Разбор одной строки снимка
//
// Ключи структур совпадают с именами измерений и ресурсов регистра — благодаря этому
// запись идёт одним `ЗаполнитьЗначенияСвойств`, а не перечислением полей, которое при
// добавлении реквизита забывают дополнить ровно в одном месте из трёх.
// ======================================================================================

Функция ОбразецПрайса()

	Значения = Новый Структура;
	Значения.Вставить("Идентификатор",     0);
	Значения.Вставить("Файл",              "");
	Значения.Вставить("Поставщик",         "");
	Значения.Вставить("Статус",            "");
	Значения.Вставить("Готов",             Ложь);
	Значения.Вставить("ЕстьБолееСвежий",   Ложь);
	Значения.Вставить("НомерБолееСвежего", 0);
	Значения.Вставить("ЗанятКем",          "");
	Значения.Вставить("ЗанятДо",           '00010101');
	Значения.Вставить("Принят",            '00010101');
	Возврат Значения;

КонецФункции


Функция ЗначенияПрайса(Номер, Сырой)

	Значения = ОбразецПрайса();

	Значения.Идентификатор     = Номер;
	Значения.Файл              = Ограничить(СтрокаИли(Сырой.Получить("file")), 255);
	Значения.Поставщик         = Ограничить(СтрокаИли(Сырой.Получить("supplier")), 150);
	Значения.Статус            = Ограничить(СтрокаИли(Сырой.Получить("status")), 50);
	Значения.Готов             = БулевоИли(Сырой.Получить("ready"));
	Значения.ЕстьБолееСвежий   = БулевоИли(Сырой.Получить("has_newer"));
	Значения.НомерБолееСвежего = ЧислоИли(Сырой.Получить("newer_id"), 0);
	Значения.ЗанятКем          = Ограничить(СтрокаИли(Сырой.Получить("locked_by")), 100);
	Значения.ЗанятДо           = ДатаИзISO(Сырой.Получить("locked_until"));
	Значения.Принят            = ДатаИзISO(Сырой.Получить("created_at"));

	Возврат Значения;

КонецФункции


Функция ОбразецЗадачи()

	Значения = Новый Структура;
	Значения.Вставить("Идентификатор", 0);
	Значения.Вставить("Прайс",         0);
	Значения.Вставить("Вид",           "");
	Значения.Вставить("Порядок",       0);
	Значения.Вставить("Предмет",       "");
	Значения.Вставить("Адрес",         "");
	Значения.Вставить("Статус",        "");
	Значения.Вставить("Описание",      "");
	Значения.Вставить("Результат",     "");
	Значения.Вставить("Выполнена",     '00010101');
	Возврат Значения;

КонецФункции


Функция ЗначенияЗадачи(Номер, НомерПрайса, Сырая)

	Значения = ОбразецЗадачи();

	Значения.Идентификатор = Номер;
	Значения.Прайс         = НомерПрайса;
	Значения.Вид           = Ограничить(СтрокаИли(Сырая.Получить("kind")), 50);
	Значения.Порядок       = ЧислоИли(Сырая.Получить("order"), 0);
	Значения.Предмет       = Ограничить(СтрокаИли(Сырая.Получить("subject")), 20);
	Значения.Адрес         = Ограничить(СтрокаИли(Сырая.Получить("address")), 255);
	Значения.Статус        = Ограничить(СтрокаИли(Сырая.Получить("status")), 50);
	Значения.Описание      = СтрокаИли(Сырая.Получить("description"));
	Значения.Результат     = СтрокаИли(Сырая.Получить("result"));
	Значения.Выполнена     = ДатаИзISO(Сырая.Получить("done_at"));

	Возврат Значения;

КонецФункции


