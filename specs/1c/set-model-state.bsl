	Значение = Константы.ии_МодельАгентаВерсияСостояния.Получить();
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции


Процедура ПоднятьВерсиюСостояния()

	Константы.ии_МодельАгентаВерсияСостояния.Установить(ТекущаяВерсияСостояния() + 1);

КонецПроцедуры


// ======================================================================================
// Мелочи
// ======================================================================================

// Сравнение «то же самое?». Сравниваются ключи НОВОГО значения: образец задаёт полный
// набор, и лишних ключей в текущем быть не может.
Функция ОдинаковыеЗначения(Новое, Текущее)

	// СТРОКИ НЕ БЫЛО — значит не совпадает, и это надо обработать ЗДЕСЬ, а не у каждого
	// вызывающего. У прайсов и задач стояла проверка `Было <> Неопределено` на их стороне,
	// и добавленное 02.10.2026 применение листов её не повторило: на первом же снимке, где
	// все строки новые, `Неопределено.Свойство(...)` уронил применение целиком с «Value is
	// not of object type». Четвёртая сущность наступила бы на то же место.
	Если Текущее = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КЗ Из Новое Цикл

		Значение = Неопределено;

		Если НЕ Текущее.Свойство(КЗ.Ключ, Значение) Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Значение <> КЗ.Значение Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции


// Обрезка под объявленную длину реквизита. Без неё длинное имя файла роняло бы запись, а
// с ней — ВЕСЬ снимок, потому что применение идёт одной транзакцией. Терять зеркало
// целиком из-за лишних символов в одном имени нельзя.
Функция Ограничить(Текст, Длина)

	Возврат ?(СтрДлина(Текст) > Длина, Лев(Текст, Длина), Текст);

КонецФункции


Функция СтрокаИли(Значение, Умолчание = "")

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Умолчание;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции


Функция ЧислоИли(Значение, Умолчание)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
		Попытка
			Возврат Число(СокрЛП(Значение));
		Исключение
			Возврат Умолчание;
		КонецПопытки;
	КонецЕсли;

	Возврат Умолчание;

КонецФункции


Функция БулевоИли(Значение, Умолчание = Ложь)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Умолчание;

КонецФункции


// Разбор ISO-момента: «2026-09-14T12:10:00». Разделители выбрасываются, остаётся
// «20260914121000» — ровно то, что понимает `Дата`.
//
// Хвост режется по четырнадцати знакам, и это закрывает и доли секунды
// («…T12:10:00.123456»), и смещение зоны («…+03:00»): агент шлёт местное время, и
// смещение в строке было бы лишним, а не значащим.
//
// Неразобранное даёт ПУСТУЮ ДАТУ, а не исключение: одна кривая метка не имеет права
// уронить весь снимок.
// Смещение местного времени сервера относительно UTC, в секундах.
//
// Агент живёт в UTC и метки присылает в нём: у него два визуала и своя база, и любая
// местная зона там была бы лишним допущением. А в форме время читает ЧЕЛОВЕК, и «принят
// 21:00» вместо 00:00 по Москве читается как ошибка. Поэтому приведение делается здесь,
// на приёме, а не в агенте: местная зона — свойство ЭТОГО сервера, и знать её должен он.
//
// Считается КАЖДЫЙ РАЗ, а не запоминается: сервер живёт месяцами, а переход на летнее
// время и правка часового пояса случаются без перезапуска.
Функция СмещениеМестного()

	Возврат ТекущаяДата() - ТекущаяУниверсальнаяДата();

КонецФункции


// ISO-метка агента (UTC) → МЕСТНОЕ время сервера. Пустая и битая дают пустую дату,
// как и раньше: «неизвестно» не должно превращаться в 01.01.0001 плюс три часа.
Функция МестноеИзISO(Значение)

	// Имя переменной НЕ «Дата»: так зовётся функция платформы, и присваивание её затеняет.
	Метка = ДатаИзISO(Значение);
	Если Метка = '00010101' Тогда
		Возврат Метка;
	КонецЕсли;

	Возврат Метка + СмещениеМестного();

КонецФункции


Функция ДатаИзISO(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат '00010101';
	КонецЕсли;

	Текст = СокрЛП(Значение);

	Если ПустаяСтрока(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;

	Текст = СтрЗаменить(Текст, "-", "");
	Текст = СтрЗаменить(Текст, ":", "");
	Текст = СтрЗаменить(Текст, "T", "");
	Текст = СтрЗаменить(Текст, " ", "");

	Если СтрДлина(Текст) = 8 Тогда
		Текст = Текст + "000000";
	КонецЕсли;

	Если СтрДлина(Текст) > 14 Тогда
		Текст = Лев(Текст, 14);
	КонецЕсли;

	Если СтрДлина(Текст) <> 14 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции
