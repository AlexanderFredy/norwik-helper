// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик POST get-products/set-model-state
//
// Кодировка файла: UTF-8. Контракт — specs/1c-model-form.md §2.1–2.5, §3.3.
//
// ЗАЧЕМ. Агент не может дотянуться до открытой формы: обработчик HTTP-сервиса работает в
// своём сеансе, и механизма «сервер толкнул данные в управляемую форму» в платформе нет
// (§2.5 спеки). Поэтому состояние модели оседает в 1С зеркалом, а форма читает его.
//
// КАК ПОДКЛЮЧИТЬ. Файл кладётся в ТОТ ЖЕ модуль, что by-tm.bsl и set-prices.bsl. В
// `ProductManagementPOST`, рядом с веткой set-prices:
//
//     ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "set-model-state" Тогда
//         Попытка
//             Чтение = Новый ЧтениеJSON;
//             Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
//             Данные = ПрочитатьJSON(Чтение, Истина);
//             Чтение.Закрыть();
//         Исключение
//             Возврат ОтветJSON(400, Новый Структура("error", "invalid json"));
//         КонецПопытки;
//         УстановитьПривилегированныйРежим(Истина);
//         Попытка
//             Возврат ОтветJSON(200, ПринятьСостояниеМодели(Данные));
//         Исключение
//             Возврат ОтветJSON(500, Новый Структура("error",
//                 КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
//         КонецПопытки;
//
// МАРШРУТ ЖИВЁТ НА ШАБЛОНЕ `get-products/{query-type}`, как и всё остальное:
// `ProductManagementPOST` это ИМЯ обработчика метода POST у этого шаблона, а не отдельный
// путь. `POST .../product-management/set-model-state` отдаёт 404 — проверено.
//
// `Попытка` вокруг вызова обязательна: без неё веб-сервер отдаёт свою страницу «500 -
// Internal server error», в которой текста ошибки 1С нет, и отличить «нет регистра» от
// «не тот реквизит» по ответу невозможно.
//
// Функция `ЗначениеИли` живёт в agent-commands.bsl — файлы кладутся в один модуль, второй
// раз её вставлять НЕ НУЖНО.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// Оба регистра — **независимые непериодические регистры сведений**. Строки в них пишет
// ТОЛЬКО этот обработчик; форма их читает и никогда не меняет.
//
// **`РегистрСведений.ии_МодельПрайсы`**
//   Измерение:
//     Идентификатор      Число  9,0   — номер прайса в модели
//   Ресурсы:
//     Файл               Строка 255
//     Поставщик          СправочникСсылка.ии_МодельПоставщики — ССЫЛКА, не строка
//                        (решение админа 24.09.2026). По двойному щелчку в форме
//                        открывается карточка, а к ней привязываются юрлица; строкой
//                        ни того, ни другого не сделать. Элемент заводится по КОДУ
//                        поставщика из модели — тем же `ПоставщикЗеркала`, что и при
//                        записи цен, поэтому справочник один на оба применения.
//     Сигнатура          Строка  64   — хеш формата файла. По нему форма открывает выбор
//                        листов двойным щелчком по имени файла (решение админа 02.10.2026).
//                        Искать формат по имени файла нельзя: имена меняются каждый месяц,
//                        формат тот же.
//     Статус             Строка  50
//     Готов              Булево
//     ЕстьБолееСвежий    Булево
//     НомерБолееСвежего  Число  9,0   — 0, если более свежего нет
//     ЗанятКем           Строка 100   — пусто = свободен
//     ЗанятДо            Дата (дата и время)
//     Принят             Дата (дата и время)
//
// **`РегистрСведений.ии_МодельЗадачи`**
//   Измерения:
//     Идентификатор      Число  9,0   — номер задачи в модели
//     Прайс              Число  9,0   — к какому прайсу относится
//   Ресурсы:
//     Вид                Строка  50
//     Порядок            Число  2,0   — 1–5, порядок видов задан спекой и не алфавитный
//     Предмет            Строка  20   — коллекция либо товар
//     Адрес              Строка 255   — «марка / коллекция», для показа
//     Статус             Строка  50
//     Описание           Строка (неограниченная)
//     Результат          Строка (неограниченная)
//     Выполнена          Дата (дата и время) — когда задачу ЗАПУСКАЛИ в последний раз,
//                        чем бы прогон ни кончился. Приезжает в ключе `run_at`: у закрытой
//                        задачи это тот же прогон, что её закрыл, а у незакрытой прежняя
//                        дата закрытия всё равно была пустой — зато теперь видно, что
//                        задачу уже пробовали.
//
// **`Константа.ии_МодельАгентаВерсияСостояния`** — Число 15,0. Счётчик, который растёт ТОЛЬКО при
// непустой разнице. Единственное, что читает таймер формы (§2.4, §4.1).
//
// ВСЕ СТРОКОВЫЕ РЕКВИЗИТЫ — ПЕРЕМЕННОЙ ДЛИНЫ. Строка фиксированной длины дополняется
// пробелами при записи, и сравнение «то же самое или изменилось» давало бы разницу на
// каждом снимке: версия росла бы непрерывно, форма перечитывала бы списки каждые пять
// секунд, и вся экономия из §2.5 пропала бы.
//
// -------------------------------------------------------------------------------------
// ПОЧЕМУ РАЗНИЦА, А НЕ ПЕРЕЗАПИСЬ НАБОРА
//
// Снимок приходит ЦЕЛИКОМ, и соблазн велик: очистить регистр и записать заново. Тогда
// каждый снимок трогал бы все строки, и отличить «ничего не поменялось» от «поменялось
// всё» стало бы нечем — счётчик версии рос бы всегда, а форма перерисовывалась бы под
// руками у админа каждые пять секунд.
//
// Поэтому: читаем текущее, сравниваем по значению, пишем только расхождения, удаляем
// пропавшее. Ничего не изменилось — не делаем НИ ОДНОЙ записи и не трогаем версию.
//
// ОТСУТСТВУЮЩИЙ `prices` И ПУСТОЙ `prices` — РАЗНОЕ. Пустой массив значит «прайсов нет»
// и честно вычищает зеркало. Отсутствующий ключ значит, что тело пришло не то, и зеркало
// не трогается: обрезанный запрос не имеет права стереть список прайсов.
// =====================================================================================


Функция ПринятьСостояниеМодели(Данные) Экспорт

	// Ошибка возвращается ТЕКСТОМ, а не улетает наружу: необработанное исключение веб-
	// сервер подменяет страницей «500 - Internal server error» без сообщения 1С.
	// `ВСоответствие` (agent-commands.bsl) снимает зависимость от того, каким флагом
	// ветка обработчика читала JSON.
	Попытка
		Возврат СостояниеМодели(ВСоответствие(Данные));
	Исключение
		Итог = Новый Структура;
		Итог.Вставить("version", 0);
		Итог.Вставить("prices", 0);
		Итог.Вставить("tasks", 0);
		Итог.Вставить("changed", 0);
		Итог.Вставить("error", "handler_failed");
		// `Подробное…` ДОПОЛНЯЕТ краткое, а не заменяет: оно называет модуль, строку и сам
		// оператор, на котором всё сломалось. Краткое сообщение дважды приводило к лишнему
		// кругу выкладки — по нему видно ЧТО не так, но не ГДЕ.
		Итог.Вставить("message", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Итог.Вставить("detail", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

КонецФункции


Функция СостояниеМодели(Данные)

	Итог = Новый Структура;
	Итог.Вставить("version", ТекущаяВерсияСостояния());
	Итог.Вставить("prices", 0);
	Итог.Вставить("tasks", 0);
	Итог.Вставить("changed", 0);

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Итог.Вставить("error", "body_not_object");
		Возврат Итог;
	КонецЕсли;

	Прайсы = Данные.Получить("prices");

	Если ТипЗнч(Прайсы) <> Тип("Массив") Тогда
		Итог.Вставить("error", "prices_missing");
		Возврат Итог;
	КонецЕсли;

	// --- разбор снимка в две таблицы «как должно стать»
	НовыеПрайсы = Новый Соответствие;
	НовыеЗадачи = Новый Соответствие;

	Для Каждого СыройПрайс Из Прайсы Цикл

		Если ТипЗнч(СыройПрайс) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		НомерПрайса = ЧислоИли(СыройПрайс.Получить("id"), -1);

		// Прайс без номера адресовать нечем: команда по нему всё равно никуда не поедет.
		Если НомерПрайса < 0 Тогда
			Продолжить;
		КонецЕсли;

		НовыеПрайсы.Вставить(НомерПрайса, ЗначенияПрайса(НомерПрайса, СыройПрайс));

		// ПЕРЕМЕННАЯ НЕ НАЗЫВАЕТСЯ `Задачи`. Это ИМЯ ГЛОБАЛЬНОЙ КОЛЛЕКЦИИ объектов
		// метаданных — такой же, как `Справочники`, `Документы` или `РегистрыСведений`, —
		// и присваивание ей падает с «Поле объекта недоступно для записи (Задачи)».
		// Сообщение называет имя, но не место, поэтому искать пришлось отладчиком.
		//
		// Коварство в том, что имя выглядит совершенно обычным и в этом коде уместным:
		// разбираем список задач — как ещё назвать переменную. Проверка в
		// `check_bsl.py` знает этот список имён именно поэтому.
		ЗадачиПоПрайсу = СыройПрайс.Получить("tasks");

		Если ТипЗнч(ЗадачиПоПрайсу) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СыраяЗадача Из ЗадачиПоПрайсу Цикл

			Если ТипЗнч(СыраяЗадача) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;

			НомерЗадачи = ЧислоИли(СыраяЗадача.Получить("id"), -1);

			Если НомерЗадачи < 0 Тогда
				Продолжить;
			КонецЕсли;

			НовыеЗадачи.Вставить(НомерЗадачи,
				ЗначенияЗадачи(НомерЗадачи, НомерПрайса, СыраяЗадача));

		КонецЦикла;

	КонецЦикла;

	Итог.prices = НовыеПрайсы.Количество();
	Итог.tasks  = НовыеЗадачи.Количество();

	// ЛИСТЫ ФОРМАТОВ — НЕОБЯЗАТЕЛЬНЫЙ БЛОК, и это не поблажка старому агенту. Отсутствие
	// ключа значит «про листы ничего не сказано, не трогай», пустой массив — «листов нет,
	// вычисти зеркало». Обрезанный или старый запрос не должен стирать выбор админа, а
	// честный снимок без форматов — должен.
	НовыеЛисты = Новый Соответствие;
	СырыеЛисты = Данные.Получить("sheets");
	ЛистыПрисланы = (ТипЗнч(СырыеЛисты) = Тип("Массив"));

	Если ЛистыПрисланы Тогда
		Для Каждого СыройЛист Из СырыеЛисты Цикл
			Если ТипЗнч(СыройЛист) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			Значения = ЗначенияЛиста(СыройЛист);
			// Без формата или без имени листа строку не адресовать: ключ регистра — пара.
			Если ПустаяСтрока(Значения.Сигнатура) ИЛИ ПустаяСтрока(Значения.Лист) Тогда
				Продолжить;
			КонецЕсли;
			НовыеЛисты.Вставить(Значения.Сигнатура + "|" + Значения.Лист, Значения);
		КонецЦикла;
	КонецЕсли;

	Итог.Вставить("sheets", НовыеЛисты.Количество());

	// БРЕНДЫ ФОРМАТОВ — третий такой же блок (решение админа 03.10.2026) и с тем же
	// правилом: нет ключа — про бренды ничего не сказано, не трогай; пустой массив —
	// брендов нет, вычисти зеркало.
	//
	// Зачем они вообще: выбор ЛИСТОВ бесполезен прайсу, у которого лист один. У «Остатков»
	// одна вкладка на 1286 строк и 23 бренда, и к разбору уходит ПЕРЕСЕЧЕНИЕ отмеченных
	// листов и отмеченных брендов.
	НовыеБренды = Новый Соответствие;
	СырыеБренды = Данные.Получить("marks");
	БрендыПрисланы = (ТипЗнч(СырыеБренды) = Тип("Массив"));

	Если БрендыПрисланы Тогда
		Для Каждого СыройБренд Из СырыеБренды Цикл
			Если ТипЗнч(СыройБренд) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			Значения = ЗначенияБренда(СыройБренд);
			// Без формата или без имени бренда строку не адресовать: ключ регистра — пара.
			Если ПустаяСтрока(Значения.Сигнатура) ИЛИ ПустаяСтрока(Значения.Бренд) Тогда
				Продолжить;
			КонецЕсли;
			НовыеБренды.Вставить(Значения.Сигнатура + "|" + Значения.Бренд, Значения);
		КонецЦикла;
	КонецЕсли;

	Итог.Вставить("marks", НовыеБренды.Количество());

	// --- применение
	//
	// Всё в одной транзакции: снимок описывает СОГЛАСОВАННОЕ состояние, и форма не должна
	// увидеть прайс без его задач или задачу без прайса. Набор маленький — десятки строк.
	НачатьТранзакцию();

	Попытка
		Изменений = ПрименитьПрайсы(НовыеПрайсы) + ПрименитьЗадачи(НовыеЗадачи);

		Если ЛистыПрисланы Тогда
			Изменений = Изменений + ПрименитьЛисты(НовыеЛисты);
		КонецЕсли;

		Если БрендыПрисланы Тогда
			Изменений = Изменений + ПрименитьБренды(НовыеБренды);
		КонецЕсли;

		Если Изменений > 0 Тогда
			ПоднятьВерсиюСостояния();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог.Вставить("error", "apply_failed");
		Итог.Вставить("message", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Итог;
	КонецПопытки;

	Итог.changed = Изменений;
	Итог.version = ТекущаяВерсияСостояния();

	Возврат Итог;

КонецФункции


// ======================================================================================
// Применение разницы
// ======================================================================================

Функция ПрименитьПрайсы(Новые)

	Изменений = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Прайсы.Идентификатор КАК Идентификатор,
		|	Прайсы.Файл КАК Файл,
		|	Прайсы.Поставщик КАК Поставщик,
		|	Прайсы.Сигнатура КАК Сигнатура,
		|	Прайсы.Статус КАК Статус,
		|	Прайсы.Готов КАК Готов,
		|	Прайсы.ЕстьБолееСвежий КАК ЕстьБолееСвежий,
		|	Прайсы.НомерБолееСвежего КАК НомерБолееСвежего,
		|	Прайсы.ЗанятКем КАК ЗанятКем,
		|	Прайсы.ЗанятДо КАК ЗанятДо,
		|	Прайсы.Принят КАК Принят,
		|	Прайсы.КурсЕвро КАК КурсЕвро
		|ИЗ
		|	РегистрСведений.ии_МодельПрайсы КАК Прайсы";

	Выборка = Запрос.Выполнить().Выбрать();
	Текущие = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		// Начинаем С ОБРАЗЦА, а не с пустой структуры: `ЗаполнитьЗначенияСвойств`
		// заполняет только СУЩЕСТВУЮЩИЕ свойства приёмника, и в пустую структуру
		// не попало бы ничего — сравнение показывало бы «совпало» всегда.
		Значения = ОбразецПрайса();
		ЗаполнитьЗначенияСвойств(Значения, Выборка);
		Текущие.Вставить(Выборка.Идентификатор, Значения);
	КонецЦикла;

	// пропавшее — удалить
	Для Каждого КЗ Из Текущие Цикл
		Если Новые.Получить(КЗ.Ключ) = Неопределено Тогда
			Запись = РегистрыСведений.ии_МодельПрайсы.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = КЗ.Ключ;
			Запись.Удалить();
			Изменений = Изменений + 1;
		КонецЕсли;
	КонецЦикла;

	// новое и изменившееся — записать
	Для Каждого КЗ Из Новые Цикл

		Было = Текущие.Получить(КЗ.Ключ);

		Если Было <> Неопределено И ОдинаковыеЗначения(КЗ.Значение, Было) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельПрайсы.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КЗ.Значение);
		Запись.Записать(Истина);
		Изменений = Изменений + 1;

	КонецЦикла;

	Возврат Изменений;

КонецФункции


Функция ПрименитьЗадачи(Новые)

	Изменений = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.Идентификатор КАК Идентификатор,
		|	Задачи.Прайс КАК Прайс,
		|	Задачи.Вид КАК Вид,
		|	Задачи.Порядок КАК Порядок,
		|	Задачи.Предмет КАК Предмет,
		|	Задачи.Адрес КАК Адрес,
		|	Задачи.Статус КАК Статус,
		|	Задачи.Описание КАК Описание,
		|	Задачи.Результат КАК Результат,
		|	Задачи.Выполнена КАК Выполнена
		|ИЗ
		|	РегистрСведений.ии_МодельЗадачи КАК Задачи";

	Выборка = Запрос.Выполнить().Выбрать();
	Текущие = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		// Начинаем С ОБРАЗЦА, а не с пустой структуры: `ЗаполнитьЗначенияСвойств`
		// заполняет только СУЩЕСТВУЮЩИЕ свойства приёмника, и в пустую структуру
		// не попало бы ничего — сравнение показывало бы «совпало» всегда.
		Значения = ОбразецЗадачи();
		ЗаполнитьЗначенияСвойств(Значения, Выборка);
		Текущие.Вставить(Выборка.Идентификатор, Значения);
	КонецЦикла;

	Для Каждого КЗ Из Текущие Цикл

		Стало = Новые.Получить(КЗ.Ключ);

		// Удаляем и когда задача пропала, и когда она ПЕРЕЕХАЛА НА ДРУГОЙ ПРАЙС. Второе
		// не должно случаться — `replace_tasks` не переиспользует номера, — но ключ
		// регистра составной, и запись по новому прайсу не затёрла бы строку по старому:
		// в списке появился бы призрак под тем же номером.
		Если Стало = Неопределено ИЛИ Стало.Прайс <> КЗ.Значение.Прайс Тогда
			Запись = РегистрыСведений.ии_МодельЗадачи.СоздатьМенеджерЗаписи();
			Запись.Идентификатор = КЗ.Ключ;
			Запись.Прайс = КЗ.Значение.Прайс;
			Запись.Удалить();
			Изменений = Изменений + 1;
		КонецЕсли;

	КонецЦикла;

	Для Каждого КЗ Из Новые Цикл

		Было = Текущие.Получить(КЗ.Ключ);

		Если Было <> Неопределено И ОдинаковыеЗначения(КЗ.Значение, Было) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельЗадачи.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КЗ.Значение);
		Запись.Записать(Истина);
		Изменений = Изменений + 1;

	КонецЦикла;

	Возврат Изменений;

КонецФункции


// ======================================================================================
// Разбор одной строки снимка
//
// Ключи структур совпадают с именами измерений и ресурсов регистра — благодаря этому
// запись идёт одним `ЗаполнитьЗначенияСвойств`, а не перечислением полей, которое при
// добавлении реквизита забывают дополнить ровно в одном месте из трёх.
// ======================================================================================

// ======================================================================================
// ЛИСТЫ ФОРМАТОВ (решение админа 02.10.2026)
//
// Строка на ЛИСТ, а не строка на формат со списком в поле: в форме это таблица с флажком,
// а снимок применяется РАЗНИЦЕЙ — построчно. Список в одном поле означал бы перезапись всей
// таблицы на каждое изменение одного флажка, то есть перерисовку под руками у админа.
//
// Ключ — пара (Сигнатура, Лист). Сигнатура — хеш скелета файла, по ней же форма и
// открывается двойным щелчком по имени файла в таблице прайсов.
// ======================================================================================

Функция ОбразецЛиста()

	Возврат Новый Структура("Сигнатура,Лист,Поставщик,Формат,Порядок,Разбирать",
		"", "", Справочники.ии_МодельПоставщики.ПустаяСсылка(), "", 0, Ложь);

КонецФункции


Функция ЗначенияЛиста(Сырой)

	Значения = ОбразецЛиста();
	Значения.Сигнатура = Ограничить(СтрокаИли(Сырой.Получить("signature")), 64);
	Значения.Лист      = Ограничить(СтрокаИли(Сырой.Получить("sheet")), 150);
	// ПОСТАВЩИК — ССЫЛКА, как и в регистре прайсов (правка админа 02.10.2026). Строкой это
	// была бы ВТОРАЯ копия имени в зеркале: справочник `ии_МодельПоставщики` заведён ровно
	// затем, чтобы имя жило в одном месте и правилось в одном месте. Элемент ищется и
	// заводится ПО КОДУ тем же `ПоставщикЗеркала`, что и при записи цен, — по имени
	// зеркало плодило бы дубль на каждое переименование.
	Значения.Поставщик = ПоставщикЗеркала(Сырой.Получить("supplier_code"),
		Сырой.Получить("supplier"));
	Значения.Формат    = Ограничить(СтрокаИли(Сырой.Получить("format")), 150);
	Значения.Порядок   = ЧислоИли(Сырой.Получить("order"), 0);
	Значения.Разбирать = БулевоИли(Сырой.Получить("parse"));
	Возврат Значения;

КонецФункции


Функция ПрименитьЛисты(Новые)

	Изменений = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Листы.Сигнатура КАК Сигнатура,
		|	Листы.Лист КАК Лист,
		|	Листы.Поставщик КАК Поставщик,
		|	Листы.Формат КАК Формат,
		|	Листы.Порядок КАК Порядок,
		|	Листы.Разбирать КАК Разбирать
		|ИЗ
		|	РегистрСведений.ии_МодельЛистыПрайсов КАК Листы";

	Выборка = Запрос.Выполнить().Выбрать();
	Текущие = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		Значения = ОбразецЛиста();
		ЗаполнитьЗначенияСвойств(Значения, Выборка);
		Текущие.Вставить(Выборка.Сигнатура + "|" + Выборка.Лист, Значения);
	КонецЦикла;

	// пропавшее — удалить: поставщик убрал лист из книги, и показывать его больше незачем
	Для Каждого КЗ Из Текущие Цикл
		Если Новые.Получить(КЗ.Ключ) = Неопределено Тогда
			Запись = РегистрыСведений.ии_МодельЛистыПрайсов.СоздатьМенеджерЗаписи();
			Запись.Сигнатура = КЗ.Значение.Сигнатура;
			Запись.Лист      = КЗ.Значение.Лист;
			Запись.Удалить();
			Изменений = Изменений + 1;
		КонецЕсли;
	КонецЦикла;

	// новое и изменившееся — записать
	Для Каждого КЗ Из Новые Цикл
		Если ОдинаковыеЗначения(КЗ.Значение, Текущие.Получить(КЗ.Ключ)) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельЛистыПрайсов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КЗ.Значение);
		Запись.Записать(Истина);
		Изменений = Изменений + 1;
	КонецЦикла;

	Возврат Изменений;

КонецФункции


// ======================================================================================
// БРЕНДЫ ФОРМАТА — зеркало формы выбора брендов (решение админа 03.10.2026)
//
// Строка на БРЕНД, по тем же причинам, что и строка на лист: в форме это таблица с
// флажком, а снимок применяется РАЗНИЦЕЙ, построчно.
//
// Ключ — пара (Сигнатура, Бренд). Бренд хранится КАК НАПИСАН В ФАЙЛЕ: сравнивает агент
// нормализованное имя, а человек узнаёт ярлык таким, каким его видит в прайсе.
//
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ: регистр сведений `ии_МодельБрендыПрайсов`, независимый,
// непериодический.
//   Измерения: `Сигнатура` Строка 64, `Бренд` Строка 150.
//   Ресурсы:   `Поставщик` СправочникСсылка.ии_МодельПоставщики,
//              `Порядок` Число 3,0 — порядок в файле, не алфавитный;
//              `Строк` Число 6,0 — сколько позиций бренда в последнем файле. НОЛЬ значит
//                  «в последнем файле бренда не было»: строка остаётся, потому что вместе
//                  с ней остаются флажок, марка и скидка, а ноль — это новость для админа;
//              `Разбирать` Булево — флажок админа;
//              `Марка` СправочникСсылка.Производители — настоящий справочник марок базы
//                  (не зеркало: марки у нас не зеркалятся, агент знает их по коду);
//              `Скидка` Число 5,2 — процент скидки от розницы, СВОЙ у каждого бренда.
// ======================================================================================

Функция ОбразецБренда()

	// ОБРАЗЕЦ И ПРИСВАИВАНИЕ ОБЯЗАНЫ СОВПАДАТЬ ПО СОСТАВУ — то же правило, что у прайса:
	// `ЗаполнитьЗначенияСвойств` заполняет только существующие свойства, а присваивание
	// отсутствующего падает с «Object field not found», и снимок перестаёт применяться
	// ЦЕЛИКОМ. Проверяется статическим тестом `tests/test_bsl_samples.py`.
	Возврат Новый Структура(
		"Сигнатура,Бренд,Поставщик,Порядок,Строк,Разбирать,Марка,Скидка",
		"", "", Справочники.ии_МодельПоставщики.ПустаяСсылка(), 0, 0, Ложь,
		Справочники.Производители.ПустаяСсылка(), 0);

КонецФункции


Функция ЗначенияБренда(Сырой)

	Значения = ОбразецБренда();
	Значения.Сигнатура = Ограничить(СтрокаИли(Сырой.Получить("signature")), 64);
	Значения.Бренд     = Ограничить(СтрокаИли(Сырой.Получить("brand")), 150);
	Значения.Поставщик = ПоставщикЗеркала(Сырой.Получить("supplier_code"),
		Сырой.Получить("supplier"));
	Значения.Порядок   = ЧислоИли(Сырой.Получить("order"), 0);
	Значения.Строк     = ЧислоИли(Сырой.Получить("rows"), 0);
	Значения.Разбирать = БулевоИли(Сырой.Получить("parse"));
	// МАРКА ИЩЕТСЯ ПО КОДУ, а не по имени: имя в справочнике двуязычное
	// («Atlas Concorde / Атлас конкорд»), и поиск по нему разошёлся бы с агентом, который
	// знает марку кодом. Не нашлась — оставляем пустой: админ выберет сам, и это штатный
	// случай, а не сбой (из 23 ярлыков «Остатков» в справочнике нет тринадцати).
	Значения.Марка     = МаркаПоКоду(Сырой.Получить("tm_code"));
	Значения.Скидка    = ЧислоИли(Сырой.Получить("discount"), 0);
	Возврат Значения;

КонецФункции


Функция МаркаПоКоду(Код)

	Текст = СтрокаИли(Код);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Справочники.Производители.ПустаяСсылка();
	КонецЕсли;

	Найденная = Справочники.Производители.НайтиПоКоду(СокрЛП(Текст));
	Возврат ?(Найденная.Пустая(), Справочники.Производители.ПустаяСсылка(), Найденная);

КонецФункции


Функция ПрименитьБренды(Новые)

	Изменений = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Бренды.Сигнатура КАК Сигнатура,
		|	Бренды.Бренд КАК Бренд,
		|	Бренды.Поставщик КАК Поставщик,
		|	Бренды.Порядок КАК Порядок,
		|	Бренды.Строк КАК Строк,
		|	Бренды.Разбирать КАК Разбирать,
		|	Бренды.Марка КАК Марка,
		|	Бренды.Скидка КАК Скидка
		|ИЗ
		|	РегистрСведений.ии_МодельБрендыПрайсов КАК Бренды";

	Выборка = Запрос.Выполнить().Выбрать();
	Текущие = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		Значения = ОбразецБренда();
		ЗаполнитьЗначенияСвойств(Значения, Выборка);
		Текущие.Вставить(Выборка.Сигнатура + "|" + Выборка.Бренд, Значения);
	КонецЦикла;

	// пропавшее — удалить: формат переехал на другой хеш либо прайс больше не приходит
	Для Каждого КЗ Из Текущие Цикл
		Если Новые.Получить(КЗ.Ключ) = Неопределено Тогда
			Запись = РегистрыСведений.ии_МодельБрендыПрайсов.СоздатьМенеджерЗаписи();
			Запись.Сигнатура = КЗ.Значение.Сигнатура;
			Запись.Бренд     = КЗ.Значение.Бренд;
			Запись.Удалить();
			Изменений = Изменений + 1;
		КонецЕсли;
	КонецЦикла;

	// новое и изменившееся — записать
	Для Каждого КЗ Из Новые Цикл
		Если ОдинаковыеЗначения(КЗ.Значение, Текущие.Получить(КЗ.Ключ)) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельБрендыПрайсов.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, КЗ.Значение);
		Запись.Записать(Истина);
		Изменений = Изменений + 1;
	КонецЦикла;

	Возврат Изменений;

КонецФункции


Функция ОбразецПрайса()

	Значения = Новый Структура;
	Значения.Вставить("Идентификатор",     0);
	Значения.Вставить("Файл",              "");
	Значения.Вставить("Поставщик",         Справочники.ии_МодельПоставщики.ПустаяСсылка());
	// ОБРАЗЕЦ И ПРИСВАИВАНИЕ ОБЯЗАНЫ СОВПАДАТЬ ПО СОСТАВУ. `ЗаполнитьЗначенияСвойств`
	// заполняет только существующие свойства, а присваивание отсутствующего падает с
	// «Object field not found» — ровно это и случилось 02.10.2026, когда поле добавили в
	// `ЗначенияПрайса`, а здесь забыли: снимок перестал применяться целиком.
	Значения.Вставить("Сигнатура",         "");
	Значения.Вставить("Статус",            "");
	Значения.Вставить("Готов",             Ложь);
	Значения.Вставить("ЕстьБолееСвежий",   Ложь);
	Значения.Вставить("НомерБолееСвежего", 0);
	Значения.Вставить("ЗанятКем",          "");
	Значения.Вставить("ЗанятДо",           '00010101');
	Значения.Вставить("Принят",            '00010101');
	// КУРС ЕВРО ЭТОГО ПРАЙСА (решение админа 03.10.2026): форма брендов его показывает и
	// даёт поправить. У ПРАЙСА, а не у формата: курс меняется каждый день, и посчитать
	// цены по прошлому значило бы записать в 1С цифру, которой нет. Ноль = не задан.
	Значения.Вставить("КурсЕвро",          0);
	Возврат Значения;

КонецФункции


Функция ЗначенияПрайса(Номер, Сырой)

	Значения = ОбразецПрайса();

	Значения.Идентификатор     = Номер;
	Значения.Файл              = Ограничить(СтрокаИли(Сырой.Получить("file")), 255);
	// Элемент справочника заводится ЗДЕСЬ ЖЕ, если его ещё нет: снимок приходит по всем
	// прайсам регулярно, и это самое раннее место, где мы вообще узнаём о поставщике.
	// Ждать первой записи цены значило бы держать колонку пустой до неё.
	Значения.Поставщик         = ПоставщикЗеркала(Сырой.Получить("supplier_code"),
		Сырой.Получить("supplier"));
	Значения.Сигнатура         = Ограничить(СтрокаИли(Сырой.Получить("signature")), 64);
	Значения.Статус            = Ограничить(СтрокаИли(Сырой.Получить("status")), 50);
	Значения.Готов             = БулевоИли(Сырой.Получить("ready"));
	Значения.ЕстьБолееСвежий   = БулевоИли(Сырой.Получить("has_newer"));
	Значения.НомерБолееСвежего = ЧислоИли(Сырой.Получить("newer_id"), 0);
	Значения.ЗанятКем          = Ограничить(СтрокаИли(Сырой.Получить("locked_by")), 100);
	Значения.ЗанятДо           = МестноеИзISO(Сырой.Получить("locked_until"));
	Значения.Принят            = МестноеИзISO(Сырой.Получить("created_at"));
	Значения.КурсЕвро          = ЧислоИли(Сырой.Получить("eur_rate"), 0);

	Возврат Значения;

КонецФункции


Функция ОбразецЗадачи()

	Значения = Новый Структура;
	Значения.Вставить("Идентификатор", 0);
	Значения.Вставить("Прайс",         0);
	Значения.Вставить("Вид",           "");
	Значения.Вставить("Порядок",       0);
	Значения.Вставить("Предмет",       "");
	Значения.Вставить("Адрес",         "");
	Значения.Вставить("Статус",        "");
	Значения.Вставить("Описание",      "");
	Значения.Вставить("Результат",     "");
