#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Списки статусов задаются ЗДЕСЬ, а не перечислением конфигурации (§4.6 спеки):
	// источник истины для них — модель на стороне агента, а зеркало лишь приёмник.
	// Перечисление пришлось бы менять в конфигурации при каждом изменении модели, и до
	// тех пор снимок не записывался бы вовсе — он применяется одной транзакцией.
	СписокСтатусовПрайса = Элементы.СтатусПрайсаВыбор.СписокВыбора;
	СписокСтатусовПрайса.Добавить("к обработке");
	СписокСтатусовПрайса.Добавить("частично обработан");
	СписокСтатусовПрайса.Добавить("выполнен");

	СписокСтатусовЗадачи = Элементы.СтатусЗадачиВыбор.СписокВыбора;
	СписокСтатусовЗадачи.Добавить("к обработке");
	СписокСтатусовЗадачи.Добавить("выполнена");
	СписокСтатусовЗадачи.Добавить("частично обработана");

	// ФИЛЬТР ПО СТАТУСУ. Пустая строка первой и означает «все»: она же значение по
	// умолчанию, и открытая форма обязана показывать весь список — фильтр, включённый
	// сам собой, прячет работу, о которой админ не знает, что она спрятана.
	СписокФильтра = Элементы.ФильтрСтатус.СписокВыбора;
	СписокФильтра.Добавить("", "все статусы");
	СписокФильтра.Добавить("к обработке");
	СписокФильтра.Добавить("частично обработан");
	СписокФильтра.Добавить("выполнен");

	ПрочитатьСостояние();

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Пять секунд — минимальный осмысленный период: команда доезжает до агента за те же
	// пять секунд при активности и до тридцати в простое (§9.1 модели). Чаще — значит
	// опрашивать быстрее, чем на той стороне вообще что-то происходит.
	//
	// Таймер читает ОДНО ЧИСЛО — версию состояния. Пока она не выросла, форма не делает
	// ничего: ни запроса к спискам, ни перерисовки.
	ПодключитьОбработчикОжидания("ПоТаймеру", 5);

	// Пока ничего не выделено, кнопки обязаны быть погашены: нажатие без выделения
	// отправило бы команду по прайсу номер ноль.
	// Списки прочитал `ПриСозданииНаСервере`, но счётчик ожидания — дело клиента: если
	// форму открыли, когда команда уже висит, он обязан тикать с первой секунды, а не с
	// первого обновления. И обязательно ДО `ОбновитьДоступность` — та считает видимость
	// поля по непустоте строки.
	ЗапуститьСчётчикОжидания();
	ОбновитьДоступность();

КонецПроцедуры


// ЗАКРЫЛАСЬ ФОРМА ЛИСТОВ — ОБНОВЛЯЕМСЯ СРАЗУ, не дожидаясь пятисекундного такта: замок
// и надпись обязаны появиться в тот же миг, когда команда поставлена, иначе админ успеет
// нажать «Обновить задачи» по прайсу, по которому уже идёт запись листов.
//
// Обновляемся при ЛЮБОМ закрытии, а не только после отправки: отличить одно от другого
// значило бы договариваться с формой листов о возвращаемом значении, а цена лишнего
// обновления — один запрос, который и так идёт раз в пять секунд.
&НаКлиенте
Процедура ПослеВыбораЛистов(Результат, ДопДанные) Экспорт

	ОбновитьВсё();

КонецПроцедуры


&НаКлиенте
Процедура ПоТаймеру()

	Если ПрочитатьВерсию() <> ТекущаяВерсия Тогда
		ОбновитьВсё();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбновлениеСостояния

&НаКлиенте
Процедура ОбновитьФорму(Команда)

	// Кнопка нужна и при живом таймере: админ, который только что нажал «Выполнить»,
	// хочет увидеть результат, не дожидаясь очередного тика.
	ОбновитьВсё();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьВсё()

	ПрайсДо  = ВыбранныйПрайс;
	ЗадачаДо = ВыбраннаяЗадача;

	ПрочитатьСостояние();
	ВосстановитьВыделение(ПрайсДо, ЗадачаДо);
	// СЧЁТЧИК ЗАПУСКАЕТСЯ ДО `ОбновитьДоступность`, и порядок тут не вкусовой: видимость
	// поля считается по непустоте `СтрокаОжидания`, и если заполнить её позже, поле
	// успеет спрятаться — надпись не покажется вовсе до следующего обновления. Ровно на
	// этом она и пропала 30.09.2026.
	ЗапуститьСчётчикОжидания();
	ОбновитьДоступность();

КонецПроцедуры


// ======================================================================================
// ФИЛЬТРЫ СПИСКА ПРАЙСОВ (решение админа 30.09.2026)
//
// Прайсов со временем становится много, а работают обычно с двумя-тремя. Оба фильтра
// отбирают В ЗАПРОСЕ (см. `ПрочитатьПрайсы`) и ничего не посылают агенту: это вид списка,
// а не состояние модели, и другому админу он не виден.
//
// ВЫДЕЛЕНИЕ, ПОПАВШЕЕ ПОД ФИЛЬТР, СНИМАЕТСЯ САМО — этим занимается `ВосстановитьВыделение`,
// которому всё равно, почему прайса не стало в списке: уничтожили его или скрыли. Оставить
// выделение на невидимой строке значило бы держать кнопки живыми для того, чего на экране
// нет.
// ======================================================================================

&НаКлиенте
Процедура ФильтрСтатусПриИзменении(Элемент)

	ОбновитьВсё();

КонецПроцедуры


&НаКлиенте
Процедура ФильтрБезУстаревшихПриИзменении(Элемент)

	ОбновитьВсё();

КонецПроцедуры


// ======================================================================================
// СЧЁТЧИК ОЖИДАНИЯ
//
// Колесико загорается сразу (см. `ОтправитьКоманду`), но само по себе оно не отвечает на
// вопрос, который возникает через полминуты: «оно вообще идёт или зависло?». Отвечает
// время: растущий счётчик видно, а замерший — тем более.
//
// Считается НА КЛИЕНТЕ И БЕЗ ОБРАЩЕНИЙ К СЕРВЕРУ. Сервер один раз сказал, сколько уже
// прошло (`СекундОжидания`), клиент привязал это к своим часам (`МоментОжидания`) и
// дальше тикает сам. Иначе секундный счётчик означал бы вызов сервера раз в секунду —
// ровно то, от чего бережёт пятисекундный таймер, читающий одно число.
// ======================================================================================

&НаКлиенте
Процедура ЗапуститьСчётчикОжидания()

	Если ПустаяСтрока(ОсноваОжидания) Тогда
		// Ждать нечего: гасим счётчик, иначе он тикал бы вхолостую до закрытия формы.
		ОтключитьОбработчикОжидания("ПоСчётчикуОжидания");
		СтрокаОжидания = "";
		Возврат;
	КонецЕсли;

	// НАДПИСЬ БЕЗ КОМАНДЫ — БЕЗ СЧЁТЧИКА. Единственный такой случай — «Агент не отвечает»,
	// когда ничего не ждёт: считать нечего, а счётчик от нуля показывал бы время с
	// последнего обновления формы, число без смысла.
	//
	// Опознаём по самому тексту, а не по замку: замок при молчащем агенте как раз
	// СНИМАЕТСЯ, а счётчик в этот момент нужен сильнее всего — он показывает, сколько
	// команда уже лежит.
	Если ОсноваОжидания = ТекстАгентМолчит() Тогда
		ОтключитьОбработчикОжидания("ПоСчётчикуОжидания");
		СтрокаОжидания = ОсноваОжидания;
		Возврат;
	КонецЕсли;

	МоментОжидания = ТекущаяДата() - СекундОжидания;
	ОбновитьСтрокуОжидания();

	// Повторное подключение с тем же именем просто переставляет период — проверять,
	// подключён ли он уже, незачем.
	ПодключитьОбработчикОжидания("ПоСчётчикуОжидания", 1);

КонецПроцедуры


&НаКлиенте
Процедура ПоСчётчикуОжидания()

	Если ПустаяСтрока(ОсноваОжидания) Тогда
		ОтключитьОбработчикОжидания("ПоСчётчикуОжидания");
		Возврат;
	КонецЕсли;

	ОбновитьСтрокуОжидания();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьСтрокуОжидания()

	СтрокаОжидания = ОсноваОжидания + " " + ФорматОжидания(ТекущаяДата() - МоментОжидания);

КонецПроцедуры


// Формат задан админом 30.09.2026: меньше минуты — только секунды, меньше часа —
// минуты и секунды, дальше спереди дописываются часы. Ведущие нули ставятся ТОЛЬКО у
// младших разрядов («1:02:05»), потому что «01:02:05» читается как длительность записи, а
// не как счётчик, и лишняя цифра дёргает глаз на каждом такте.
&НаКлиенте
Функция ФорматОжидания(Секунд)

	Всего = ?(Секунд < 0, 0, Цел(Секунд));

	Часы    = Цел(Всего / 3600);
	Минуты  = Цел((Всего - Часы * 3600) / 60);
	Остаток = Всего - Часы * 3600 - Минуты * 60;

	Если Часы > 0 Тогда
		Возврат Формат(Часы, "ЧГ=0") + ":" + ДваЗнака(Минуты) + ":" + ДваЗнака(Остаток);
	ИначеЕсли Минуты > 0 Тогда
		Возврат Формат(Минуты, "ЧГ=0") + ":" + ДваЗнака(Остаток);
	КонецЕсли;

	// Под минуту — «42 с». Без буквы одинокое число читается как номер, а не как время.
	Возврат Формат(Остаток, "ЧГ=0") + " с";

КонецФункции


// Ведущий ноль приписываем сами, а не форматной строкой: у `Формат` за это отвечает
// сочетание «ЧЦ=2; ЧВН=», и достаточно ошибиться в одном символе, чтобы вместо «05»
// вышло «5» или пусто — а проверяется это только глазами в работающей форме.
// Текст «ждать некого» — ОДНОЙ функцией на двух читателей: его ставит сервер, а клиент по
// нему же узнаёт, что счётчик не нужен. Две одинаковые строки в разных местах однажды
// разойдутся на пробел, и счётчик тихо появится там, где считать нечего.
&НаКлиентеНаСервереБезКонтекста
Функция ТекстАгентМолчит()

	Возврат "Агент не отвечает";

КонецФункции


&НаКлиенте
Функция ДваЗнака(Значение)

	Текст = Формат(Значение, "ЧГ=0");
	Возврат ?(СтрДлина(Текст) < 2, "0" + Текст, Текст);

КонецФункции


// Версия состояния читается БЕЗ КОНТЕКСТА: вызов не тащит на сервер и обратно данные
// формы. Таймер срабатывает каждые пять секунд, и это единственное, что он делает в
// покое, — платить за него передачей таблиц незачем.
//
// ЗАОДНО ОТМЕЧАЕМСЯ ЖИВЫМИ. Агент опрашивает очередь раз в пять секунд, пока идёт работа,
// и раз в ТРИДЦАТЬ в простое. Простоем он считает пять минут без команд — а значит первое
// нажатие после паузы ждало до полуминуты, и это было главным источником «нажал, и ничего
// не происходит» (разбор 30.09.2026). Отметка говорит агенту, что форма открыта, и он
// держит быстрый темп, пока она открыта.
//
// Отметка ставится в ТОМ ЖЕ вызове, что и чтение версии: отдельный вызов раз в пять секунд
// удвоил бы обращения к серверу ради одного булева признака.
&НаСервереБезКонтекста
Функция ПрочитатьВерсию()

	ОтметитьВизуалЖивым();
	Возврат Константы.ии_МодельАгентаВерсияСостояния.Получить();

КонецФункции


// Метка «визуал жив» — время, ДО которого форму считаем открытой. Живёт минуту и
// продлевается таймером формы, поэтому закрытую форму агент перестаёт учитывать сам,
// без события «форма закрылась», которого 1С и не обещает: сеанс может оборваться.
//
// ЗАПИСЫВАЕМ НЕ КАЖДЫЙ ТИК. Константа — это запись в базу с блокировкой, а тиков
// двенадцать в минуту на каждую открытую форму. Продлеваем, только когда до конца метки
// осталось меньше половины срока: записей становится две в минуту вместо двенадцати, а
// разницы в поведении нет.
// Молчит ли агент. Метку ставит он сам, опрашивая очередь (`ОтметитьАгентаЖивым` в
// agent-commands.bsl), и живёт она две минуты.
//
// НЕТ КОНСТАНТЫ — НЕТ И ОБВИНЕНИЯ: отсутствие метки значит «не знаем», а не «агент мёртв».
// Пока BSL не выложен, форма обязана вести себя как раньше, а не пугать надписью на ровном
// месте.
// Проверку держит ОБЩИЙ МОДУЛЬ, а не форма: её же спрашивает постановка команды, решая,
// снимать ли замок. Разойдись два порога, вышло бы худшее из возможного — форма пишет
// «агент не отвечает», а кнопка на то же самое отвечает «ждём агента».
&НаСервереБезКонтекста
Функция АгентНеОтвечает()

	Возврат ии_РаботаСМодельюИИАгнета.АгентМолчит();

КонецФункции


&НаСервереБезКонтекста
Процедура ОтметитьВизуалЖивым()

	Попытка
		Сейчас = ТекущаяДата();
		Если Константы.ии_МодельВизуалАктивенДо.Получить() - Сейчас < 30 Тогда
			Константы.ии_МодельВизуалАктивенДо.Установить(Сейчас + 60);
		КонецЕсли;
	Исключение
		// Константы нет — работаем как раньше, по тридцатисекундному простою. Ронять из-за
		// этого форму нельзя: она открывается и без ускорения.
		ЗаписьЖурналаРегистрации("ии.МодельФорма", УровеньЖурналаРегистрации.Предупреждение,
			, , "Не удалось отметить визуал живым: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры


&НаСервере
Процедура ПрочитатьСостояние()

	ТекущаяВерсия = ПрочитатьВерсию();

	ПрочитатьПрайсы();
	ПрочитатьЗадачи();
	ОбновитьПанельОписания();

КонецПроцедуры


&НаСервере
Процедура ПрочитатьПрайсы()

	Прайсы.Очистить();

	// ФИЛЬТРЫ ОТБИРАЮТ В ЗАПРОСЕ, а не прячут строки после чтения: список прайсов читается
	// на каждом обновлении, то есть раз в пять секунд, и таскать из базы то, что тут же
	// выбрасывается, незачем.
	//
	// Пустой `ФильтрСтатус` — «все». Сравнение по равенству: статус приходит из модели
	// строкой, и подстрочное сравнение спутало бы «обработан» с «частично обработан».
	ОтборСтатуса = ?(ПустаяСтрока(ФильтрСтатус), "ИСТИНА", "Т.Статус = &Статус");
	ОтборУстаревших = ?(ФильтрБезУстаревших, " И НЕ Т.ЕстьБолееСвежий", "");

	// СИГНАТУРА ЧИТАЕТСЯ В ЭТОМ ЗАПРОСЕ, а не только пишется в зеркало: по ней открывается
	// выбор листов двойным щелчком по имени файла. Забыв её здесь, получаем колонку, которая
	// есть и всегда пуста, — и двойной щелчок честно отвечает «формат не записан» по прайсу,
	// у которого он записан (02.10.2026).
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Статус", ФильтрСтатус);
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Т.Идентификатор КАК Идентификатор,
		|	Т.Файл КАК Файл,
		|	Т.Поставщик КАК Поставщик,
		|	Т.Сигнатура КАК Сигнатура,
		|	Т.Статус КАК Статус,
		|	Т.Готов КАК Готов,
		|	Т.ЕстьБолееСвежий КАК ЕстьБолееСвежий,
		|	Т.НомерБолееСвежего КАК НомерБолееСвежего,
		|	Т.ЗанятКем КАК ЗанятКем,
		|	Т.ЗанятДо КАК ЗанятДо,
		|	Т.Принят КАК Принят,
		|	Т.КурсЕвро КАК КурсЕвро
		|ИЗ
		|	РегистрСведений.ии_МодельПрайсы КАК Т
		|ГДЕ
		|	%%Отбор%%
		|
		|УПОРЯДОЧИТЬ ПО
		|	Идентификатор";

	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "%%Отбор%%", ОтборСтатуса + ОтборУстаревших);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		// Переменная НЕ называется `Строка`: это имя встроенной функции, и она же
		// вызывается ниже. Имя `Задачи` по той же причине занято — так называется
		// глобальная коллекция объектов метаданных.
		НоваяСтрока = Прайсы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Пометка = ?(Выборка.ЕстьБолееСвежий,
			"устарел, см. №" + Формат(Выборка.НомерБолееСвежего, "ЧГ=0"),
			?(Выборка.Готов, "готов к закрытию", ""));
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьЗадачи()

	ЗадачиПрайса.Очистить();
	СтрокаЗахвата = "";
	// ТЕКСТ И ТАЙМЕР ЖИВУТ ПОРОЗНЬ. `ОсноваОжидания` — что именно делает агент, считается
	// сервером раз в обновление; `СтрокаОжидания` собирается на клиенте каждую секунду из
	// основы и прошедшего времени. Иначе тикающий счётчик означал бы обращение к серверу
	// раз в секунду — ровно то, чего пятисекундный таймер и избегает (см. ПрочитатьВерсию).
	ОсноваОжидания = "";
	СекундОжидания = 0;
	СтрокаОжидания = "";
	ПрайсЗанятЧужим = Ложь;
	ПрайсЖдётАгента = Ложь;

	Если ВыбранныйПрайс = 0 Тогда
		Возврат;
	КонецЕсли;

	// --- захват: чей и до какого времени (§4.2 спеки)
	Захват = РегистрыСведений.ии_МодельПрайсы.СоздатьМенеджерЗаписи();
	Захват.Идентификатор = ВыбранныйПрайс;
	Захват.Прочитать();

	Если Захват.Выбран() И НЕ ПустаяСтрока(Захват.ЗанятКем) Тогда
		// Свой захват работать НЕ мешает: он для того и взят. Сравнение по имени
		// пользователя 1С — агент присылает его же (решение Ф4).
		ПрайсЗанятЧужим = (Захват.ЗанятКем <> ИмяПользователя());
		Если ПрайсЗанятЧужим Тогда
			СтрокаЗахвата = "Прайс занят: " + Захват.ЗанятКем
				+ ?(ЗначениеЗаполнено(Захват.ЗанятДо),
					", до " + Формат(Захват.ЗанятДо, "ДФ=HH:mm"), "");
		КонецЕсли;
	КонецЕсли;

	// --- что уже отправлено агенту и ещё не закрыто (§4.5 спеки)
	//
	// ОДНИМ ЗАПРОСОМ на весь прайс, а не по запросу на строку: колонка ожидания
	// пересчитывается при каждом обновлении, а обновлений — раз в пять секунд.
	Ждущие = Новый Соответствие;
	ЖдущихВсего = 0;
	НеВзятыхАгентом = 0;
	ПоследнийВид = "";
	ПоследняяЗадача = 0;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Прайс", ВыбранныйПрайс);
	Запрос.УстановитьПараметр("Ждёт", "ждёт");
	Запрос.УстановитьПараметр("Принята", "принята");
	Запрос.Текст =
		"ВЫБРАТЬ
		|	К.Задача КАК Задача,
		|	К.Вид КАК Вид,
		|	К.Создана КАК Создана,
		|	К.Состояние КАК Состояние
		|ИЗ
		|	РегистрСведений.ии_МодельКоманды КАК К
		|ГДЕ
		|	К.Прайс = &Прайс
		|	И (К.Состояние = &Ждёт ИЛИ К.Состояние = &Принята)";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Ждущие.Вставить(Выборка.Задача, Истина);
		ЖдущихВсего = ЖдущихВсего + 1;
		ПоследнийВид = СокрЛП(Выборка.Вид);
		ПоследняяЗадача = Выборка.Задача;

		// СКОЛЬКО ЖДЁМ — СЧИТАЕТ СЕРВЕР, и это не формальность. `Создана` штампует сервер
		// 1С, а таймер тикает на рабочей станции: сравнив одно с другим напрямую, мы
		// показали бы расхождение часов вместо времени ожидания — вплоть до
		// отрицательного. Поэтому на клиент уезжает ЧИСЛО секунд, а он привязывает его к
		// своим часам.
		//
		// Берём САМУЮ СТАРУЮ из ждущих: админ ждёт, пока разберут очередь целиком, а не
		// последнюю попавшую в неё команду.
		Прошло = ТекущаяДата() - Выборка.Создана;
		Если Прошло > СекундОжидания Тогда
			СекундОжидания = Прошло;
		КонецЕсли;

		// «Ждёт» и «принята» — РАЗНЫЕ вещи, когда агент молчит. Принятую он взял и,
		// скорее всего, выполняет: длинная задача идёт минутами, и опрос очереди на это
		// время прекращается — метка жизни протухает, а агент цел. Не взятая же не
		// взята никем, и вот это уже повод сказать, что ждать некого.
		Если СокрЛП(Выборка.Состояние) = "ждёт" Тогда
			НеВзятыхАгентом = НеВзятыхАгентом + 1;
		КонецЕсли;

		// ЛЮБАЯ незакрытая команда по прайсу запирает ВЕСЬ прайс, а не только свою
		// задачу. Причина не в осторожности, а в правиле «кто первый» (§7 модели):
		// команды, попавшие агенту в один оборот по одному прайсу, разбираются по
		// очереди, и вторая получает отказ «прайс занят». Оставив кнопки живыми, мы
		// приглашали бы админа нажать ещё раз и получить непонятный отказ.
		ПрайсЖдётАгента = Истина;
	КонецЦикла;

	// НАДПИСЬ ОБЯЗАТЕЛЬНА, а не украшение. Удаление задачи и уничтожение прайса не дают
	// видимого следа до прихода снимка: строка остаётся на месте, и нажатие выглядит
	// пропавшим. Погашенных кнопок мало — они объясняют «нельзя», но не «почему».
	//
	// Текст считается ИЗ РЕГИСТРА КОМАНД, а не запоминается при нажатии: тогда он
	// переживает переключение прайса, перезаход в форму и любой сбой — и гаснет сам,
	// когда команда закрылась, без отдельной уборки.
	Если ЖдущихВсего = 1 И ПоследнийВид = "изменить листы формата" Тогда
		// Формулировка задана админом 02.10.2026. Она не подчиняется общему шаблону
		// «Идёт <действие> №N» намеренно: выбор листов относится к ФОРМАТУ, а не к
		// задаче, и номер в такой строке читался бы как номер формата. Адресуемся
		// ПОСТАВЩИКОМ: формат у него обычно один, и «прайс Стройиндустрии» админ узнаёт
		// без сверки с номером в списке.
		ОсноваОжидания = "Обновляю список листов прайса поставщика "
			+ ИмяПоставщикаПрайса();
	ИначеЕсли ЖдущихВсего = 1 И ПоследнийВид = "изменить бренды формата" Тогда
		// Та же причина, что у листов: решение относится к ФОРМАТУ, и номер в такой строке
		// читался бы как номер формата. Адресуемся поставщиком.
		ОсноваОжидания = "Обновляю бренды прайса поставщика " + ИмяПоставщикаПрайса();
	ИначеЕсли ЖдущихВсего = 1 Тогда
		ОсноваОжидания = "Идёт " + НазваниеДействия(ПоследнийВид)
			+ ?(ПоследняяЗадача = 0, "",
				" №" + Формат(ПоследняяЗадача, "ЧГ=0")) + "…";
	ИначеЕсли ЖдущихВсего > 1 Тогда
		ОсноваОжидания = "Агент разбирает команды: " + Формат(ЖдущихВсего, "ЧГ=0") + "…";
	КонецЕсли;

	// ПРИЧИНУ МОЛЧАНИЯ НАЗЫВАЕМ ПРЯМО (решение админа 30.09.2026).
	//
	// 30.09.2026 бот оказался не запущен: команда лежала в очереди, колесико крутилось,
	// счётчик честно считал — и по форме это выглядело точно так же, как работающий
	// агент, которому нужно время. Отличить одно от другого было неоткуда, и разбор
	// занял полчаса.
	//
	// Судим ТОЛЬКО по НЕ ВЗЯТЫМ командам: принятую агент взял, и его молчание объясняется
	// работой — длинная задача идёт минутами, опрос очереди на это время прекращается, и
	// метка жизни протухает у совершенно здорового агента. Обвинить его в такой момент
	// значило бы приучить админа не верить предупреждению.
	Если АгентНеОтвечает() Тогда
		Если НеВзятыхАгентом > 0 Тогда
			ОсноваОжидания = "Агент не отвечает — команду никто не взял";

			// ЗАМОК СНИМАЕМ, КОГДА ЗАЩИЩАТЬ НЕЧЕГО (решение админа 30.09.2026). Кнопки
			// гаснут ради секунд между нажатием и тем, как агент возьмёт команду. Агента
			// нет — нет и этих секунд: форма осталась бы запертой до его подъёма, а
			// человеку в это время может понадобиться и другое действие.
			//
			// Повторное нажатие не отскочит: постановка команды снимет зависшую и
			// поставит новую — она НЕ ВЗЯТА, подменять нечего.
			//
			// Только когда все команды не взяты. Есть «принятая» — агент её взял, и она
			// может выполняться прямо сейчас: замок остаётся.
			Если НеВзятыхАгентом = ЖдущихВсего Тогда
				ПрайсЖдётАгента = Ложь;
			КонецЕсли;
		ИначеЕсли ЖдущихВсего = 0 Тогда
			// Ждать нечего, но сказать стоит: нажимать кнопки сейчас бессмысленно.
			ОсноваОжидания = ТекстАгентМолчит();
		КонецЕсли;
	КонецЕсли;

	// ВИДИМУЮ СТРОКУ ЗАПОЛНЯЕТ И СЕРВЕР — счётчик лишь дописывается к ней на клиенте.
	//
	// Иначе строка исчезает во всех путях, где задачи читает сервер, а клиентской сборки
	// нет: открытие формы (`ПриСозданииНаСервере`) и выбор прайса в списке. Ровно это и
	// случилось 30.09.2026 — надпись пропала совсем. Клиентские вызовы теперь добавлены,
	// но полагаться только на них нельзя: появится третий путь, и надпись снова тихо
	// пропадёт. Хуже надписи без счётчика только её отсутствие.
	СтрокаОжидания = ОсноваОжидания;

	// --- сами задачи
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Прайс", ВыбранныйПрайс);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Идентификатор КАК Идентификатор,
		|	Т.Прайс КАК Прайс,
		|	Т.Вид КАК Вид,
		|	Т.Порядок КАК Порядок,
		|	Т.Предмет КАК Предмет,
		|	Т.Адрес КАК Адрес,
		|	Т.Статус КАК Статус,
		|	Т.Описание КАК Описание,
		|	Т.Результат КАК Результат,
		|	Т.Выполнена КАК Выполнена
		|ИЗ
		|	РегистрСведений.ии_МодельЗадачи КАК Т
		|ГДЕ
		|	Т.Прайс = &Прайс
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	Идентификатор";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЗадачиПрайса.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Ожидает = ?(Ждущие.Получить(Выборка.Идентификатор) = Неопределено,
			"", "…");
	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ОбновитьПанельОписания()

	// ПРАВКУ АДМИНА ОБНОВЛЕНИЕ НЕ ТРОГАЕТ. Она живёт только до исполнения (§3.3 модели) и
	// восстановить её будет неоткуда: зеркало пишет агент. Затереть набранный текст —
	// самый обидный из возможных отказов.
	Если ОписаниеИзменено Тогда
		Возврат;
	КонецЕсли;

	ОписаниеЗадачи = "";
	РезультатЗадачи = "";

	Если ВыбраннаяЗадача = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Задача Из ЗадачиПрайса Цикл
		Если Задача.Идентификатор = ВыбраннаяЗадача Тогда
			ОписаниеЗадачи = Задача.Описание;
			РезультатЗадачи = Задача.Результат;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура ВосстановитьВыделение(НомерПрайса, НомерЗадачи)

	// Выделение восстанавливается ПО ИДЕНТИФИКАТОРУ, а не по номеру строки: иначе при
	// удалении прайса выше по списку выделение перепрыгнуло бы на соседа, и админ
	// выполнил бы задачу не того прайса.
	НайденПрайс = Ложь;

	Для Каждого Прайс Из Прайсы Цикл
		Если Прайс.Идентификатор = НомерПрайса Тогда
			Элементы.Прайсы.ТекущаяСтрока = Прайс.ПолучитьИдентификатор();
			НайденПрайс = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// ОБЪЕКТ МОГ ИСЧЕЗНУТЬ — его только что уничтожили, свои или из Telegram. Оставить
	// `ВыбранныйПрайс` указывать на небытие значит держать кнопки живыми для того, чего
	// нет: следующее нажатие уедет агенту и вернётся отказом «прайс не найден».
	Если НЕ НайденПрайс Тогда
		ВыбранныйПрайс = 0;
		ВыбраннаяЗадача = 0;
		СтатусПрайсаВыбор = "";
		СтатусЗадачиВыбор = "";
		ОписаниеЗадачи = "";
		РезультатЗадачи = "";
		ОписаниеИзменено = Ложь;
		ЗадачиПрайса.Очистить();
		Возврат;
	КонецЕсли;

	НайденаЗадача = Ложь;

	Для Каждого Задача Из ЗадачиПрайса Цикл
		Если Задача.Идентификатор = НомерЗадачи Тогда
			Элементы.ЗадачиПрайса.ТекущаяСтрока = Задача.ПолучитьИдентификатор();
			НайденаЗадача = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ НайденаЗадача Тогда
		ВыбраннаяЗадача = 0;
		СтатусЗадачиВыбор = "";
		ОписаниеЗадачи = "";
		РезультатЗадачи = "";
		// Правки больше нет к чему применять: задача, которую правили, исчезла.
		ОписаниеИзменено = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВыделениеИДоступность

// Двойной щелчок по колонке «Поставщик» открывает карточку справочника.
//
// Колонка — ССЫЛКА, а не строка (решение админа 24.09.2026), и это единственное, что
// делает такой переход возможным: к карточке привязываются юрлица, и открывать её из
// таблицы прайсов удобнее, чем искать справочник в меню.
//
// По остальным колонкам двойной щелчок не делает НИЧЕГО: таблица только для просмотра,
// и открывать по нему форму задачи или прайса было бы сюрпризом — для работы есть кнопки.
// Открыть форму выбора листов для формата ТЕКУЩЕГО прайса.
//
// Сигнатура приходит в снимке вместе с прайсом (поле `Сигнатура`): искать формат по имени
// файла нельзя — имена меняются каждый месяц, а формат тот же.
&НаКлиенте
Процедура ОткрытьВыборЛистов()

	Текущий = Элементы.Прайсы.ТекущиеДанные;
	Если Текущий = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Текущий.Сигнатура) Тогда
		// Формат неизвестен — так бывает у прайсов, принятых до появления этого поля.
		// Молчать нельзя: двойной щелчок выглядел бы сломанным.
		ПоказатьПредупреждение(,
			"У этого прайса не записан формат — выбирать листы нечему. "
			+ "Пришлите файл заново: формат определяется при приёме.");
		Возврат;
	КонецЕсли;

	// ПЕРЕМЕННАЯ НЕ НАЗЫВАЕТСЯ `Параметры` (правка админа 02.10.2026): это ИМЯ СВОЙСТВА
	// самой формы — коллекции её параметров, — и присваивание ему роняло процедуру. Та же
	// ловушка, что с `Задачи` и `Строка`: имя занято платформой, а ошибка выглядит чужой.
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Сигнатура", Текущий.Сигнатура);
	ПараметрыОткрытия.Вставить("Файл", Текущий.Файл);
	// Номер прайса — чтобы команда выбора листов знала, ГДЕ показывать ожидание: замок и
	// надпись живут на форме прайсов, а не на форме листов (решение админа 02.10.2026).
	ПараметрыОткрытия.Вставить("Прайс", Текущий.Идентификатор);

	// ЖДЁМ ЗАКРЫТИЯ ОПИСАНИЕМ ОПОВЕЩЕНИЯ, а не событием формы `ОбработкаОповещения`
	// (бой 02.10.2026). Разница не в красоте: обработчик события формы мало написать в
	// модуле — его нужно ПРИВЯЗАТЬ в конфигураторе, и незавязанный просто не вызывается.
	// Ровно это и вышло: замок с надписью появлялись не сразу, а на очередном такте
	// таймера, то есть через несколько секунд, и выглядело это как медленный агент.
	// Описание оповещения передаётся КОДОМ — забыть в конфигураторе нечего.
	//
	// Уникальность окна — по САМОЙ СИГНАТУРЕ: второй щелчок по прайсу того же формата
	// поднимает уже открытое окно, а не плодит второе с теми же листами.
	ОткрытьФорму("РегистрСведений.ии_МодельЛистыПрайсов.Форма.ФормаВыбораЛистов",
		ПараметрыОткрытия, ЭтаФорма, Текущий.Сигнатура, , ,
		Новый ОписаниеОповещения("ПослеВыбораЛистов", ЭтаФорма));

КонецПроцедуры


// ВЫБОР БРЕНДОВ — КНОПКОЙ, а не двойным щелчком (решение админа 03.10.2026): щелчок по
// имени файла уже занят листами, а два разных окна на одном жесте различать нечем.
//
// Зачем бренды вообще: выбор листов бесполезен прайсу, у которого лист один. У «Остатков»
// одна вкладка на 1286 строк и 23 бренда, и к разбору уходит ПЕРЕСЕЧЕНИЕ отмеченных листов
// и отмеченных брендов.
&НаКлиенте
Процедура ОткрытьВыборБрендов(Команда)

	Текущий = Элементы.Прайсы.ТекущиеДанные;
	Если Текущий = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Текущий.Сигнатура) Тогда
		ПоказатьПредупреждение(,
			"У этого прайса не записан формат — выбирать бренды нечему. "
			+ "Пришлите файл заново: формат определяется при приёме.");
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Сигнатура", Текущий.Сигнатура);
	ПараметрыОткрытия.Вставить("Файл", Текущий.Файл);
	ПараметрыОткрытия.Вставить("Прайс", Текущий.Идентификатор);
	// КУРС ЕВРО принадлежит ПРАЙСУ, поэтому и передаётся из его строки: форма показывает
	// текущий и даёт поправить. Ноль означает «не задан» — цены по валютным колонкам тогда
	// не считаются вовсе, потому что записать в 1С цифру по пустому курсу необратимо.
	ПараметрыОткрытия.Вставить("Курс", Текущий.КурсЕвро);

	// Уникальность окна — по сигнатуре С ПРИСТАВКОЙ: без неё окно брендов и окно листов
	// одного формата считались бы одним и тем же, и второе просто не открылось бы.
	//
	// Закрытия ждём тем же `ПослеВыбораЛистов`: он ничего не знает о том, что именно
	// закрылось, — только обновляет состояние, а это нужно одинаково в обоих случаях.
	ОткрытьФорму("РегистрСведений.ии_МодельБрендыПрайсов.Форма.ФормаВыбораБрендов",
		ПараметрыОткрытия, ЭтаФорма, "бренды:" + Текущий.Сигнатура, , ,
		Новый ОписаниеОповещения("ПослеВыбораЛистов", ЭтаФорма));

КонецПроцедуры


&НаКлиенте
Процедура ПрайсыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	// ВЫБОР ЛИСТОВ — двойным щелчком по ИМЕНИ ФАЙЛА (решение админа 02.10.2026). Место
	// выбрано не случайно: листы принадлежат формату, а формат админ опознаёт именно по
	// имени файла, которое перед ним и стоит.
	Если Поле = Элементы.ПрайсыФайл Тогда
		ОткрытьВыборЛистов();
		Возврат;
	КонецЕсли;

	Если Поле <> Элементы.ПрайсыПоставщик Тогда
		Возврат;
	КонецЕсли;

	Текущий = Элементы.Прайсы.ТекущиеДанные;
	Если Текущий = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Текущий.Поставщик) Тогда
		Возврат;
	КонецЕсли;

	// КОЛОНКА ОБЯЗАНА БЫТЬ ССЫЛКОЙ, и проверка здесь не перестраховка.
	//
	// `ЗаполнитьЗначенияСвойств` копирует по имени: объяви колонку реквизита формы
	// строкой — и ссылка молча превратится в своё текстовое представление. В таблице имя
	// при этом видно ПРАВИЛЬНО, поэтому ошибка выглядит как чужая: в `Key` уезжает текст,
	// платформа его игнорирует и открывает НОВЫЙ ПУСТОЙ элемент (бой 26.09.2026). Молчать
	// об этом нельзя — пустая карточка читается как потеря данных.
	Если ТипЗнч(Текущий.Поставщик) <> Тип("СправочникСсылка.ии_МодельПоставщики") Тогда
		ПоказатьПредупреждение(,
			"Колонка «Поставщик» в реквизите формы «Прайсы» объявлена не ссылкой, а "
			+ Строка(ТипЗнч(Текущий.Поставщик))
			+ ". Карточку открыть нечем: в параметр Key уходит текст, и форма открылась бы "
			+ "пустой. Исправьте тип колонки на СправочникСсылка.ии_МодельПоставщики.");
		Возврат;
	КонецЕсли;

	// ОткрытьФорму, а не ПоказатьЗначение (решение админа 26.09.2026).
	//
	// `ПоказатьЗначение` открывает форму ЗНАЧЕНИЯ — по сути просмотр, и с ним админ не
	// получает того, ради чего в колонку и поставили ссылку: правки наименования и
	// таблицы юрлиц. `ОткрытьФорму` с ключом значения открывает обычную форму элемента,
	// со всеми её кнопками и правами.
	//
	// Владелец — `ЭтаФорма` (правка админа: на этой версии платформы `ЭтотОбъект` в
	// клиентском контексте формы не годится). Уникальность окна — САМА ССЫЛКА в четвёртом
	// параметре: второй щелчок по той же строке поднимает уже открытую карточку, а не
	// плодит окна. Флага «уникальность» отдельным параметром здесь нет — попытка передать
	// его восьмым аргументом была ошибкой.
	ПараметрыОткрытия = Новый Структура("Key", Текущий.Поставщик);
	ОткрытьФорму("Справочник.ии_МодельПоставщики.ФормаОбъекта", ПараметрыОткрытия,
		ЭтаФорма, Текущий.Поставщик);

КонецПроцедуры


&НаКлиенте
Процедура ПрайсыПриАктивизацииСтроки(Элемент)
	
	Текущий = Элементы.Прайсы.ТекущиеДанные;
	НовыйПрайс = ?(Текущий = Неопределено, 0, Текущий.Идентификатор);

	Если НовыйПрайс = ВыбранныйПрайс Тогда
		Возврат;
	КонецЕсли;

	// Сменили прайс — незавершённая правка описания теряется. Предупреждаем до того, как
	// она пропала, а не после.
	Если ОписаниеИзменено Тогда
		ОписаниеИзменено = Ложь;
		ПоказатьПредупреждение(, "Правка описания не отправлена и потеряна.");
	КонецЕсли;

	ВыбранныйПрайс = НовыйПрайс;
	ВыбраннаяЗадача = 0;
	СтатусПрайсаВыбор = ?(Текущий = Неопределено, "", Текущий.Статус);
	ПрочитатьЗадачи();
	// У нового прайса своё ожидание: у одного команда висит, у другого нет. Счётчик
	// обязан перезапуститься, иначе он досчитывал бы чужое время. И снова ДО
	// `ОбновитьДоступность` — она решает, показывать ли поле.
	ЗапуститьСчётчикОжидания();
	ОбновитьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадачиПрайсаПриАктивизацииСтроки(Элемент)
	
	Текущий = Элементы.ЗадачиПрайса.ТекущиеДанные;
	НоваяЗадача = ?(Текущий = Неопределено, 0, Текущий.Идентификатор);

	Если НоваяЗадача = ВыбраннаяЗадача Тогда
		Возврат;
	КонецЕсли;

	Если ОписаниеИзменено Тогда
		ОписаниеИзменено = Ложь;
		ПоказатьПредупреждение(, "Правка описания не отправлена и потеряна.");
	КонецЕсли;

	ВыбраннаяЗадача = НоваяЗадача;
	СтатусЗадачиВыбор = ?(Текущий = Неопределено, "", Текущий.Статус);
	ОписаниеЗадачи = ?(Текущий = Неопределено, "", Текущий.Описание);
	РезультатЗадачи = ?(Текущий = Неопределено, "", Текущий.Результат);
	ОбновитьДоступность();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеЗадачиПриИзменении(Элемент)
	
	ОписаниеИзменено = Истина;		
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьДоступность()

	ЕстьПрайс  = (ВыбранныйПрайс <> 0);
	ЕстьЗадача = (ВыбраннаяЗадача <> 0);

	// ПРАЙС ЗАНЯТ ЧУЖИМ — гасим ВСЁ по нему и по его задачам (решение Ф8). Захват мог
	// истечь в промежутке между обновлениями, и тогда форма до пяти секунд запрещает то,
	// что уже разрешено. Это честнее обратного: кнопка активна, а через полминуты
	// приходит отказ, — и лечится одним нажатием «Обновить».
	// `ПрайсЖдётАгента` входит в ОБА условия: незакрытая команда запирает и прайс, и его
	// задачи. Раньше задачи оставались живыми при уничтожении прайса — можно было нажать
	// «Выполнить» по задаче прайса, которого через секунду не станет.
	МожноПрайс  = ЕстьПрайс И НЕ ПрайсЗанятЧужим И НЕ ПрайсЖдётАгента;
	МожноЗадачу = ЕстьЗадача И НЕ ПрайсЗанятЧужим И НЕ ПрайсЖдётАгента;

	Элементы.ОбновитьЗадачи.Доступность    = МожноПрайс;
	// Выбор брендов доступен по тем же правилам, что и прочие действия по прайсу: пока по
	// нему идёт команда, второе нажатие получило бы отказ «прайс занят».
	Элементы.ВыборБрендов.Доступность      = МожноПрайс;
	Элементы.УничтожитьПрайс.Доступность   = МожноПрайс;
	Элементы.СтатусПрайсаВыбор.Доступность = МожноПрайс;

	// ВЫПОЛНЕННУЮ ЗАДАЧУ ПОВТОРНО НЕ ЗАПУСКАЮТ. Кнопка не просто бесполезна — выполнение
	// пишет в 1С, и второй прогон переписал бы то, что уже записано, без нужды.
	//
	// «Частично обработана» повторный запуск РАЗРЕШАЕТ, и это не оплошность: частичный
	// исход штатный и означает, что часть работы осталась, — её и доделывают повторным
	// запуском. Передумали по выполненной — верните статус «к обработке» списком статусов,
	// это и есть предусмотренный выход.
	// СУДИМ ПО ВСЕМУ ВЫДЕЛЕНИЮ, а не по активной строке (решение админа 03.10.2026).
	// Выделив пять задач, из которых активной оказалась выполненная, админ получил бы
	// погашенную кнопку при четырёх живых задачах — и решил бы, что пачка не работает.
	// Кнопка гаснет, только когда выполнять нечего ни по одной отмеченной.
	ЗадачаЗакрыта = (ОтмеченныеЗадачи().Номера.Количество() = 0);

	Элементы.ВыполнитьЗадачу.Доступность   = МожноЗадачу И НЕ ЗадачаЗакрыта;
	Элементы.УдалитьЗадачу.Доступность     = МожноЗадачу;
	Элементы.СтатусЗадачиВыбор.Доступность = МожноЗадачу;
	// Пока задача ждёт агента, менять по ней нельзя ничего — включая описание: админ
	// увидел бы один результат на два нажатия и решил бы, что одно пропало.
	Элементы.ОписаниеЗадачи.ТолькоПросмотр = НЕ МожноЗадачу;

	Элементы.СтрокаЗахвата.Видимость  = НЕ ПустаяСтрока(СтрокаЗахвата);
	Элементы.СтрокаОжидания.Видимость = НЕ ПустаяСтрока(СтрокаОжидания);

КонецПроцедуры

// Статус выделенной задачи. Пустая строка — задача не выделена либо её уже нет в списке.
//
// Берётся ИЗ ТАБЛИЦЫ ФОРМЫ, а не из реквизита `СтатусЗадачиВыбор`: тот держит значение,
// выбранное админом в выпадающем списке, и после отправки команды опережает зеркало.
// Решение «можно ли выполнять» должно опираться на то, что подтвердил агент.
&НаКлиенте
Функция СтатусВыбраннойЗадачи()

	Если ВыбраннаяЗадача = 0 Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Задача Из ЗадачиПрайса Цикл
		Если Задача.Идентификатор = ВыбраннаяЗадача Тогда
			Возврат СокрЛП(Задача.Статус);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции


// Имя поставщика выбранного прайса — для надписи ожидания.
//
// Берётся ИЗ УЖЕ ПРОЧИТАННОЙ таблицы формы, а не отдельным запросом: `ПрочитатьПрайсы`
// отработала строкой выше (`ПрочитатьСостояние`), и второй запрос к базе раз в пять секунд
// ради одного имени не нужен.
//
// Пусто бывает: прайс мог уйти под фильтр или исчезнуть между обновлениями. Тогда
// адресуемся номером — надпись без адреса не говорит, по какому прайсу идёт работа.
&НаСервере
Функция ИмяПоставщикаПрайса()

	Для Каждого Прайс Из Прайсы Цикл
		Если Прайс.Идентификатор = ВыбранныйПрайс Тогда
			Если ЗначениеЗаполнено(Прайс.Поставщик) Тогда
				Возврат Строка(Прайс.Поставщик);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат "№" + Формат(ВыбранныйПрайс, "ЧГ=0");

КонецФункции


// Вид команды словами, для надписи об ожидании.
&НаСервере
Функция НазваниеДействия(Вид)

	Если Вид = "выполнить задачу" Тогда
		Возврат "выполнение задачи";
	ИначеЕсли Вид = "удалить задачу" Тогда
		Возврат "удаление задачи";
	ИначеЕсли Вид = "сменить статус задачи" Тогда
		Возврат "смена статуса задачи";
	ИначеЕсли Вид = "сменить статус прайса" Тогда
		Возврат "смена статуса прайса";
	ИначеЕсли Вид = "пересобрать задачи" Тогда
		Возврат "пересборка задач";
	ИначеЕсли Вид = "уничтожить прайс" Тогда
		Возврат "уничтожение прайса";
	ИначеЕсли Вид = "изменить листы формата" Тогда
		Возврат "запись списка листов";
	ИначеЕсли Вид = "изменить бренды формата" Тогда
		Возврат "запись выбора брендов";
	КонецЕсли;

	// Вид, которого мы не знаем, тоже показываем: агент может выполнять команду, о
	// которой форма не осведомлена, и молчать об этом хуже, чем показать сырое имя.
	Возврат Вид;

КонецФункции

#КонецОбласти

#Область КомандыПоЗадаче

&НаКлиенте
Процедура ВыполнитьЗадачу(Команда)

	Отмеченные = ОтмеченныеЗадачи();
	Сколько = Отмеченные.Номера.Количество();

	Если Сколько = 0 Тогда
		Если Отмеченные.Закрытые > 0 Тогда
			// Молчать нельзя: кнопка нажата, а не произошло ничего.
			ПоказатьПредупреждение(,
				"Все отмеченные задачи уже выполнены. Чтобы выполнить заново, верните "
				+ "статус «к обработке» — повторный прогон пишет в 1С второй раз.");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// ОДНА ЗАДАЧА — КАК БЫЛО: ни вопроса, ни лишнего шага. Правка описания едет ВМЕСТЕ с
	// командой (§4.3 спеки), отдельной кнопки «Сохранить» нет: модель объединяет полезную
	// нагрузку при схлопывании команд по одному объекту, поэтому «поправил и тут же
	// нажал» не теряет ни правку, ни исполнение.
	Если Сколько = 1 И Отмеченные.Закрытые = 0 Тогда
		ОтправитьКоманду("выполнить задачу", ВыбранныйПрайс, Отмеченные.Номера[0],
			ДанныеСОписанием());
		Возврат;
	КонецЕсли;

	// ПАЧКУ ПОДТВЕРЖДАЕМ, и это не перестраховка. Выполнение пишет в 1С, выделяют
	// диапазоном (shift) и промахиваются на лишние строки, а отменить записанное нечем.
	// Для одной задачи вопроса по-прежнему нет: там промах стоит одной задачи.
	Текст = "Выполнить задач: " + Формат(Сколько, "ЧГ=0") + "?"
		+ ?(Отмеченные.Закрытые = 0, "",
			" (ещё " + Формат(Отмеченные.Закрытые, "ЧГ=0")
			+ " уже выполнены — их пропущу)")
		+ Символы.ПС + Символы.ПС
		+ "Агент выполнит их ПО ОЧЕРЕДИ и запишет изменения в 1С по каждой.";

	ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьОтмеченныеОтвет", ЭтаФорма,
		Отмеченные.Номера), Текст, РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет, "Выполнение задач");

КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьОтмеченныеОтвет(Ответ, Номера) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	// ПРАВКА ОПИСАНИЯ ЕДЕТ ТОЛЬКО СВОЕЙ ЗАДАЧЕ. Поле описания показывает АКТИВНУЮ строку,
	// и, отправив набранный текст всем отмеченным, мы затёрли бы описания остальных —
	// необратимо, потому что обратно зеркало пишет агент, а не форма.
	Итог = ПоставитьОтмеченныеНаСервере(Номера,
		?(ОписаниеИзменено, ВыбраннаяЗадача, 0),
		?(ОписаниеИзменено, ОписаниеЗадачи, ""));

	ОписаниеИзменено = Ложь;
	ОбновитьВсё();

	Если НЕ ПустаяСтрока(Итог) Тогда
		ПоказатьПредупреждение(, Итог);
	КонецЕсли;

КонецПроцедуры


// Задачи, по которым нажата кнопка: `Номера` — что отправляем, `Закрытые` — сколько
// отмеченных пропущено как уже выполненные.
//
// ПОРЯДОК БЕРЁМ ИЗ ТАБЛИЦЫ, а не из порядка выделения: платформа второго не обещает, а
// выполняться задачи будут по очереди — пусть в том порядке, в котором админ их видит
// (виды задач отсортированы спекой, а не алфавитом).
//
// ПУСТОЕ ВЫДЕЛЕНИЕ — ЭТО АКТИВНАЯ СТРОКА. Так код работает независимо от того, выставлен
// ли у таблицы режим выделения «несколько строк»: пока он одиночный, `ВыделенныеСтроки`
// пуста, и кнопка обязана вести себя как раньше, а не отказывать.
&НаКлиенте
Функция ОтмеченныеЗадачи()

	Результат = Новый Структура("Номера, Закрытые", Новый Массив, 0);

	Выделено = Новый Соответствие;
	Для Каждого Идентификатор Из Элементы.ЗадачиПрайса.ВыделенныеСтроки Цикл
		Выделено.Вставить(Идентификатор, Истина);
	КонецЦикла;

	Если Выделено.Количество() = 0 Тогда
		Если ВыбраннаяЗадача = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		Выделено.Вставить(Элементы.ЗадачиПрайса.ТекущаяСтрока, Истина);
	КонецЕсли;

	Для Каждого Задача Из ЗадачиПрайса Цикл
		Если Выделено.Получить(Задача.ПолучитьИдентификатор()) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// ВЫПОЛНЕННУЮ ПОВТОРНО НЕ ЗАПУСКАЕМ: прогон пишет в 1С, и второй переписал бы
		// то, что уже записано. В пачке такая строка попадается легко — выделяют
		// диапазоном. Пропускаем молча ЗДЕСЬ, но считаем: об этом сказано в вопросе.
		Если СокрЛП(Задача.Статус) = "выполнена" Тогда
			Результат.Закрытые = Результат.Закрытые + 1;
			Продолжить;
		КонецЕсли;

		Результат.Номера.Добавить(Задача.Идентификатор);
	КонецЦикла;

	Возврат Результат;

КонецФункции


&НаСервере
Функция ПоставитьОтмеченныеНаСервере(Номера, ЗадачаСОписанием, Описание)

	// КОМАНДА НА КАЖДУЮ ЗАДАЧУ, а не одна на пачку. У команды один адресат — задача, и по
	// нему же форма гасит колесико в колонке «Ожидание»: одна команда на пять задач
	// зажгла бы индикатор у одной. Служба разбирает их за один оборот и выполняет по
	// очереди (`plan_batch`: разные задачи одного прайса друг друга не отклоняют).
	Отказы = Новый Массив;
	Позиция = 0;

	Для Каждого Номер Из Номера Цикл
		Позиция = Позиция + 1;

		Данные = Новый Структура;

		// НОМЕР В ПАЧКЕ ОБЯЗАТЕЛЕН (бой 03.10.2026). Нажатие одно, а `ТекущаяДата()` имеет
		// секундную точность — у всех команд пачки получается ОДНА метка времени. Агент
		// разрешал такую ничью номером в своей очереди, то есть порядком, в котором их
		// вернула 1С, а она упорядочивает по `Идентификатор` — СЛУЧАЙНОМУ GUID. Админ
		// увидел «выполняется со второй задачи по последнюю, первая в конце».
		//
		// Порядок берётся из таблицы формы (`ОтмеченныеЗадачи`), то есть тот, в котором
		// админ задачи видит: виды отсортированы спекой, а не алфавитом, и выполняться они
		// должны в том же порядке, в каком он их читает.
		Данные.Вставить("seq", Позиция);

		Если Номер = ЗадачаСОписанием И НЕ ПустаяСтрока(Описание) Тогда
			Данные.Вставить("description", Описание);
		КонецЕсли;

		Итог = ии_РаботаСМодельюИИАгнета.ПоставитьКоманду("выполнить задачу",
			ВыбранныйПрайс, Номер,
			ии_РаботаСМодельюИИАгнета.ДанныеКомандыВСтроку(Данные), ИмяПользователя());

		// ОСТАЛЬНЫЕ ПРОДОЛЖАЕМ СТАВИТЬ. Отказ приходит по одной задаче (например, по ней
		// уже висит незакрытая команда), и бросать из-за неё остальные четыре значило бы
		// наказать админа за одну строку.
		Если НЕ Итог.ok Тогда
			Отказы.Добавить("№" + Формат(Номер, "ЧГ=0") + ": " + Итог.message);
		КонецЕсли;
	КонецЦикла;

	Если Отказы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "Отправлены не все задачи:" + Символы.ПС
		+ СоединитьСтроки(Отказы, Символы.ПС);

КонецФункции


// Склейка строк через разделитель. Своя, а не `СтрСоединить`: ЭТА ПЛАТФОРМА ЕЁ НЕ ЗНАЕТ
// (правка админа 03.10.2026) — как не знает `СтрНачинаетсяС` и `СтрЗаканчиваетсяНа`
// (22.09.2026), ради которых свои написаны в `find-items.bsl`, и как не знала
// `СтрРазделить`, ради которой своя лежит в `properties.bsl`.
//
// ПРАВИЛО НА БУДУЩЕЕ, чтобы не искать это в третий раз: в BSL для этой конфигурации
// пользуемся только тем, что есть во всех версиях, — `Найти`, `Лев`, `Прав`, `Сред`,
// `СтрДлина`, `СтрЗаменить`, `СокрЛП`. Всё из семейства `Стр*`, добавленного в 8.3.6,
// пишем руками: ошибка вылезает не на выкладке модуля, а при первом вызове.
//
// Имя НАМЕРЕННО не повторяет платформенное: одноимённая функция станет конфликтом в тот
// день, когда платформу обновят, и разбирать его придётся на работающей базе.
//
// Признак «первая» вместо проверки непустого результата: первая строка может быть пустой,
// и тогда разделитель перед второй потерялся бы.
&НаСервереБезКонтекста
Функция СоединитьСтроки(Части, Разделитель)

	Результат = "";
	Первая = Истина;

	Для Каждого Часть Из Части Цикл
		Если НЕ Первая Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Строка(Часть);
		Первая = Ложь;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура СтатусЗадачиВыборПриИзменении(Элемент)
	
	Если ВыбраннаяЗадача = 0 ИЛИ ПустаяСтрока(СтатусЗадачиВыбор) Тогда
		Возврат;
	КонецЕсли;

	Данные = ДанныеСОписанием();
	Данные.Вставить("status", СтатусЗадачиВыбор);
	ОтправитьКоманду("сменить статус задачи", ВыбранныйПрайс, ВыбраннаяЗадача, Данные);	
	
КонецПроцедуры  

&НаКлиенте
Процедура УдалитьЗадачу(Команда)
	
	Если ВыбраннаяЗадача = 0 Тогда
		Возврат;
	КонецЕсли;

	// Подтверждение обязательно: удаление необратимо (решение Ф7). Вопрос называет предмет
	// целиком — «Вы уверены?» не даёт заметить, что выделена не та задача.
	Текст = "Удалить задачу №" + Формат(ВыбраннаяЗадача, "ЧГ=0") + " «"
		+ АдресВыбраннойЗадачи() + "»?"; 
		
	Ответ = Вопрос(Текст,РежимДиалогаВопрос.ДаНет,,,"Удаление задачи");
	Если Ответ = КодВозвратаДиалога.Да Тогда		
		ОтправитьКоманду("удалить задачу", ВыбранныйПрайс, ВыбраннаяЗадача, Новый Структура);
	КонецЕсли;
	
КонецПроцедуры 
	

#КонецОбласти

#Область КомандыПоПрайсу 

&НаКлиенте
Процедура ОбновитьЗадачи(Команда)
	
	Если ВыбранныйПрайс = 0 Тогда
		Возврат;
	КонецЕсли;

	// ПЕРЕСБОРКА НИЧЕГО НЕ ПЕРЕНОСИТ — ни статусы, ни правки описаний (§4 спеки). Задача,
	// которую админ решил не делать, вернётся: условие, её породившее, никуда не делось.
	// Это принятое следствие, и админ должен узнать о нём ДО нажатия, а не после.
	Текст = "Собрать задачи прайса №" + Формат(ВыбранныйПрайс, "ЧГ=0")
		+ " заново?" + Символы.ПС + Символы.ПС
		+ "Текущие задачи будут заменены. Статусы и правки описаний НЕ переносятся.";
		
	Ответ = Вопрос(Текст,РежимДиалогаВопрос.ДаНет,,,"Обновление задач по прайсу");
	Если Ответ = КодВозвратаДиалога.Да Тогда		
		ОтправитьКоманду("пересобрать задачи", ВыбранныйПрайс, 0, Новый Структура);
	КонецЕсли;	
		
КонецПроцедуры
	
&НаКлиенте
Процедура СтатусПрайсаВыборПриИзменении(Элемент)
	
	Если ВыбранныйПрайс = 0 ИЛИ ПустаяСтрока(СтатусПрайсаВыбор) Тогда
		Возврат;
	КонецЕсли;

	Данные = Новый Структура("status", СтатусПрайсаВыбор);

	// ЗАКРЫТИЕ ПРАЙСА СПРАШИВАЕТСЯ ОТДЕЛЬНО (решение админа 28.09.2026).
	//
	// За статусом «выполнен» стоит не смена подписи, а РАССЫЛКА: менеджерам уходит
	// сводка о том, что изменилось в каталоге по этому прайсу. Отменить отправленное
	// сообщение нельзя, поэтому спрашиваем до, а не жалеем после.
	//
	// «Нет» отменяет СМЕНУ СТАТУСА целиком, а не только рассылку: вопрос спрашивает
	// «закончили ли вы», и отрицательный ответ означает, что работа продолжается.
	// Поэтому выпадающий список возвращается к прежнему значению — иначе он показывал
	// бы статус, которого в модели нет.
	//
	// Тот же вопрос задаёт и Telegram: одно и то же действие не может давать разный
	// результат в зависимости от того, откуда нажали. Флаг `confirmed` едет в команде —
	// без него служба закрывать прайс откажется.
	Если НРег(СокрЛП(СтатусПрайсаВыбор)) = "выполнен" Тогда
		Текст = "Вы уверены, что закончили работать с этим прайсом и хотите оповестить "
			+ "менеджеров о результатах?" + Символы.ПС + Символы.ПС
			+ "Менеджерам уйдёт сводка: что заведено, снято, у чего изменились цены и "
			+ "размеры. Если по прайсу ничего не менялось, сообщение не отправится.";

		Ответ = Вопрос(Текст, РежимДиалогаВопрос.ДаНет, , , "Закрытие прайса");
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Текущий = Элементы.Прайсы.ТекущиеДанные;
			СтатусПрайсаВыбор = ?(Текущий = Неопределено, "", Текущий.Статус);
			Возврат;
		КонецЕсли;

		Данные.Вставить("confirmed", Истина);
	КонецЕсли;

	ОтправитьКоманду("сменить статус прайса", ВыбранныйПрайс, 0, Данные);

КонецПроцедуры

&НаКлиенте
Процедура УничтожитьПрайс(Команда)
	
	Если ВыбранныйПрайс = 0 Тогда
		Возврат;
	КонецЕсли;

	Текст = "Уничтожить прайс №" + Формат(ВыбранныйПрайс, "ЧГ=0") + " «"
		+ ИмяВыбранногоПрайса() + "» и все его задачи ("
		+ Формат(ЗадачиПрайса.Количество(), "ЧГ=0") + ")?" + Символы.ПС + Символы.ПС
		+ "Действие необратимо: файл прайса и его история будут стёрты."; 
		
	Ответ = Вопрос(Текст,РежимДиалогаВопрос.ДаНет,,,"Удаление прайса");
	Если Ответ = КодВозвратаДиалога.Да Тогда		
		ОтправитьКоманду("уничтожить прайс", ВыбранныйПрайс, 0, Новый Структура);
	КонецЕсли;
		
КонецПроцедуры   

#КонецОбласти


#Область Отправка

&НаКлиенте
Процедура ОтправитьКоманду(Вид, НомерПрайса, НомерЗадачи, Данные)

	Итог = ПоставитьКомандуНаСервере(Вид, НомерПрайса, НомерЗадачи, Данные);

	Если НЕ Итог.ok Тогда
		ПоказатьПредупреждение(, Итог.message);
		Возврат;
	КонецЕсли;

	// Правка ушла вместе с командой — признак снимаем, иначе следующее обновление не
	// стало бы трогать поле описания и админ видел бы старый текст как «неотправленный».
	ОписаниеИзменено = Ложь;

	// Списки перечитываем сразу: колесико ожидания обязано загореться в тот же миг, а не
	// через пять секунд, — иначе админ нажмёт второй раз.
	ОбновитьВсё();

КонецПроцедуры


&НаСервере
Функция ПоставитьКомандуНаСервере(Вид, НомерПрайса, НомерЗадачи, Данные)

	// Время создания ставит СЕРВЕР, внутри `ПоставитьКоманду`. Форма его не передаёт и
	// передать не может: часы рабочей станции дали бы одному админу вечный выигрыш в
	// правиле «кто первый», а другому вечный проигрыш, причём молча.
	Строчка = ?(Данные = Неопределено, "",
		ии_РаботаСМодельюИИАгнета.ДанныеКомандыВСтроку(Данные));

	Возврат ии_РаботаСМодельюИИАгнета.ПоставитьКоманду(Вид, НомерПрайса, НомерЗадачи, Строчка,
		ИмяПользователя());

КонецФункции


&НаКлиенте
Функция ДанныеСОписанием()

	Данные = Новый Структура;

	Если ОписаниеИзменено Тогда
		Данные.Вставить("description", ОписаниеЗадачи);
	КонецЕсли;

	Возврат Данные;

КонецФункции

#КонецОбласти


#Область Мелочи

&НаКлиенте
Функция ИмяВыбранногоПрайса()

	Для Каждого Прайс Из Прайсы Цикл
		Если Прайс.Идентификатор = ВыбранныйПрайс Тогда
			Возврат Прайс.Файл;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции


&НаКлиенте
Функция АдресВыбраннойЗадачи()

	Для Каждого Задача Из ЗадачиПрайса Цикл
		Если Задача.Идентификатор = ВыбраннаяЗадача Тогда
			Возврат Задача.Адрес;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти


