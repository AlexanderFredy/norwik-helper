// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик GET get-products/find-items
//
// Кодировка файла: UTF-8. Контракт ответа — specs/content-manager.md §19.11.
//
// ЗАЧЕМ. Перед созданием позиции агент обязан убедиться, что её нет среди СНЯТЫХ С
// ПРОИЗВОДСТВА (§19.2.5). Сейчас он проверяет это по выгрузке `by-tm`, то есть В ПРЕДЕЛАХ
// ОДНОЙ МАРКИ, — и ровно тот случай, ради которого проверка задумана, не ловится: товар,
// заведённый когда-то под ДРУГОЙ маркой, в выгрузке запрошенной ТМ не появится. Агент
// создаст дубль, а в справочнике станет двумя карточками одного товара.
//
// Поиском по всей номенклатуре обойти это нельзя было ничем: by-tm требует марку, folders
// отдаёт только папки, а перебирать все марки подряд — это тысячи позиций в контекст на
// каждую создаваемую строку прайса.
//
// КАК ПОДКЛЮЧИТЬ. Файл кладётся в ТОТ ЖЕ модуль, что by-tm.bsl и set-prices.bsl. В
// существующем GET-обработчике (там, где разбирается query-type) добавьте ветку:
//
//     ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "find-items" Тогда
//         Возврат ОтветJSON(200, НайтиТовары(Запрос.ПараметрыЗапроса));
//
// Функция `ОтветJSON` уже есть в set-prices.bsl — второй раз её вставлять НЕ НУЖНО.
// Все функции этого файла уникальны и с другими обработчиками не пересекаются.
//
//     GET .../find-items?article=A001
//     GET .../find-items?name=Дуб Верона
//     GET .../find-items?article=A001&tm=000000325&limit=20
//
// НЕВЫГРУЖАЕМЫЕ ВКЛЮЧЕНЫ ПО УМОЛЧАНИЮ — здесь наоборот, чем в by-tm, и это осознанно:
// обработчик существует ради поиска снятых, а они лежат именно в невыгружаемых папках.
// Исключить их можно параметром `include_not_exported=0`.
//
// ПОИСК НАРОЧНО ШИРОКИЙ. Артикул и имя ищутся ВХОЖДЕНИЕМ, а не точным совпадением:
// поставщики пишут «A001», «A-001» и «a001» вперемешку, и точное сравнение не нашло бы
// ничего. Лишний кандидат агенту не вреден — он его отбросит, глядя на имя и марку;
// ненайденный дубль порождает вторую карточку, и это уже правка в боевом справочнике.
//
// ПОМЕЧЕННЫЕ НА УДАЛЕНИЕ НЕ ОТДАЮТСЯ: возвращать из них товар нельзя, а как «уже есть»
// они читались бы неверно.
// =====================================================================================

Функция НайтиТовары(ПараметрыЗапроса)

	Артикул = ПараметрыЗапроса.Получить("article");
	Имя     = ПараметрыЗапроса.Получить("name");

	Если Артикул = Неопределено Тогда
		Артикул = "";
	КонецЕсли;

	Если Имя = Неопределено Тогда
		Имя = "";
	КонецЕсли;

	Артикул = СокрЛП(Артикул);
	Имя     = СокрЛП(Имя);

	Если ПустаяСтрока(Артикул) И ПустаяСтрока(Имя) Тогда
		Возврат ОтветПоискаСОшибкой("query_missing",
			"Нужен хотя бы один параметр: article или name");
	КонецЕсли;

	// Однобуквенный запрос вернёт пол-справочника и ничего не докажет.
	Если НЕ ПустаяСтрока(Артикул) И СтрДлина(Артикул) < 2 Тогда
		Возврат ОтветПоискаСОшибкой("query_too_short",
			"Слишком короткий article: нужно хотя бы 2 символа");
	КонецЕсли;

	Если ПустаяСтрока(Артикул) И СтрДлина(Имя) < 3 Тогда
		Возврат ОтветПоискаСОшибкой("query_too_short",
			"Слишком короткий name: нужно хотя бы 3 символа");
	КонецЕсли;

	// --- предел выдачи: умолчание 50, потолок 200
	ПараметрЛимит = ПараметрыЗапроса.Получить("limit");

	Если ПараметрЛимит = Неопределено Тогда
		Лимит = 50;
	Иначе
		Попытка
			Лимит = Число(ПараметрЛимит);
		Исключение
			Возврат ОтветПоискаСОшибкой("limit_invalid",
				"Параметр limit не число: " + Строка(ПараметрЛимит));
		КонецПопытки;
	КонецЕсли;

	Если Лимит < 1 Тогда
		Лимит = 50;
	КонецЕсли;

	Если Лимит > 200 Тогда
		Лимит = 200;
	КонецЕсли;

	Запрос = Новый Запрос;

	// --- необязательное сужение по марке
	ТекстОтборМарки = "";
	КодМарки = ПараметрыЗапроса.Получить("tm");

	Если КодМарки <> Неопределено И НЕ ПустаяСтрока(КодМарки) Тогда
		// НайтиПоКоду отдаёт ПУСТУЮ ССЫЛКУ, а не Неопределено, — проверяем заполненность
		Производитель = Справочники.Производители.НайтиПоКоду(КодМарки);

		Если НЕ ЗначениеЗаполнено(Производитель) Тогда
			Возврат ОтветПоискаСОшибкой("tm_not_found",
				"Не найдена торговая марка с кодом " + КодМарки);
		КонецЕсли;

		Запрос.УстановитьПараметр("Производитель", Производитель);
		ТекстОтборМарки = " И Номенклатура.Производитель = &Производитель";
	КонецЕсли;

	// Подзапрос по невыгружаемым группам: он же даёт признак not_exported в ответе.
	// Держим одной строкой, чтобы отбор и признак не разъехались.
	ТекстНевыгружаемыеГруппы =
		"Номенклатура.Родитель В ИЕРАРХИИ
		|                (ВЫБРАТЬ
		|                    Группы.Ссылка
		|                ИЗ
		|                    Справочник.Номенклатура КАК Группы
		|                ГДЕ
		|                    Группы.ЭтоГруппа = ИСТИНА
		|                    И Группы.НеВыгружать = ИСТИНА)";

	// Здесь невыгружаемые нужны ПО УМОЛЧАНИЮ — ради них обработчик и написан.
	ТекстИсключитьНевыгружаемые = "";
	ВключатьНевыгружаемые = ПараметрыЗапроса.Получить("include_not_exported");

	Если ВключатьНевыгружаемые <> Неопределено И Строка(ВключатьНевыгружаемые) = "0" Тогда
		ТекстИсключитьНевыгружаемые = " И НЕ " + ТекстНевыгружаемыеГруппы;
	КонецЕсли;

	// --- условия поиска. Экранируем спецсимволы: подчёркивание в артикулах встречается
	// сплошь («LE_267»), а в ПОДОБНО оно значит «любой один символ».
	УсловияПоиска = Новый Массив;

	Если НЕ ПустаяСтрока(Артикул) Тогда
		Запрос.УстановитьПараметр("Артикул", "%" + ЭкранироватьПодобно(Артикул) + "%");
		УсловияПоиска.Добавить("Номенклатура.Артикул ПОДОБНО &Артикул СПЕЦСИМВОЛ ""~""");
	КонецЕсли;

	Если НЕ ПустаяСтрока(Имя) Тогда
		Запрос.УстановитьПараметр("Имя", "%" + ЭкранироватьПодобно(Имя) + "%");
		УсловияПоиска.Добавить("Номенклатура.Наименование ПОДОБНО &Имя СПЕЦСИМВОЛ ""~""");
		УсловияПоиска.Добавить("Номенклатура.НаименованиеПолное ПОДОБНО &Имя СПЕЦСИМВОЛ ""~""");
	КонецЕсли;

	ТекстУсловийПоиска = "";
	Для Каждого Условие Из УсловияПоиска Цикл
		Если ПустаяСтрока(ТекстУсловийПоиска) Тогда
			ТекстУсловийПоиска = Условие;
		Иначе
			ТекстУсловийПоиска = ТекстУсловийПоиска + " ИЛИ " + Условие;
		КонецЕсли;
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ %%Лимит%%
				   |    Номенклатура.Ссылка КАК Товар,
				   |    ВЫБОР
				   |        КОГДА %%ТекстНевыгружаемыеГруппы%%
				   |            ТОГДА ИСТИНА
				   |        ИНАЧЕ ЛОЖЬ
				   |    КОНЕЦ КАК НеВыгружается
				   |ИЗ
				   |    Справочник.Номенклатура КАК Номенклатура
				   |ГДЕ
				   |    Номенклатура.ЭтоГруппа = ЛОЖЬ
				   |    И Номенклатура.ПометкаУдаления = ЛОЖЬ
				   |    И (%%ТекстУсловийПоиска%%)
				   |    %%ТекстОтборМарки%%
				   |    %%ТекстИсключитьНевыгружаемые%%
				   |УПОРЯДОЧИТЬ ПО
				   |    Номенклатура.Наименование";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%Лимит%%", Формат(Лимит, "ЧГ=0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ТекстНевыгружаемыеГруппы%%",
		ТекстНевыгружаемыеГруппы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ТекстУсловийПоиска%%", ТекстУсловийПоиска);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ТекстОтборМарки%%", ТекстОтборМарки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%%ТекстИсключитьНевыгружаемые%%",
		ТекстИсключитьНевыгружаемые);

	Запрос.Текст = ТекстЗапроса;

	Товары = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Товары.Добавить(ДанныеНайденногоТовара(Выборка.Товар, Выборка.НеВыгружается));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("article", Артикул);
	Результат.Вставить("name", Имя);
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("total", Товары.Количество());
	// Ровно столько, сколько просили, — возможно, нашлось больше. Агент должен знать, что
	// «не нашлось» и «не поместилось» — разные ответы.
	Результат.Вставить("truncated", Товары.Количество() >= Лимит);
	Результат.Вставить("items", Товары);
	Результат.Вставить("errors", Новый Массив);

	Возврат Результат;

КонецФункции


// Ответ с ошибкой — В ТОМ ЖЕ КОНВЕРТЕ, что удачный: клиент разбирает его одинаково, а
// сериализация не спотыкается на неожиданном типе.
Функция ОтветПоискаСОшибкой(КодОшибки, Текст)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("ref,code,message", "", КодОшибки, Текст));

	Результат = Новый Структура;
	Результат.Вставить("article", "");
	Результат.Вставить("name", "");
	Результат.Вставить("limit", 0);
	Результат.Вставить("total", 0);
	Результат.Вставить("truncated", Ложь);
	Результат.Вставить("items", Новый Массив);
	Результат.Вставить("errors", Ошибки);

	Возврат Результат;

КонецФункции


// Поля намеренно те же, что в by-tm, и НИ ОДНО не может быть Неопределено: оно ломает
// сериализацию JSON, и ответ превращается в HTTP 500 без внятной причины.
Функция ДанныеНайденногоТовара(Товар, НеВыгружается)

	Данные = Новый Структура;
	Данные.Вставить("ref", Товар.Код);
	Данные.Вставить("name", Товар.Наименование);
	Данные.Вставить("full_name", Товар.НаименованиеПолное);
	Данные.Вставить("article", Товар.Артикул);
	Данные.Вставить("unit", Товар.ЕдиницаИзмерения.Наименование);
	Данные.Вставить("product_type", Товар.ВидТовара.Наименование);
	Данные.Вставить("product_type_ref", Товар.ВидТовара.Код);
	Данные.Вставить("tm", Товар.Производитель.Наименование);
	Данные.Вставить("tm_code", Товар.Производитель.Код);
	Данные.Вставить("parent",
		Новый Структура("code,name", Товар.Родитель.Код, Товар.Родитель.Наименование));
	// Главный признак для агента: лежит в невыгружаемой ветке — почти наверняка снятый.
	Данные.Вставить("not_exported", НеВыгружается);

	Возврат Данные;

КонецФункции


// В ПОДОБНО спецсимволы — «%», «_» и «[». В артикулах подчёркивание обычное дело, и без
// экранирования «LE_267» нашёл бы и «LE-267», и «LE0267».
Функция ЭкранироватьПодобно(Значение)

	Результат = СтрЗаменить(Значение, "~", "~~");
	Результат = СтрЗаменить(Результат, "%", "~%");
	Результат = СтрЗаменить(Результат, "_", "~_");
	Результат = СтрЗаменить(Результат, "[", "~[");

	Возврат Результат;

КонецФункции
