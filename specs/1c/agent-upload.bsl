// =====================================================================================
// Загрузка прайса из формы 1С и лента сообщений агента (решение админа 27.10.2026)
//
// Кодировка файла: UTF-8. Кладётся в ТОТ ЖЕ общий модуль `ии_РаботаСМодельюИИАгнета`, что
// agent-commands.bsl и set-model-state.bsl: отсюда зовутся их `ПоставитьКоманду`,
// `ДанныеКомандыВСтроку`, `ВСоответствие`, `ЗначениеИли`, `МестноеИзISO`,
// `ПоднятьВерсиюСостояния`.
//
// ЗАЧЕМ. 27.10.2026 связь боевого сервера с Telegram пропала на полдня: прайс, присланный в
// бот, не скачался, а ответы агента до админа не доходили. Форма 1С с агентом связана
// надёжно — значит, и прайс, и ответы должны ходить и через неё.
//
// КАК ЭТО УСТРОЕНО. Стрелки по-прежнему идут ОТ агента: обработчик HTTP-сервиса до формы не
// дотягивается.
//   * Файл форма кладёт в регистр `ии_МодельФайлыКоманд` и ставит команду «принять прайс».
//     Агент, увидев её в очереди, забирает файл запросом `agent-file` и принимает прайс так
//     же, как из Telegram. Когда команда закрыта (выполнена или отклонена), файл удаляется
//     (`УбратьФайлКоманды` из `СудьбаКоманд` в agent-commands.bsl).
//   * Сообщения агент сам кладёт запросом `agent-messages` в регистр
//     `ии_МодельСообщенияАгента`; форма показывает последние в своём поле.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// **`РегистрСведений.ии_МодельФайлыКоманд`** — независимый непериодический.
//   Измерение: `Команда` Строка 36 — GUID команды «принять прайс» из `ии_МодельКоманды`.
//   Ресурсы:   `ИмяФайла` Строка 255, `Поставщик` Строка 150,
//              `Данные` ХранилищеЗначения, `Загружен` Дата (дата и время).
//
// **`РегистрСведений.ии_МодельСообщенияАгента`** — независимый непериодический.
//   Измерение: `Идентификатор` Строка 36 — номер сообщения у агента (повтор той же отправки
//              перезаписывает строку, а не дублирует её).
//   Ресурсы:   `Момент` Дата (дата и время, МЕСТНОЕ), `Текст` Строка (неограниченная),
//              `Прайс` Число 9,0, `Задача` Число 9,0, `Вид` Строка 50.
//
// МАРШРУТЫ — на том же шаблоне `get-products/{query-type}`:
//
//   GET-обработчик:
//        ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "agent-file" Тогда
//            Если НЕ МодульHTTPСервисов.ПроверитьТокен(Запрос) Тогда
//                Возврат ОтветJSON(401, Новый Структура("error", "Unauthorized"));
//            КонецЕсли;
//            Попытка
//                Возврат ОтветJSON(200, ии_РаботаСМодельюИИАгнета.ОтдатьФайлКоманды(
//                    Запрос.ПараметрыЗапроса.Получить("id")));
//            Исключение
//                Возврат ОтветJSON(500, Новый Структура("error",
//                    КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
//            КонецПопытки;
//
//   POST-обработчик `ProductManagementPOST`:
//        ИначеЕсли Запрос.ПараметрыURL.Получить("query-type") = "agent-messages" Тогда
//            (проверка токена — как в соседних ветках)
//            Попытка
//                Возврат ОтветJSON(200, ии_РаботаСМодельюИИАгнета.ПринятьСообщенияАгента(Данные));
//            Исключение
//                Возврат ОтветJSON(500, Новый Структура("error",
//                    КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
//            КонецПопытки;
// =====================================================================================


// Вид команды, которую агент понимает как «прими файл» (`CommandKind.SUBMIT_PRICE`).
Функция ВидЗагрузкиПрайса() Экспорт
	Возврат "принять прайс";
КонецФункции


// Предел размера — тот же, что у приёма из Telegram (20 МБ).
Функция ПредельныйРазмерПрайса() Экспорт
	Возврат 20 * 1024 * 1024;
КонецФункции


// Какие файлы агент принимает — те же расширения, что у Telegram.
Функция РасширениеПрайсаДопустимо(ИмяФайла) Экспорт

	Имя = НРег(СокрЛП(ИмяФайла));
	Для Каждого Расширение Из СтрРазделить(".xlsx,.xls,.csv,.pdf", ",") Цикл
		Если Прав(Имя, СтрДлина(Расширение)) = Расширение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции


// ======================================================================================
// ФОРМА: положить файл и поставить команду
//
// ОДНОЙ ТРАНЗАКЦИЕЙ: команда без файла дала бы агенту «файл не найден», файл без команды —
// мусор в регистре, который некому убрать.
// ======================================================================================

Функция ЗагрузитьПрайс(ДвоичныеДанные, ИмяФайла, Поставщик, Пользователь) Экспорт

	Результат = Новый Структура("ok,message", Ложь, "");

	Если ДвоичныеДанные = Неопределено ИЛИ ДвоичныеДанные.Размер() = 0 Тогда
		Результат.message = "Файл пустой.";
		Возврат Результат;
	КонецЕсли;
	Если ДвоичныеДанные.Размер() > ПредельныйРазмерПрайса() Тогда
		Результат.message = "Файл больше 20 МБ — агент такой не примет.";
		Возврат Результат;
	КонецЕсли;
	Если НЕ РасширениеПрайсаДопустимо(ИмяФайла) Тогда
		Результат.message = "Не похоже на прайс. Поддерживаются: .xlsx, .xls, .csv, .pdf.";
		Возврат Результат;
	КонецЕсли;

	Значения = Новый Структура;
	Значения.Вставить("file", СокрЛП(ИмяФайла));
	Значения.Вставить("supplier", СокрЛП(Поставщик));
	Строчка = ДанныеКомандыВСтроку(Значения);

	НачатьТранзакцию();
	Попытка
		Итог = ПоставитьКоманду(ВидЗагрузкиПрайса(), 0, 0, Строчка, Пользователь);
		Если НЕ Итог.ok Тогда
			ОтменитьТранзакцию();
			// Защита от второго нажатия общая: команда «про прайс 0» уже ждёт агента.
			Результат.message = "Предыдущая загрузка ещё не принята агентом — дождитесь её.";
			Возврат Результат;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельФайлыКоманд.СоздатьМенеджерЗаписи();
		Запись.Команда   = Итог.id;
		Запись.ИмяФайла  = Лев(СокрЛП(ИмяФайла), 255);
		Запись.Поставщик = Лев(СокрЛП(Поставщик), 150);
		Запись.Данные    = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		Запись.Загружен  = ТекущаяДата();
		Запись.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Результат.message = "Не удалось поставить загрузку: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.ok = Истина;
	Результат.Вставить("id", Итог.id);
	Возврат Результат;

КонецФункции


// ======================================================================================
// GET agent-file?id=<GUID команды> — агент забирает файл
// ======================================================================================

Функция ОтдатьФайлКоманды(Идентификатор) Экспорт

	Ответ = Новый Структура;
	Ключ = СокрЛП(Строка(?(Идентификатор = Неопределено, "", Идентификатор)));
	Если ПустаяСтрока(Ключ) Тогда
		Ответ.Вставить("error", "id_missing");
		Возврат Ответ;
	КонецЕсли;

	Запись = РегистрыСведений.ии_МодельФайлыКоманд.СоздатьМенеджерЗаписи();
	Запись.Команда = Ключ;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда
		Ответ.Вставить("error", "not_found");
		Возврат Ответ;
	КонецЕсли;

	ДвоичныеДанные = Запись.Данные.Получить();
	Если ДвоичныеДанные = Неопределено Тогда
		Ответ.Вставить("error", "empty");
		Возврат Ответ;
	КонецЕсли;

	// Переводы строк в base64 агенту не мешают, но и тащить их незачем.
	Текст = Base64Строка(ДвоичныеДанные);
	Текст = СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, "");

	Ответ.Вставить("name", Запись.ИмяФайла);
	Ответ.Вставить("supplier", Запись.Поставщик);
	Ответ.Вставить("data", Текст);
	Возврат Ответ;

КонецФункции


// Файл своё отслужил: команда закрыта. Зовётся из `СудьбаКоманд` (agent-commands.bsl).
Процедура УбратьФайлКоманды(Идентификатор) Экспорт

	Запись = РегистрыСведений.ии_МодельФайлыКоманд.СоздатьМенеджерЗаписи();
	Запись.Команда = СокрЛП(Идентификатор);
	Запись.Удалить();

КонецПроцедуры


// Файлы, чьих команд уже нет (команду убрала уборка, агент не ответил). Двадцать мегабайт
// в регистре — не та строка, что можно забыть навсегда.
Функция УбратьСиротыФайлов(ЧасовХранить = 24) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница", ТекущаяДата() - ЧасовХранить * 3600);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Файлы.Команда КАК Команда
		|ИЗ
		|	РегистрСведений.ии_МодельФайлыКоманд КАК Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ии_МодельКоманды КАК Команды
		|		ПО Файлы.Команда = Команды.Идентификатор
		|ГДЕ
		|	(Команды.Идентификатор ЕСТЬ NULL
		|		ИЛИ Файлы.Загружен < &Граница)";

	Убрано = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УбратьФайлКоманды(Выборка.Команда);
		Убрано = Убрано + 1;
	КонецЦикла;
	Возврат Убрано;

КонецФункции


// ======================================================================================
// POST agent-messages — агент кладёт свои сообщения для формы
//
//   {"messages": [{"id": "17", "at": "2026-10-27T08:50:00+00:00", "text": "…",
//                  "kind": "прайс принят", "price_id": 12, "task_id": 0}]}
//
// Запись по идентификатору: агент снимает сообщение у себя только после ответа, и повтор
// той же пачки после обрыва связи перезаписывает строки, а не дублирует.
// ======================================================================================

Функция ПринятьСообщенияАгента(Данные) Экспорт

	Итог = Новый Структура("written", 0);
	Тело = ВСоответствие(Данные);
	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Итог.Вставить("error", "body_not_object");
		Возврат Итог;
	КонецЕсли;
	Список = Тело.Получить("messages");
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Итог.Вставить("error", "messages_missing");
		Возврат Итог;
	КонецЕсли;

	Для Каждого Элемент Из Список Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Строка(ЗначениеИли(Элемент, "id", "")));
		Текст = Строка(ЗначениеИли(Элемент, "text", ""));
		Если ПустаяСтрока(Ключ) ИЛИ ПустаяСтрока(Текст) Тогда
			Продолжить;
		КонецЕсли;

		Запись = РегистрыСведений.ии_МодельСообщенияАгента.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Лев(Ключ, 36);
		// Время — МЕСТНОЕ: агент живёт в UTC, а читает человек (то же правило, что у снимка).
		Момент = МестноеИзISO(ЗначениеИли(Элемент, "at", ""));
		Запись.Момент = ?(ЗначениеЗаполнено(Момент), Момент, ТекущаяДата());
		Запись.Текст  = Текст;
		Запись.Прайс  = Число(ЗначениеИли(Элемент, "price_id", 0));
		Запись.Задача = Число(ЗначениеИли(Элемент, "task_id", 0));
		Запись.Вид    = Лев(Строка(ЗначениеИли(Элемент, "kind", "")), 50);
		Запись.Записать(Истина);
		Итог.written = Итог.written + 1;
	КонецЦикла;

	Если Итог.written > 0 Тогда
		// Форма перечитывается по росту версии — так новое сообщение появится в ней сразу.
		ПоднятьВерсиюСостояния();
		Попытка
			УбратьСтарыеСообщения();
		Исключение
			// Уборка не повод отвергать доставку: агент прислал бы пачку снова.
		КонецПопытки;
	КонецЕсли;

	Возврат Итог;

КонецФункции


// Держим последние 300: лента нужна для «что агент ответил сегодня», а не как архив.
Процедура УбратьСтарыеСообщения(Оставить = 300) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Сообщения.Идентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ии_МодельСообщенияАгента КАК Сообщения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.Момент УБЫВ";

	Номер = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Если Номер <= Оставить Тогда
			Продолжить;
		КонецЕсли;
		Запись = РегистрыСведений.ии_МодельСообщенияАгента.СоздатьМенеджерЗаписи();
		Запись.Идентификатор = Выборка.Идентификатор;
		Запись.Удалить();
	КонецЦикла;

КонецПроцедуры


// Текст ленты для формы: свежие сверху, между сообщениями пустая строка.
Функция ТекстЛентыСообщений(Количество = 30) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Количество, "ЧГ=0") + "
		|	Сообщения.Момент КАК Момент,
		|	Сообщения.Текст КАК Текст
		|ИЗ
		|	РегистрСведений.ии_МодельСообщенияАгента КАК Сообщения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сообщения.Момент УБЫВ";

	Лента = "";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строчка = Формат(Выборка.Момент, "ДФ='dd.MM HH:mm'") + " — " + Выборка.Текст;
		Лента = Лента + ?(ПустаяСтрока(Лента), "", Символы.ПС + Символы.ПС) + Строчка;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Лента), "Сообщений от агента пока нет.", Лента);

КонецФункции
