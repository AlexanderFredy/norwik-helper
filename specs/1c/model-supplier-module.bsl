// =====================================================================================
// МОДУЛЬ ОБЪЕКТА справочника ии_МодельПоставщики — переименование доезжает до модели
//
// Кодировка файла: UTF-8. Решение админа 26.09.2026.
//
// ЗАЧЕМ. Имя поставщика видно в таблице прайсов формы, а карточка зеркала открывается по
// двойному щелчку и правится руками. Если правка остаётся в 1С, дальше расходятся два
// справочника: в форме «Монарх Логистик», в Telegram «Монарх», и на вопрос «чей это
// прайс» визуалы отвечают по-разному. Значит имя должно ходить в ОБЕ стороны.
//
// ПОЧЕМУ КОМАНДОЙ, А НЕ ЧТЕНИЕМ ПРИ СНИМКЕ. Снимок уезжает, только когда менялось
// состояние МОДЕЛИ, и правка в 1С его не разбудит — агенту пришлось бы опрашивать
// справочник каждый оборот ради события, которое бывает раз в месяц. Команда же лежит в
// регистре, переживает перезапуск агента и закрывается с исходом, как всякая другая.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// У справочника **ии_МодельПоставщики** добавить реквизит:
//
//     ИмяОтАгента   Строка (неограниченная или 150), НЕ фиксированной длины
//
// Он служит одному: отличить запись АГЕНТА от правки ЧЕЛОВЕКА. Без него это не
// различается ничем, и получается либо откат правки, либо бесконечный обмен.
//
// Разберём, почему. Агент пишет элемент при каждой записи цен и при каждом снимке
// (`ПоставщикЗеркала`), и раньше он затирал `Наименование` именем из модели. Правка
// человека откатывалась назад через секунды. Заставить агента не писать имя тоже нельзя:
// тогда переименование из Telegram не доехало бы до 1С.
//
// С реквизитом правила простые и обе стороны живут:
//
//   * агент прислал имя, ОТЛИЧНОЕ от `ИмяОтАгента` — значит переименовали в модели:
//     пишем и `Наименование`, и `ИмяОтАгента`;
//   * `Наименование` разошлось с `ИмяОтАгента` — значит правил человек: агент имя НЕ
//     трогает, а этот модуль ставит команду, и модель узнаёт новое имя;
//   * совпало всё — записи нет вовсе, и обмен не крутится.
//
// -------------------------------------------------------------------------------------
// КУДА КЛАСТЬ
//
// Этот текст — в МОДУЛЬ ОБЪЕКТА справочника ии_МодельПоставщики. Функция
// `ПоставитьПереименованиеПоставщика` — в ТОТ ЖЕ общий модуль, где лежат agent-commands.bsl
// и set-model-state.bsl (ей нужны `ПоднятьВерсиюСостояния` и регистр команд).
// =====================================================================================


// ------------------------------------------------------------------ модуль объекта

Перем ИмяДоЗаписи;      // что стояло в базе до этой записи; Неопределено у нового


Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Старое имя читается ДО записи и только здесь: после `Записать()` в базе уже новое,
	// и сравнивать будет не с чем.
	ИмяДоЗаписи = ?(ЭтоНовый(), Неопределено, СокрЛП(Ссылка.Наименование));

КонецПроцедуры


Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Новый элемент заводит АГЕНТ, и модель про него уже знает: команда не нужна.
	Если ИмяДоЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Имя = СокрЛП(Наименование);

	// Имя не менялось — записывали что-то другое (юрлица, например).
	Если Имя = ИмяДоЗаписи Тогда
		Возврат;
	КонецЕсли;

	// ЗАПИСЬ АГЕНТА ОТЛИЧАЕТСЯ ОДНИМ: он всегда кладёт `ИмяОтАгента` = `Наименование`.
	// Значит совпадение — это его собственная запись, и команду по ней ставить нельзя:
	// модель узнала бы от нас то, что сама же и прислала, и обмен закрутился бы.
	Если Имя = СокрЛП(ИмяОтАгента) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПоставитьПереименованиеПоставщика(СокрЛП(Код), Имя);
	Исключение
		// Команда не поставилась — имя в 1С останется новым, в модели прежним. Это
		// расхождение видно глазами, а ронять запись карточки из-за него нельзя.
		ЗаписьЖурналаРегистрации("ии_Модель.Переименование",
			УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры


// ------------------------------------------------- общий модуль, рядом с командами

// Поставить агенту команду «переименовать поставщика».
//
// ОТДЕЛЬНО ОТ `ПоставитьКоманду`, и вот почему: та защищается от второго нажатия через
// `НезакрытаяКоманда(Прайс, Задача)`, а у переименования нет ни прайса, ни задачи — оба
// нуля. Переименование ДРУГОГО поставщика выглядело бы для неё «той же командой», и
// второе имя было бы отклонено со словами «ждём агента». Здесь такой защиты и не нужно:
// команды идемпотентны, применяются по порядку, последнее имя побеждает.
Функция ПоставитьПереименованиеПоставщика(Знач Код, Знач Имя) Экспорт

	Если ПустаяСтрока(Код) ИЛИ ПустаяСтрока(Имя) Тогда
		Возврат "";      // без кода адресовать нечего, без имени переименовывать нечем
	КонецЕсли;

	Значения = Новый Структура;
	Значения.Вставить("code", Код);
	Значения.Вставить("name", Имя);

	Идентификатор = Строка(Новый УникальныйИдентификатор());

	Запись = РегистрыСведений.ии_МодельКоманды.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Идентификатор;
	Запись.Вид           = "переименовать поставщика";
	Запись.Прайс         = 0;
	Запись.Задача        = 0;
	Запись.Данные        = ДанныеКомандыВСтроку(Значения);
	Запись.Пользователь  = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Запись.Создана       = ТекущаяДата();
	Запись.Состояние     = СостояниеЖдёт();
	Запись.Ответ         = "";
	Запись.Записать(Истина);

	// Версия НЕ поднимается: в форме от переименования ничего не меняется до того, как
	// модель пришлёт снимок с новым именем, — а он версию и поднимет.

	Возврат Идентификатор;

КонецФункции
