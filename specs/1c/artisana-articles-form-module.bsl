// =====================================================================================
// Обработка «Артикулы Артисана»: код Артисана → реквизит «Арт», заводской код → «Артикул»
// (решение админа 06.10.2026)
//
// Кодировка файла: UTF-8. Модуль ФОРМЫ внешней обработки.
//
// ЗАЧЕМ. Плитку Артисаны изначально заводили с ВНУТРЕННИМ кодом поставщика в поле
// «Артикул» («+15433»). Такой код знает только Артисан: сверить по нему прайс другого
// поставщика нельзя, а выбор наименьшей цены между поставщиками держится как раз на
// артикуле.
//
// ЧТО ДЕЛАЕТ — ОДНОЙ КНОПКОЙ, БЕЗ ВЫБОРА ПОЗИЦИЙ (решение админа 06.10.2026). У КАЖДОЙ
// позиции, чей «Артикул» начинается с «+»:
//   «Арт»     ← этот код (прежнее значение «Арт» перезаписывается);
//   «Артикул» ← заводской код из прайса, а если кода в прайсе нет или он пуст — ПУСТО:
//               такой позиции у поставщика нет, и держать в артикуле внутренний код
//               незачем.
// Повторный запуск безопасен: записанная позиция больше не начинается с «+».
//
// ОТКУДА СООТВЕТСТВИЕ. Из CSV, который готовит
//     python -m tools.artisana_codes "Price.xls" "data\exports\artisana_codes.csv"
// В колонке «Заводской код» прайса встречается то, что артикулом не является («нет кода»,
// одно значение дважды через перенос, код «0») — скрипт это чистит, и такие позиции
// получают пустой «Артикул». Формат (UTF-8, «;»): Код;Заводской;Повторов;Причина.
//
// ЕДИНСТВЕННЫЙ ПРЕДОХРАНИТЕЛЬ — ФАЙЛ БЕЗ ЕДИНОГО КОДА «+». Выбери админ по ошибке не тот
// файл, правило «нет в прайсе — пусто» стёрло бы «Артикул» у всех позиций разом. Поэтому
// пустое соответствие останавливает обработку до первой записи.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАТОРЕ (внешняя обработка, одна управляемая форма)
//
//   РЕКВИЗИТ формы:  Итог  Строка (неограниченная) — поле многострочное, только просмотр.
//   КОМАНДА:         Перенести — кнопка на форме.
//
// РЕКВИЗИТ «Арт» ДОЛЖЕН СУЩЕСТВОВАТЬ у справочника «Номенклатура» (строка). Обработка
// проверяет это сама и, если его нет, останавливается до первого запроса.
//
// ТОЛЬКО БЕЗОПАСНЫЕ ФУНКЦИИ СТРОК: `Найти`, `Лев`, `Прав`, `Сред`, `СтрДлина`, `СтрЗаменить`,
// `СокрЛП`, `НРег`. `СтрСоединить`, `СтрНачинаетсяС`, `СтрЗаканчиваетсяНа` в этой базе
// отсутствуют — подтверждено на боевых формах.
// =====================================================================================


&НаКлиенте
Процедура Перенести(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"У всех позиций с артикулом на «+» код уйдёт в «Арт», а в «Артикул» встанет "
			+ "заводской код из прайса (нет в прайсе — станет пустым). Выбрать файл "
			+ "соответствия и продолжить?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры


&НаКлиенте
Процедура ПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , "", Истина, УникальныйИдентификатор);

КонецПроцедуры


&НаКлиенте
Процедура ПослеПомещенияФайла(Помещен, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если НЕ Помещен Тогда
		Возврат;
	КонецЕсли;

	Итог = "Идёт перенос…";
	ПеренестиНаСервере(Адрес);

КонецПроцедуры


&НаСервере
Процедура ПеренестиНаСервере(Адрес)

	Итог = "";

	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Арт") = Неопределено Тогда
		Итог = "У справочника «Номенклатура» нет реквизита «Арт». Заведите его (Строка) "
			+ "и запустите обработку снова — ничего не изменено.";
		Возврат;
	КонецЕсли;

	Соответствие = ПрочитатьСоответствие(Адрес);
	Если Соответствие.Количество() = 0 Тогда
		// Не тот файл: продолжив, мы очистили бы «Артикул» у всех позиций на «+».
		Итог = "В файле не нашлось ни одной строки с кодом «+». Это тот CSV? Ничего не "
			+ "изменено.";
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Ссылка,
		|	Н.Наименование КАК Наименование,
		|	Н.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	НЕ Н.ЭтоГруппа
		|	И Н.Артикул ПОДОБНО ""+%""";
	Выборка = Запрос.Выполнить().Выбрать();

	СЗаводским = 0;
	Пустых = 0;
	Ошибок = 0;
	ТекстОшибок = "";

	Пока Выборка.Следующий() Цикл

		Код = СокрЛП(Выборка.Артикул);
		Заводской = Соответствие.Получить(Код);
		Если Заводской = Неопределено Тогда
			Заводской = "";
		КонецЕсли;

		Попытка
			// НЕ `Объект`: в форме обработки это её ОСНОВНОЙ реквизит.
			Карточка = Выборка.Ссылка.ПолучитьОбъект();
			Карточка.Арт = Код;
			Карточка.Артикул = Заводской;
			Карточка.Записать();
			Если ПустаяСтрока(Заводской) Тогда
				Пустых = Пустых + 1;
			Иначе
				СЗаводским = СЗаводским + 1;
			КонецЕсли;
		Исключение
			// Одна неудачная позиция не останавливает остальные.
			Ошибок = Ошибок + 1;
			Если Ошибок <= 20 Тогда
				ТекстОшибок = ТекстОшибок + Символы.ПС + "  " + Выборка.Наименование + " ("
					+ Код + "): " + ОписаниеОшибки();
			КонецЕсли;
		КонецПопытки;

	КонецЦикла;

	Итог = "Перенесено в «Арт»: " + Формат(СЗаводским + Пустых, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  «Артикул» = заводской код: " + Формат(СЗаводским, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  «Артикул» очищен (в прайсе нет кода): " + Формат(Пустых, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "Ошибок записи: " + Формат(Ошибок, "ЧН=0; ЧГ=0");
	Если Ошибок > 0 Тогда
		Итог = Итог + ТекстОшибок;
		Если Ошибок > 20 Тогда
			Итог = Итог + Символы.ПС + "  … и ещё " + Формат(Ошибок - 20, "ЧГ=0");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


// Соответствие «код Артисана → заводской код» из CSV. Пустой заводской код тоже кладётся:
// по нему позиция получит пустой «Артикул».
&НаСервере
Функция ПрочитатьСоответствие(Адрес)

	Результат = Новый Соответствие;

	ДвоичныеСведения = ПолучитьИзВременногоХранилища(Адрес);
	ВременныйФайл = ПолучитьИмяВременногоФайла("csv");
	ДвоичныеСведения.Записать(ВременныйФайл);

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ВременныйФайл, КодировкаТекста.UTF8);

	Попытка
		УдалитьФайлы(ВременныйФайл);
	Исключение
		// Временный файл останется в каталоге временных файлов — не повод ронять перенос.
	КонецПопытки;

	Для НомерСтроки = 2 По Текст.КоличествоСтрок() Цикл

		Поля = РазобратьСтроку(Текст.ПолучитьСтроку(НомерСтроки));
		Если Поля.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		Код = СокрЛП(Поля[0]);
		Если Лев(Код, 1) <> "+" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Код, СокрЛП(Поля[1]));

	КонецЦикла;

	Возврат Результат;

КонецФункции


// Поля строки CSV через «;». Кавычки не обрабатываются: в выгрузке их нет.
&НаСервереБезКонтекста
Функция РазобратьСтроку(Значение)

	Поля = Новый Массив;
	Остаток = Значение;
	Позиция = Найти(Остаток, ";");
	Пока Позиция > 0 Цикл
		Поля.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = Найти(Остаток, ";");
	КонецЦикла;
	Поля.Добавить(Остаток);

	Возврат Поля;

КонецФункции
