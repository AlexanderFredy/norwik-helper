// =====================================================================================
// Обработка «Артикулы Артисана»: код Артисана → реквизит «Арт», заводской код → «Артикул»
// (решение админа 06.10.2026)
//
// Кодировка файла: UTF-8. Модуль ФОРМЫ внешней обработки.
//
// ЗАЧЕМ. Плитку Артисаны изначально заводили с ВНУТРЕННИМ кодом поставщика в поле
// «Артикул» («+15433»). Такой код знает только Артисан: сверить по нему прайс другого
// поставщика нельзя, а выбор наименьшей цены между поставщиками держится как раз на
// артикуле. Обработка переносит код Артисана в реквизит «Арт», а в «Артикул» пишет
// ЗАВОДСКОЙ код из прайса.
//
// ОТКУДА СООТВЕТСТВИЕ. Не из Excel, а из CSV, который готовит
//     python -m tools.artisana_codes "Price.xls" "data\exports\artisana_codes.csv"
// Причина двойная. В колонке «Заводской код» прайса встречается то, что артикулом не
// является: строка «нет кода», одно значение дважды через перенос, код «0». Парсер прайса
// на стороне агента уже проверен на этом файле. А чтение Excel средствами платформы здесь
// не проверено ничем, и у этой конфигурации трижды не нашлось функций, которые должны были
// быть, — на разовой массовой правке номенклатуры рисковать этим незачем.
//
// Формат CSV (UTF-8, разделитель «;»): Код;Заводской;Повторов;Причина. Пустой «Заводской»
// значит «писать нечего», и «Причина» говорит почему.
//
// ДВА ШАГА, И ПЕРВЫЙ НИЧЕГО НЕ ПИШЕТ. «Загрузить соответствие» показывает, что будет
// сделано с каждой позицией, — запись идёт только по кнопке «Записать отмеченные» и после
// подтверждения. Обработка ИДЕМПОТЕНТНА: записанная позиция больше не начинается с «+» и
// при повторном запуске просто не попадает в список. И ОБРАТИМА: прежний код остаётся в
// «Арт», откатить можно в любой момент.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАТОРЕ (внешняя обработка, одна управляемая форма)
//
//   РЕКВИЗИТЫ формы:
//     ИмяФайла      Строка 500
//     Итог          Строка (неограниченная) — сводка числами
//     Изменения     ТаблицаЗначений:
//         Пометка        Булево
//         Номенклатура   СправочникСсылка.Номенклатура
//         Наименование   Строка 200
//         КодАртисана    Строка 30   — что сейчас в «Артикул»
//         ЗаводскойКод   Строка 100  — что туда запишется
//         АртСейчас      Строка 100  — что сейчас в «Арт»
//         Статус         Строка 300
//         МожноЗаписать  Булево      — снятый флажок здесь не ставится галкой
//
//   ЭЛЕМЕНТЫ: поле `Итог` (многострочное, только просмотр), таблица `Изменения` (все
//   колонки кроме `Пометка` — только просмотр), кнопки команд ниже.
//
//   КОМАНДЫ: `ЗагрузитьСоответствие`, `ЗаписатьОтмеченные`, `ОтметитьВсе`, `СнятьВсе`.
//
// РЕКВИЗИТ «Арт» ДОЛЖЕН СУЩЕСТВОВАТЬ у справочника «Номенклатура» (строка). Обработка
// проверяет это сама и, если его нет, останавливается до первого запроса: иначе запрос не
// скомпилировался бы, а запись упала бы на первой же позиции.
//
// ТОЛЬКО БЕЗОПАСНЫЕ ФУНКЦИИ СТРОК: `Найти`, `Лев`, `Прав`, `Сред`, `СтрДлина`, `СтрЗаменить`,
// `СокрЛП`, `НРег`. `СтрСоединить`, `СтрНачинаетсяС`, `СтрЗаканчиваетсяНа` в этой базе
// отсутствуют — подтверждено на боевых формах.
// =====================================================================================


// ------------------------------------------------------------------- загрузка соответствия

&НаКлиенте
Процедура ЗагрузитьСоответствие(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , "", Истина, УникальныйИдентификатор);

КонецПроцедуры


&НаКлиенте
Процедура ПослеПомещенияФайла(Помещен, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если НЕ Помещен Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = ВыбранноеИмяФайла;
	Сопоставить(Адрес);

КонецПроцедуры


&НаСервере
Процедура Сопоставить(Адрес)

	Изменения.Очистить();
	Итог = "";

	// Реквизита нет — останавливаемся ДО запроса: запрос с ним не скомпилируется, а запись
	// упала бы на первой же позиции, и разбираться пришлось бы по журналу.
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Арт") = Неопределено Тогда
		Итог = "У справочника «Номенклатура» нет реквизита «Арт». Заведите его (Строка) "
			+ "и запустите обработку снова — ничего не изменено.";
		Возврат;
	КонецЕсли;

	Соответствие = ПрочитатьСоответствие(Адрес);
	Если Соответствие.Количество() = 0 Тогда
		Итог = "В файле не нашлось ни одной строки с кодом «+». Это тот CSV? Ничего не "
			+ "изменено.";
		Возврат;
	КонецЕсли;

	// Длина поля «Артикул» — чтобы не записать код, который платформа молча обрежет.
	// Реквизит ищем, а не берём по имени: в части конфигураций он стандартный, и обращение
	// «.Артикул» упало бы. Не нашли — длину не проверяем (ноль значит «без ограничения»).
	ДлинаАртикула = 0;
	РеквизитАртикул = Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Артикул");
	Если РеквизитАртикул <> Неопределено Тогда
		ДлинаАртикула = РеквизитАртикул.Тип.КвалификаторыСтроки.Длина;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Ссылка,
		|	Н.Наименование КАК Наименование,
		|	Н.Артикул КАК Артикул,
		|	Н.Арт КАК Арт
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	НЕ Н.ЭтоГруппа
		|	И Н.Артикул ПОДОБНО ""+%""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Н.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();

	// ЗАВОДСКОЙ КОД, УЖЕ СТОЯЩИЙ У ДРУГОЙ ПОЗИЦИИ, — повод остановиться. Записав его второй
	// раз, мы свели бы две карточки к одному артикулу, и сверка с прайсом начала бы путать
	// их между собой. Решать, какая из них настоящая, — человеку.
	Занятые = ЗанятыеАртикулы(Соответствие);

	Всего = 0;
	КЗаписи = 0;
	Общих = 0;
	НетВПрайсе = 0;
	НечегоПисать = 0;
	Конфликтов = 0;

	Пока Выборка.Следующий() Цикл

		Всего = Всего + 1;
		Код = СокрЛП(Выборка.Артикул);
		Арт = СокрЛП(Выборка.Арт);

		НоваяСтрока = Изменения.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Ссылка;
		НоваяСтрока.Наименование = Выборка.Наименование;
		НоваяСтрока.КодАртисана  = Код;
		НоваяСтрока.АртСейчас    = Арт;
		НоваяСтрока.Пометка      = Ложь;
		НоваяСтрока.МожноЗаписать = Ложь;

		Сведения = Соответствие.Получить(Код);

		Если Сведения = Неопределено Тогда
			// Кода нет в ЭТОМ прайсе: позиция снята у поставщика или это не Артисан вовсе
			// («+» в начале артикула бывает и у других). Трогать нечем.
			НоваяСтрока.Статус = "кода нет в прайсе — не трогаю";
			НетВПрайсе = НетВПрайсе + 1;

		ИначеЕсли ПустаяСтрока(Сведения.Заводской) Тогда
			НоваяСтрока.Статус = "писать нечего: " + Сведения.Причина;
			НечегоПисать = НечегоПисать + 1;

		ИначеЕсли НЕ ПустаяСтрока(Арт) И Арт <> Код Тогда
			// В «Арт» уже что-то стоит, и это не наш код: затирать чужое значение нельзя.
			НоваяСтрока.ЗаводскойКод = Сведения.Заводской;
			НоваяСтрока.Статус = "в «Арт» уже другое значение — не трогаю";
			Конфликтов = Конфликтов + 1;

		ИначеЕсли ДлинаАртикула > 0 И СтрДлина(Сведения.Заводской) > ДлинаАртикула Тогда
			НоваяСтрока.ЗаводскойКод = Сведения.Заводской;
			НоваяСтрока.Статус = "заводской код длиннее поля «Артикул» ("
				+ Формат(СтрДлина(Сведения.Заводской), "ЧГ=0") + " > "
				+ Формат(ДлинаАртикула, "ЧГ=0") + ")";
			Конфликтов = Конфликтов + 1;

		ИначеЕсли Занятые.Получить(Сведения.Заводской) <> Неопределено Тогда
			НоваяСтрока.ЗаводскойКод = Сведения.Заводской;
			НоваяСтрока.Статус = "этот заводской код уже стоит у «"
				+ Занятые.Получить(Сведения.Заводской) + "» — решите вручную";
			Конфликтов = Конфликтов + 1;

		Иначе
			НоваяСтрока.ЗаводскойКод = Сведения.Заводской;
			НоваяСтрока.МожноЗаписать = Истина;

			// ОБЩИЙ ЗАВОДСКОЙ КОД ПИСАТЬ МОЖНО, НО ГАЛКУ СТАВИТ ЧЕЛОВЕК. Две позиции поставщика
			// с одним кодом завода получат один артикул; сверка такое переживает, но в выборе
			// наименьшей цены между поставщиками этот артикул участвовать перестанет.
			Если Сведения.Повторов > 1 Тогда
				НоваяСтрока.Статус = "заводской код общий у "
					+ Формат(Сведения.Повторов, "ЧГ=0")
					+ " позиций прайса — отметьте сами, если согласны";
				Общих = Общих + 1;
			Иначе
				НоваяСтрока.Статус = "к записи";
				НоваяСтрока.Пометка = Истина;
				КЗаписи = КЗаписи + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Итог = "Позиций с артикулом «+» в базе: " + Формат(Всего, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  к записи (отмечены): " + Формат(КЗаписи, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  с общим заводским кодом (не отмечены): " + Формат(Общих, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  писать нечего (в прайсе нет кода): " + Формат(НечегоПисать, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  кода нет в прайсе: " + Формат(НетВПрайсе, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "  конфликты, решать вручную: " + Формат(Конфликтов, "ЧН=0; ЧГ=0") + Символы.ПС
		+ "Ничего не записано — проверьте список и нажмите «Записать отмеченные».";

КонецПроцедуры


// Соответствие «код Артисана → структура (Заводской, Повторов, Причина)» из CSV.
&НаСервере
Функция ПрочитатьСоответствие(Адрес)

	Результат = Новый Соответствие;

	ДвоичныеСведения = ПолучитьИзВременногоХранилища(Адрес);
	ВременныйФайл = ПолучитьИмяВременногоФайла("csv");
	ДвоичныеСведения.Записать(ВременныйФайл);

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ВременныйФайл, КодировкаТекста.UTF8);

	Попытка
		УдалитьФайлы(ВременныйФайл);
	Исключение
		// Временный файл останется в каталоге временных файлов — не повод ронять разбор.
	КонецПопытки;

	Для НомерСтроки = 2 По Текст.КоличествоСтрок() Цикл

		Поля = РазобратьСтроку(Текст.ПолучитьСтроку(НомерСтроки));
		Если Поля.Количество() < 4 Тогда
			Продолжить;
		КонецЕсли;

		Код = СокрЛП(Поля[0]);
		// Первая строка файла может нести метку кодировки, а строка с кодом обязана
		// начинаться с «+» — проверяем по первому знаку, без функций, которых нет.
		Если Лев(Код, 1) <> "+" Тогда
			Продолжить;
		КонецЕсли;

		Сведения = Новый Структура;
		Сведения.Вставить("Заводской", СокрЛП(Поля[1]));
		Сведения.Вставить("Повторов", ЧислоИзСтроки(Поля[2]));
		Сведения.Вставить("Причина", СокрЛП(Поля[3]));
		Результат.Вставить(Код, Сведения);

	КонецЦикла;

	Возврат Результат;

КонецФункции


// Поля строки CSV через «;». Кавычки не обрабатываются: в выгрузке их нет, заводские коды
// и причины кавычек не содержат.
&НаСервереБезКонтекста
Функция РазобратьСтроку(Значение)

	Поля = Новый Массив;
	Остаток = Значение;
	Позиция = Найти(Остаток, ";");
	Пока Позиция > 0 Цикл
		Поля.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = Найти(Остаток, ";");
	КонецЦикла;
	Поля.Добавить(Остаток);

	Возврат Поля;

КонецФункции


&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Значение)

	Попытка
		Возврат Число(СокрЛП(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


// Заводские коды, которые УЖЕ стоят в «Артикул» у какой-то позиции: код → наименование.
&НаСервере
Функция ЗанятыеАртикулы(Соответствие)

	Коды = Новый Массив;
	Для Каждого Пара Из Соответствие Цикл
		Если НЕ ПустаяСтрока(Пара.Значение.Заводской) Тогда
			Коды.Добавить(Пара.Значение.Заводской);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Соответствие;
	Если Коды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Артикул КАК Артикул,
		|	Н.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	НЕ Н.ЭтоГруппа
		|	И Н.Артикул В (&Коды)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.Артикул), Выборка.Наименование);
	КонецЦикла;

	Возврат Результат;

КонецФункции


// ------------------------------------------------------------------------------- запись

&НаКлиенте
Процедура ЗаписатьОтмеченные(Команда)

	Отмечено = 0;
	Для Каждого Позиция Из Изменения Цикл
		Если Позиция.Пометка И Позиция.МожноЗаписать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмечено = 0 Тогда
		ПоказатьПредупреждение(, "Отмеченных позиций нет — записывать нечего.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОЗаписи", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Записать " + Формат(Отмечено, "ЧГ=0") + " поз.? Код Артисана уйдёт в «Арт», "
			+ "в «Артикул» встанет заводской код.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры


&НаКлиенте
Процедура ПослеВопросаОЗаписи(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьНаСервере();

КонецПроцедуры


&НаСервере
Процедура ЗаписатьНаСервере()

	Записано = 0;
	Пропущено = 0;
	Ошибок = 0;

	Для Каждого Позиция Из Изменения Цикл

		Если НЕ Позиция.Пометка ИЛИ НЕ Позиция.МожноЗаписать Тогда
			Продолжить;
		КонецЕсли;

		// НЕ `Объект`: в форме обработки это её ОСНОВНОЙ реквизит, и присваивание ему
		// подменило бы саму обработку, а не карточку товара.
		Карточка = Позиция.Номенклатура.ПолучитьОбъект();

		// ПЕРЕПРОВЕРЯЕМ ПЕРЕД ЗАПИСЬЮ: между сопоставлением и нажатием позицию могли
		// поправить руками. Записав по устаревшему списку, мы затёрли бы чужую правку.
		Если СокрЛП(Карточка.Артикул) <> Позиция.КодАртисана Тогда
			Позиция.Статус = "пропущено: артикул изменился после сопоставления";
			Позиция.Пометка = Ложь;
			Позиция.МожноЗаписать = Ложь;
			Пропущено = Пропущено + 1;
		ИначеЕсли НЕ ПустаяСтрока(Карточка.Арт) И СокрЛП(Карточка.Арт) <> Позиция.КодАртисана Тогда
			Позиция.Статус = "пропущено: в «Арт» появилось другое значение";
			Позиция.Пометка = Ложь;
			Позиция.МожноЗаписать = Ложь;
			Пропущено = Пропущено + 1;
		Иначе
			Попытка
				Карточка.Арт = Позиция.КодАртисана;
				Карточка.Артикул = Позиция.ЗаводскойКод;
				Карточка.Записать();
				Позиция.Статус = "записано";
				Позиция.Пометка = Ложь;
				Позиция.МожноЗаписать = Ложь;
				Записано = Записано + 1;
			Исключение
				// Одна неудачная позиция не останавливает остальные: каждая пишется сама
				// по себе, а причина остаётся в строке таблицы.
				Позиция.Статус = "ошибка записи: " + ОписаниеОшибки();
				Ошибок = Ошибок + 1;
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	Итог = "Записано: " + Формат(Записано, "ЧН=0; ЧГ=0")
		+ ", пропущено (изменились после сопоставления): " + Формат(Пропущено, "ЧН=0; ЧГ=0")
		+ ", ошибок: " + Формат(Ошибок, "ЧН=0; ЧГ=0") + "." + Символы.ПС
		+ "Прежние коды Артисана сохранены в «Арт» — откатить можно в любой момент.";

КонецПроцедуры


// ------------------------------------------------------------------------------- флажки

// «Отметить все» отмечает ТОЛЬКО то, что можно записать: иначе одна кнопка снимала бы все
// предохранители разом, включая конфликты, которые как раз и надо решить руками.
&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого Позиция Из Изменения Цикл
		Позиция.Пометка = Позиция.МожноЗаписать;
	КонецЦикла;

КонецПроцедуры


&НаКлиенте
Процедура СнятьВсе(Команда)

	Для Каждого Позиция Из Изменения Цикл
		Позиция.Пометка = Ложь;
	КонецЦикла;

КонецПроцедуры
