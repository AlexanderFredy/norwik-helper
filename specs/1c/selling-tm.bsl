// =====================================================================================
// HTTP-сервис 1С: ai-tools — обработчик GET get-products/selling-tm
//
// Кодировка файла: UTF-8. Контракт ответа — specs/content-manager.md §8, §19.10.
//
// ЭТО ПРАВКА СУЩЕСТВУЮЩЕЙ ФУНКЦИИ `ПолучитьТМкВыгрузкеНаСайт`. Формат ответа не меняется —
// массив `{NameTM, Code}`, — добавлено одно поле и один параметр.
//
// ЗАЧЕМ ФЛАГ. Марку заводят в справочнике раньше, чем помечают к выгрузке: сначала её
// прорабатывают, и только потом она появляется на сайте. В этом промежутке агенту нужно
// заводить для неё товары, а `create_item.manufacturer` принимает КОД Производителя —
// значит код надо где-то взять. Без флага марка невидима: агент не найдёт код и не сможет
// создать позицию (§19.10).
//
//     GET .../selling-tm                          → только помеченные, как раньше
//     GET .../selling-tm?include_not_exported=1   → все, с признаком `Selling`
//
// Имя параметра то же, что у by-tm (§19.3): смысл один — «покажи и то, что на сайт не
// идёт», — и называться в двух местах по-разному он не должен.
//
// В ПЛАН ПРОГОНА ПРАЙСА ПО-ПРЕЖНЕМУ ИДУТ ТОЛЬКО ПОМЕЧЕННЫЕ. Непроработанную марку
// разбирать рано; флаг нужен для адресного поиска кода, а не для расширения плана.
//
// ЧТО ЕЩЁ ИСПРАВЛЕНО В ЗАПРОСЕ
//
//   * `ВЫБРАТЬ РАЗЛИЧНЫЕ`. Условие `Производители.Магазины.Магазин = …` обращается к
//     ТАБЛИЧНОЙ ЧАСТИ, и марка с двумя строками по «Норвику» пришла бы дважды. Сейчас
//     таких, похоже, нет, но дубль в списке марок разошёлся бы по всему прогону.
//   * `НЕ ПометкаУдаления`. Помеченный на удаление производитель в выгрузке не нужен.
//   * Сортировка по наименованию: ответ должен быть одинаковым от вызова к вызову, иначе
//     диффы и кеши на стороне агента шумят на ровном месте.
// =====================================================================================

Функция ПолучитьТМкВыгрузкеНаСайт(ПараметрыЗапроса = Неопределено)

	Результат = Новый Массив;

	// Параметр читаем через `.Получить()`: обращение по индексу к отсутствующему ключу
	// бросает «Поле объекта не обнаружено» — на этом уже терялся круг выкладки в
	// properties-by-type.
	ВсеМарки = Ложь;

	Если ПараметрыЗапроса <> Неопределено Тогда
		Если ПараметрыЗапроса.Получить("include_not_exported") = "1" Тогда
			ВсеМарки = Истина;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВсеМарки", ВсеМарки);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Производители.Наименование КАК ТорговаяМарка,
		|	Производители.Код КАК Код,
		|	ВЫБОР
		|		КОГДА Производители.Ссылка В
		|				(ВЫБРАТЬ
		|					Магазины.Ссылка
		|				ИЗ
		|					Справочник.Производители.Магазины КАК Магазины
		|				ГДЕ
		|					Магазины.Магазин = ЗНАЧЕНИЕ(Справочник.ёМагазины.Норвик))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК КВыгрузке
		|ИЗ
		|	Справочник.Производители КАК Производители
		|ГДЕ
		|	НЕ Производители.ПометкаУдаления
		|	И (&ВсеМарки
		|		ИЛИ Производители.Ссылка В
		|			(ВЫБРАТЬ
		|				Магазины.Ссылка
		|			ИЗ
		|				Справочник.Производители.Магазины КАК Магазины
		|			ГДЕ
		|				Магазины.Магазин = ЗНАЧЕНИЕ(Справочник.ёМагазины.Норвик)))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТорговаяМарка";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("NameTM,Code,Selling",
			Выборка.ТорговаяМарка, Выборка.Код, Выборка.КВыгрузке));
	КонецЦикла;

	Возврат Результат;

КонецФункции
