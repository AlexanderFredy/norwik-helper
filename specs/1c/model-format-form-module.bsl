// =====================================================================================
// Форма ФОРМАТА ПРАЙСА: листы и бренды в одном окне (решение админа 03.10.2026)
//
// Кодировка файла: UTF-8. Контракт — specs/1c/model-form.md, раздел «Форма формата прайса».
//
// ЗАЧЕМ ОДНА ФОРМА, А НЕ ДВЕ. Листы и бренды — два ответа на один вопрос «что в этом формате
// разбирать», и к разбору уходит их ПЕРЕСЕЧЕНИЕ. Разведённые по двум окнам, они требовали
// двух открытий и двух сохранений ради одного решения, а пустое пересечение («бренд отмечен,
// но лежит на неотмеченном листе») не было видно вовсе — его показывал только отчёт после
// разбора.
//
// ОДНА КОМАНДА НА ОБА СПИСКА — не удобство, а необходимость. У команд выбора листов и выбора
// брендов адрес ОДИНАКОВЫЙ: прайс и задача 0. Защита от второго нажатия
// (`НезакрытаяКоманда(Прайс, Задача)` в agent-commands.bsl) отклонила бы вторую с «по этому
// прайсу уже отправлена команда» — и половина выбора молча не доехала бы. Поэтому
// «Сохранить» ставит ОДНУ команду «изменить формат прайса», несущую оба списка, валюту и
// курс: одна защита, одна надпись ожидания, один исход.
//
// КАК ОТКРЫВАЕТСЯ: ДВОЙНЫМ ЩЕЛЧКОМ по имени файла в таблице прайсов (`ОткрытьФорматПрайса`
// в model-form-module.bsl). Отдельной кнопки «Бренды» больше нет — один вход на одно решение.
//
// -------------------------------------------------------------------------------------
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// ДВА РЕГИСТРА-ЗЕРКАЛА. Пишет их ТОЛЬКО `set-model-state`; форма читает и НЕ меняет.
//
// **`РегистрСведений.ии_МодельЛистыПрайсов`** — независимый непериодический.
//   Измерения: `Сигнатура` Строка 64, `Лист` Строка 150.
//   Ресурсы:   `Поставщик` СправочникСсылка.ии_МодельПоставщики (ссылка, не строка),
//              `Формат` Строка 150, `Порядок` Число 3,0 (порядок В КНИГЕ, не алфавитный),
//              `Разбирать` Булево.
//
// **`РегистрСведений.ии_МодельБрендыПрайсов`** — независимый непериодический.
//   Измерения: `Сигнатура` Строка 64, `Бренд` Строка 150 (как написано В ФАЙЛЕ).
//   Ресурсы:   `Поставщик` СправочникСсылка.ии_МодельПоставщики,
//              `Порядок` Число 3,0 — порядок В ФАЙЛЕ,
//              `Строк` Число 6,0 — позиций бренда в последнем файле. НОЛЬ = бренда в нём
//                  больше нет; строка остаётся вместе с флажком, маркой и скидкой,
//              `Разбирать` Булево,
//              `Марка` СправочникСсылка.Производители — настоящий справочник марок базы,
//              `Скидка` Число 5,2 — процент скидки от розницы.
//
// Плюс в `РегистрСведений.ии_МодельПрайсы` два ресурса: **`Валюта`
// СправочникСсылка.Валюты** и **`Курс` Число 10,4** — они принадлежат прайсу.
//
// ФОРМА — **ОБЩАЯ** (`ОбщаяФорма.ии_МодельФорматПрайса`), а не форма регистра (правка
// админа 03.10.2026). Так логически правильнее: она читает ДВА регистра запросами и не
// пишет НИ ОДНОГО, то есть «своего» объекта у неё нет вовсе. Повешенная на один из
// регистров, она врала бы о своей принадлежности — и выбор, на какой именно, был бы
// произвольным. Заодно у общей формы нет лишнего наследства формы записи регистра:
// стандартных команд записи, ключа и заполнения.
//
// Имя с приставкой `ии_`, как у остальных объектов агента: так всё его хозяйство видно в
// дереве конфигурации одним куском.
//
//   ПАРАМЕТРЫ формы (отдельный список, НЕ реквизиты — модуль читает их через
//   `Параметры.Свойство`, и необъявленный параметр просто не придёт):
//     Сигнатура  Строка   — хеш формата
//     Файл       Строка   — имя файла, для заголовка
//     Прайс      Число    — откуда открыли: по нему адресуется ожидание в форме прайсов
//     Валюта     Строка   — КОД валюты прайса, не ссылка
//     Курс       Число
//
//   РЕКВИЗИТЫ формы:
//     Сигнатура   Строка  64
//     Файл        Строка 255
//     НомерПрайса Число   9,0
//     Валюта      СправочникСсылка.Валюты — пусто = рубль
//     Курс        Число  10,4 — курс ВЫБРАННОЙ валюты
//     ЕстьПравки  Булево
//     Листы       ТаблицаЗначений: `Лист` Строка 150, `Разбирать` Булево,
//                 `Порядок` Число 3,0
//     Бренды      ТаблицаЗначений: `Бренд` Строка 150, `Строк` Число 6,0,
//                 `Разбирать` Булево, `Марка` СправочникСсылка.Производители,
//                 `Скидка` Число 5,2, `Порядок` Число 3,0
//
//   ЭЛЕМЕНТЫ: таблицы `Листы` и `Бренды`, поля `Валюта` и `Курс`, кнопки `Сохранить` и
//   `Обновить` — ОБЩИЕ на оба списка, — плюс `ОтметитьВсеЛисты` / `СнятьВсеЛисты` и
//   `ОтметитьВсеБренды` / `СнятьВсеБренды`.
//
//   СОБЫТИЯ ПРИВЯЗАТЬ В КОНФИГУРАТОРЕ, иначе они не вызываются ни с ошибкой, ни со следом
//   (бой 02.10.2026 с `ОбработкаОповещения`): `ПриСозданииНаСервере`;
//   `ПриИзменении` у колонок `Листы.Разбирать`, `Бренды.Разбирать`, `Бренды.Марка`,
//   `Бренды.Скидка` и у полей `Валюта`, `Курс`.
//
// ПОЧЕМУ НЕ ПИШЕМ В РЕГИСТРЫ НАПРЯМУЮ. Зеркало — не источник истины: его перезапишет
// следующий снимок, и отметки пропали бы через пять секунд. Истина живёт у агента, поэтому
// форма СТАВИТ КОМАНДУ, а флажки приезжают обратно снимком.
// =====================================================================================


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Сигнатура   = СтрокаПараметра("Сигнатура");
	Файл        = СтрокаПараметра("Файл");
	// НОМЕР ПРАЙСА нужен не для отбора (листы и бренды принадлежат ФОРМАТУ), а для
	// АДРЕСАЦИИ ВИЗУАЛА: по нему форма прайсов гасит кнопки и показывает надпись ожидания.
	НомерПрайса = ЧислоПараметра("Прайс");
	Курс        = ЧислоПараметра("Курс");
	// Валюта приходит КОДОМ: между формами код надёжнее ссылки — он не зависит от того, та
	// же это база или её копия, и виден глазами в параметрах.
	Валюта      = ВалютаПоКоду(СтрокаПараметра("Валюта"));

	Если ПустаяСтрока(Сигнатура) Тогда
		// Без формата показывать нечего, и открывать пустую форму незачем: пустые таблицы
		// читаются как «ничего нет», а это другое.
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПрочитатьВсё();

КонецПроцедуры


// Параметр формы читается через `Свойство`, а НЕ через `Получить`: `Получить` есть у
// соответствия, а параметры формы — структура, и у неё этого метода нет. Ошибка при этом
// вылетает в `ПриСозданииНаСервере`, то есть форма просто не открывается, и причина не
// видна (02.10.2026).
&НаСервере
Функция СтрокаПараметра(Имя)

	Значение = Неопределено;

	Если НЕ Параметры.Свойство(Имя, Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции


&НаСервере
Функция ЧислоПараметра(Имя)

	Значение = Неопределено;

	Если НЕ Параметры.Свойство(Имя, Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат ?(Значение = Неопределено, 0, Число(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


&НаСервереБезКонтекста
Функция ВалютаПоКоду(Код)

	Если ПустаяСтрока(Код) Тогда
		// Валюта не указана — это РУБЛЬ по умолчанию, законный случай, а не сбой.
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;

	Найденная = Справочники.Валюты.НайтиПоКоду(СокрЛП(Код));
	Возврат ?(Найденная.Пустая(), Справочники.Валюты.ПустаяСсылка(), Найденная);

КонецФункции


&НаСервере
Процедура ПрочитатьВсё()

	ПрочитатьЛисты();
	ПрочитатьБренды();
	ПоказатьЗаголовок();
	ЕстьПравки = Ложь;

КонецПроцедуры


&НаСервере
Процедура ПрочитатьЛисты()

	Листы.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сигнатура", Сигнатура);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Л.Лист КАК Лист,
		|	Л.Разбирать КАК Разбирать,
		|	Л.Порядок КАК Порядок
		|ИЗ
		|	РегистрСведений.ии_МодельЛистыПрайсов КАК Л
		|ГДЕ
		|	Л.Сигнатура = &Сигнатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Л.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Листы.Добавить();
		НоваяСтрока.Лист      = Выборка.Лист;
		НоваяСтрока.Разбирать = Выборка.Разбирать;
		НоваяСтрока.Порядок   = Выборка.Порядок;
	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ПрочитатьБренды()

	Бренды.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сигнатура", Сигнатура);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Б.Бренд КАК Бренд,
		|	Б.Строк КАК Строк,
		|	Б.Разбирать КАК Разбирать,
		|	Б.Марка КАК Марка,
		|	Б.Скидка КАК Скидка,
		|	Б.Порядок КАК Порядок
		|ИЗ
		|	РегистрСведений.ии_МодельБрендыПрайсов КАК Б
		|ГДЕ
		|	Б.Сигнатура = &Сигнатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Б.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Бренды.Добавить();
		НоваяСтрока.Бренд     = Выборка.Бренд;
		НоваяСтрока.Строк     = Выборка.Строк;
		НоваяСтрока.Разбирать = Выборка.Разбирать;
		НоваяСтрока.Марка     = Выборка.Марка;
		НоваяСтрока.Скидка    = Выборка.Скидка;
		НоваяСтрока.Порядок   = Выборка.Порядок;
	КонецЦикла;

КонецПроцедуры


&НаСервере
Процедура ПоказатьЗаголовок()

	// ПУСТЫЕ ТАБЛИЦЫ ОБЯЗАНЫ ОБЪЯСНИТЬСЯ. Молчаливая пустота читается как поломка формы, а
	// причин у неё две, и они требуют разного: зеркало ещё не доехало (ждать) либо формата
	// в нём нет (проверить сигнатуру). Пишем это В ЗАГОЛОВОК — он всегда на виду.
	Если Листы.Количество() = 0 И Бренды.Количество() = 0 Тогда
		Заголовок = "Формат прайса " + Лев(Сигнатура, 12)
			+ ": в зеркале нет ни листов, ни брендов — снимок агента ещё не доехал";
		Возврат;
	КонецЕсли;

	ЛистовОтмечено = 0;
	Для Каждого Строчка Из Листы Цикл
		Если Строчка.Разбирать Тогда
			ЛистовОтмечено = ЛистовОтмечено + 1;
		КонецЕсли;
	КонецЦикла;

	БрендовОтмечено = 0;
	СтрокОтмечено = 0;
	БезМарки = 0;
	Для Каждого Строчка Из Бренды Цикл
		Если Строчка.Разбирать Тогда
			БрендовОтмечено = БрендовОтмечено + 1;
			СтрокОтмечено = СтрокОтмечено + Строчка.Строк;
		КонецЕсли;
		Если Строчка.Марка.Пустая() Тогда
			БезМарки = БезМарки + 1;
		КонецЕсли;
	КонецЦикла;

	// ПУСТОЙ СПИСОК БРЕНДОВ ПРИ ЖИВЫХ ЛИСТАХ — ЭТО ОТВЕТ, А НЕ ПОЛОМКА (вопрос админа
	// 04.10.2026, заданный дважды). Бренд обозначен в прайсе далеко не всегда: у четырёх
	// форматов из пяти его нет ни на одном листе — там одна марка на файл либо марка
	// написана в ИМЕНИ ЛИСТА («Ассортимент CLASSEN»), и ограничивают разбор именно листы.
	// Молчащая пустая таблица читается как несработавшее зеркало, поэтому причину называем
	// вслух и говорим, что делать вместо этого.
	Если Бренды.Количество() = 0 Тогда
		Заголовок = "Формат прайса: " + Файл
			+ " — листов " + Формат(Листы.Количество(), "ЧГ=0")
			+ " (отмечено " + Формат(ЛистовОтмечено, "ЧГ=0") + ")"
			+ "; брендов нет — в этом формате бренд не обозначен ни колонкой,"
			+ " ни разделителем, ни баннером; разбор ограничивают только листы";
		Возврат;
	КонецЕсли;

	// ЧИСЛА В ЗАГОЛОВКЕ — то, что админ проверяет глазами. «Без марки в 1С» и есть работа,
	// которую видно только здесь: такой бренд в задачи не попадёт, сколько его ни отмечай.
	//
	// СТРОКИ ОТМЕЧЕННОГО — ЭТО ЦЕНА РАЗБОРА, и она обязана быть на виду ДО нажатия
	// «Обновить задачи» (решение админа 04.10.2026). Коллекции не выбираются, значит бренд
	// берётся целиком: у крупного прайса одна марка бывает на 6 700 строк ≈ 200 тыс.
	// токенов ≈ $2 за одну загрузку таблицы, а дальше она едет в каждый запрос. Агент сверх
	// предела разбор не начнёт и скажет, с кого снять флажок, — но увидеть это заранее
	// дешевле, чем узнать из отказа.
	Заголовок = "Формат прайса: " + Файл
		+ " — листов " + Формат(Листы.Количество(), "ЧГ=0")
		+ " (отмечено " + Формат(ЛистовОтмечено, "ЧГ=0") + ")"
		+ ", брендов " + Формат(Бренды.Количество(), "ЧГ=0")
		+ " (отмечено " + Формат(БрендовОтмечено, "ЧГ=0") + ")"
		+ ?(СтрокОтмечено = 0, "",
			", строк в выборе " + Формат(СтрокОтмечено, "ЧГ=0"))
		+ ?(БезМарки = 0, "", ", без марки в 1С " + Формат(БезМарки, "ЧГ=0"));

КонецПроцедуры


// ОБНОВЛЕНИЕ НЕ ЗАТИРАЕТ НЕОТПРАВЛЕННЫЕ ПРАВКИ. Снимок приходит каждые несколько секунд, и
// перечитав таблицы посреди расстановки флажков, мы стёрли бы уже отмеченное — админ ставит
// их по одному, а не залпом. Кнопка ОДНА на оба списка: решение у них общее.
&НаКлиенте
Процедура Обновить(Команда)

	Если ЕстьПравки Тогда
		ПоказатьПредупреждение(,
			"Есть неотправленные правки. Сохраните их или закройте форму без сохранения.");
		Возврат;
	КонецЕсли;

	ПрочитатьВсё();

КонецПроцедуры


&НаКлиенте
Процедура ЛистыРазбиратьПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура БрендыРазбиратьПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура БрендыМаркаПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура БрендыСкидкаПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура КурсПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура ОтметитьВсеЛисты(Команда)

	Для Каждого Строчка Из Листы Цикл
		Строчка.Разбирать = Истина;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура СнятьВсеЛисты(Команда)

	Для Каждого Строчка Из Листы Цикл
		Строчка.Разбирать = Ложь;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура ОтметитьВсеБренды(Команда)

	Для Каждого Строчка Из Бренды Цикл
		Строчка.Разбирать = Истина;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура СнятьВсеБренды(Команда)

	Для Каждого Строчка Из Бренды Цикл
		Строчка.Разбирать = Ложь;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)

	Листов = 0;
	Для Каждого Строчка Из Листы Цикл
		Если Строчка.Разбирать Тогда
			Листов = Листов + 1;
		КонецЕсли;
	КонецЦикла;

	Брендов = 0;
	Для Каждого Строчка Из Бренды Цикл
		Если Строчка.Разбирать Тогда
			Брендов = Брендов + 1;
		КонецЕсли;
	КонецЦикла;

	// К РАЗБОРУ УХОДИТ ПЕРЕСЕЧЕНИЕ, поэтому пустой любой из списков означает «не разбирать
	// этот формат вовсе». Это законное действие, а не промах, — но молча оставить админа с
	// пустым списком задач нельзя: он решит, что сломался разбор. Спрашиваем ОДИН раз и
	// называем, чего именно не хватает.
	Пусто = "";
	Если Листов = 0 И Бренды.Количество() > 0 И Брендов = 0 Тогда
		Пусто = "Не отмечено НИ ОДНОГО листа и ни одного бренда.";
	ИначеЕсли Листов = 0 Тогда
		Пусто = "Не отмечено ни одного листа.";
	ИначеЕсли Бренды.Количество() > 0 И Брендов = 0 Тогда
		Пусто = "Не отмечено ни одного бренда.";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Пусто) Тогда
		Текст = Пусто + " Агент не будет разбирать этот формат:" + Символы.ПС
			+ "«Обновить задачи» даст пустой список." + Символы.ПС + Символы.ПС
			+ "Сохранить такой выбор?";
		ПоказатьВопрос(Новый ОписаниеОповещения("СохранитьОтвет", ЭтаФорма),
			Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Формат прайса");
		Возврат;
	КонецЕсли;

	Отправить();

КонецПроцедуры


&НаКлиенте
Процедура СохранитьОтвет(Ответ, ДопДанные) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Отправить();
	КонецЕсли;

КонецПроцедуры


// ОТПРАВИЛИ — ЗАКРЫВАЕМСЯ. Ждать результат здесь нечем и незачем: его показывает форма
// прайсов — там гаснут кнопки и стоит надпись со счётчиком, как у остальных команд.
&НаКлиенте
Процедура Отправить()

	Итог = ПоставитьФорматНаСервере();

	Если НЕ Итог.ok Тогда
		// Чаще всего это «по этому прайсу уже отправлена команда»: форма прайсов в этот
		// момент и так показывает ожидание, и закрываться, не отправив, нельзя — админ
		// решил бы, что отправилось.
		ПоказатьПредупреждение(, Итог.message);
		Возврат;
	КонецЕсли;

	ЕстьПравки = Ложь;
	Закрыть();

КонецПроцедуры


&НаСервере
Функция ПоставитьФорматНаСервере()

	// ОДНА КОМАНДА НА ОБА СПИСКА. Двумя нельзя: адрес у них одинаковый (прайс и задача 0), и
	// защита от второго нажатия отклонила бы вторую — половина выбора молча не доехала бы.
	ОтмеченныеЛисты = Новый Массив;
	Для Каждого Строчка Из Листы Цикл
		Если Строчка.Разбирать Тогда
			ОтмеченныеЛисты.Добавить(Строчка.Лист);
		КонецЕсли;
	КонецЦикла;

	// СТРОКА НА БРЕНД, а не список имён: вместе с флажком едут марка и скидка, и в одно
	// текстовое поле они не лягут.
	СписокБрендов = Новый Массив;
	Для Каждого Строчка Из Бренды Цикл
		Запись = Новый Структура;
		Запись.Вставить("brand", Строчка.Бренд);
		Запись.Вставить("parse", Строчка.Разбирать);
		// КОД марки, а не имя: агент знает марки кодами, а имя в справочнике двуязычное
		// («Atlas Concorde / Атлас конкорд») — по нему сопоставление разошлось бы.
		Запись.Вставить("tm_code", ?(Строчка.Марка.Пустая(), "", Строчка.Марка.Код));
		Запись.Вставить("tm_name", ?(Строчка.Марка.Пустая(), "",
			Строчка.Марка.Наименование));
		Запись.Вставить("discount", Строчка.Скидка);
		СписокБрендов.Добавить(Запись);
	КонецЦикла;

	Значения = Новый Структура;
	Значения.Вставить("signature", Сигнатура);
	Значения.Вставить("sheets", ОтмеченныеЛисты);
	Значения.Вставить("marks", СписокБрендов);
	// ВАЛЮТА И КУРС ЕДУТ ВМЕСТЕ и ложатся к ПРАЙСУ (номер прайса для этого и передан).
	// Врозь их держать нельзя: число без валюты выглядит заданным, а чего оно курс —
	// неизвестно, и по такому числу однажды посчитали бы цену не в той валюте.
	Значения.Вставить("currency", ?(Валюта.Пустая(), "", Валюта.Код));
	Значения.Вставить("currency_name", ?(Валюта.Пустая(), "", Валюта.Наименование));
	Значения.Вставить("rate", Курс);

	// НАГРУЗКУ СВЁРТЫВАЕМ В JSON САМИ: `Данные` в регистре команд — СТРОКА, а
	// `ПоставитьКоманду` кладёт в неё то, что дали, без преобразования. Передав структуру,
	// мы записали бы команду, из которой агент не достанет ничего, и отказ выглядел бы как
	// успех — форма закрылась, надпись погасла, выбор потерян (бой 02.10.2026).
	Строчка = ии_РаботаСМодельюИИАгнета.ДанныеКомандыВСтроку(Значения);

	Возврат ии_РаботаСМодельюИИАгнета.ПоставитьКоманду(
		"изменить формат прайса", НомерПрайса, 0, Строчка, ИмяПользователя());

КонецФункции
