// =====================================================================================
// Форма выбора БРЕНДОВ прайса (решение админа 03.10.2026)
//
// Кодировка файла: UTF-8. Контракт — specs/1c/model-form.md, раздел «Форма выбора брендов».
//
// ЗАЧЕМ. Выбор листов бесполезен прайсу, у которого лист один. «Остатки 01.10.2026» —
// одна вкладка, 1286 строк, 23 бренда: полный разбор это 88 тыс. токенов только на загрузку
// таблицы, причём 13 брендов из 23 в справочнике 1С отсутствуют вовсе. То есть больше
// половины файла — не работа, а мусор, и отделить одно от другого может только человек.
//
// К РАЗБОРУ УХОДИТ ПЕРЕСЕЧЕНИЕ отмеченных листов и отмеченных брендов. Два списка у одного
// формата: листы — в «ФормаВыбораЛистов», бренды — здесь.
//
// НИ ОДНОГО ФЛАГА — НЕ РАЗБИРАЕМ НИЧЕГО, как и у листов.
//
// ЗДЕСЬ ЖЕ ЗАДАЮТСЯ ЦЕНЫ, КОТОРЫХ В ПРАЙСЕ НЕТ. У таких поставщиков в файле стоит розница,
// а дилеру даётся скидка процентом — СВОИМ у каждой марки; цены бывают в валюте. Поэтому в
// таблице есть колонка «Скидка, %», а на форме — поля «Валюта» и «Курс». Курс относится к
// ПРАЙСУ,
// а не к формату: он меняется каждый день, и посчитать по прошлому значило бы записать в 1С
// цифру, которой нет. В поле подставлен последний введённый — как подсказка.
//
// КАК ОТКРЫВАЕТСЯ: кнопкой «Бренды» на форме прайсов (`ОткрытьВыборБрендов` в
// model-form-module.bsl). Двойной щелчок по имени файла уже занят выбором листов.
//
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// **`РегистрСведений.ии_МодельБрендыПрайсов`** — независимый непериодический регистр.
// Пишет его ТОЛЬКО `set-model-state`; эта форма его читает и НЕ меняет.
//   Измерения:
//     Сигнатура   Строка  64   — хеш формата файла
//     Бренд       Строка 150   — как написано В ФАЙЛЕ (сравнивает агент, человек узнаёт)
//   Ресурсы:
//     Поставщик   СправочникСсылка.ии_МодельПоставщики — ссылка, не строка
//     Порядок     Число   3,0  — порядок В ФАЙЛЕ, не алфавитный
//     Строк       Число   6,0  — позиций бренда в последнем файле. НОЛЬ = бренда в нём
//                                больше нет; строка остаётся вместе с флажком и скидкой
//     Разбирать   Булево       — отметка админа
//     Марка       СправочникСсылка.Производители — настоящий справочник марок базы
//     Скидка      Число   5,2  — процент скидки от розницы
//
// Плюс в `РегистрСведений.ии_МодельПрайсы` два ресурса — **`Валюта`
// СправочникСсылка.Валюта** и **`Курс` Число 10,4**: они принадлежат прайсу и приезжают
// снимком вместе с остальными его полями.
//
// Форма: **ФормаВыбораБрендов** у регистра брендов. Реквизиты формы:
//     Сигнатура   Строка  64   — параметр
//     Файл        Строка 255   — параметр, для заголовка
//     НомерПрайса Число   9,0  — параметр: откуда открыли. Нужен для АДРЕСАЦИИ ВИЗУАЛА
//                                (надпись ожидания на форме прайсов) и для курса: курс
//                                принадлежит прайсу
//     Валюта      СправочникСсылка.Валюта — поле выбора на форме; пусто = рубль
//     Курс        Число  10,4  — поле ввода на форме, курс ВЫБРАННОЙ валюты
//     Бренды      ТаблицаЗначений: Бренд (Строка 150), Строк (Число 6,0),
//                 Разбирать (Булево), Марка (СправочникСсылка.Производители),
//                 Скидка (Число 5,2), Порядок (Число 3,0)
//     ЕстьПравки  Булево
// Элементы: таблица `Бренды` (колонки `Бренд` и `Строк` только для просмотра; `Разбирать`,
// `Марка` и `Скидка` доступны), поля `Валюта` и `Курс`, кнопки `Сохранить`,
// `Отметить все` / `Снять все`.
//
// ПОЧЕМУ НЕ ПИШЕМ В РЕГИСТР НАПРЯМУЮ — ровно как у листов: зеркало перезапишет следующий
// снимок, и отметки пропали бы через пять секунд. Истина живёт у агента, форма СТАВИТ
// КОМАНДУ, а флажки приезжают обратно снимком.
// =====================================================================================


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Сигнатура   = СтрокаПараметра("Сигнатура");
	Файл        = СтрокаПараметра("Файл");
	НомерПрайса = ЧислоПараметра("Прайс");
	Курс        = ЧислоПараметра("Курс");
	// Валюта приходит КОДОМ: форма прайсов держит ссылку, но передавать между формами код
	// надёжнее — он не зависит от того, та же это база или копия.
	Валюта      = ВалютаПоКоду(СтрокаПараметра("Валюта"));

	Если ПустаяСтрока(Сигнатура) Тогда
		// Без формата показывать нечего: пустая таблица читается как «брендов нет», а это
		// другое.
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПрочитатьБренды();

КонецПроцедуры


// Параметр формы читается через `Свойство`, а НЕ через `Получить`: `Получить` есть у
// соответствия, а параметры формы — структура, и у неё этого метода нет. Ошибка при этом
// вылетает в `ПриСозданииНаСервере`, то есть форма просто не открывается, и причина не
// видна (02.10.2026).
&НаСервере
Функция СтрокаПараметра(Имя)

	Значение = Неопределено;

	Если НЕ Параметры.Свойство(Имя, Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции


&НаСервере
Функция ЧислоПараметра(Имя)

	Значение = Неопределено;

	Если НЕ Параметры.Свойство(Имя, Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат ?(Значение = Неопределено, 0, Число(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


&НаСервере
Процедура ПрочитатьБренды()

	Бренды.Очистить();
	ЕстьПравки = Ложь;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сигнатура", Сигнатура);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Б.Бренд КАК Бренд,
		|	Б.Строк КАК Строк,
		|	Б.Разбирать КАК Разбирать,
		|	Б.Марка КАК Марка,
		|	Б.Скидка КАК Скидка,
		|	Б.Порядок КАК Порядок,
		|	Б.Поставщик КАК Поставщик
		|ИЗ
		|	РегистрСведений.ии_МодельБрендыПрайсов КАК Б
		|ГДЕ
		|	Б.Сигнатура = &Сигнатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Б.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();
	Поставщик = "";
	Отмечено = 0;
	БезМарки = 0;

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Бренды.Добавить();
		НоваяСтрока.Бренд     = Выборка.Бренд;
		НоваяСтрока.Строк     = Выборка.Строк;
		НоваяСтрока.Разбирать = Выборка.Разбирать;
		НоваяСтрока.Марка     = Выборка.Марка;
		НоваяСтрока.Скидка    = Выборка.Скидка;
		НоваяСтрока.Порядок   = Выборка.Порядок;
		// Ссылка приводится к строке ЗДЕСЬ, для заголовка: в регистре живёт ссылка, и имя у
		// неё всегда текущее — переименовали поставщика, заголовок поехал за ним.
		Поставщик = Строка(Выборка.Поставщик);

		Если Выборка.Разбирать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
		Если Выборка.Марка.Пустая() Тогда
			БезМарки = БезМарки + 1;
		КонецЕсли;
	КонецЦикла;

	// ПУСТАЯ ТАБЛИЦА ОБЯЗАНА ОБЪЯСНИТЬСЯ: молчаливая пустота читается как поломка формы, а
	// причин у неё две и они требуют разного — зеркало ещё не доехало либо товары в этом
	// формате вообще не размечены брендом (тогда разбор идёт по листам, как обычно).
	Если Бренды.Количество() = 0 Тогда
		Заголовок = "Бренды прайса: по формату " + Лев(Сигнатура, 12)
			+ " брендов нет — либо снимок агента ещё не доехал, либо товары в этом формате"
			+ " не размечены колонкой бренда";
		Возврат;
	КонецЕсли;

	// ЧИСЛА В ЗАГОЛОВКЕ — то, что админ проверяет глазами: сколько отмечено и сколько
	// брендов осталось без марки в 1С. Второе и есть работа, которую видно только здесь.
	Заголовок = "Бренды прайса: " + ?(ПустаяСтрока(Поставщик), Файл, Поставщик)
		+ " — всего " + Формат(Бренды.Количество(), "ЧГ=0")
		+ ", отмечено " + Формат(Отмечено, "ЧГ=0")
		+ ?(БезМарки = 0, "", ", без марки в 1С " + Формат(БезМарки, "ЧГ=0"));

КонецПроцедуры


// ОБНОВЛЕНИЕ НЕ ЗАТИРАЕТ НЕОТПРАВЛЕННЫЕ ПРАВКИ. Снимок приходит каждые несколько секунд, и
// перечитав таблицу посреди расстановки флажков, мы стёрли бы уже отмеченное — админ ставит
// их по одному, а не залпом.
&НаКлиенте
Процедура Обновить(Команда)

	Если ЕстьПравки Тогда
		ПоказатьПредупреждение(,
			"Есть неотправленные правки. Сохраните их или закройте форму без сохранения.");
		Возврат;
	КонецЕсли;

	ПрочитатьБренды();

КонецПроцедуры


&НаКлиенте
Процедура БрендыРазбиратьПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура БрендыМаркаПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура БрендыСкидкаПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура КурсПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ВалютаПоКоду(Код)

	Если ПустаяСтрока(Код) Тогда
		Возврат Справочники.Валюта.ПустаяСсылка();
	КонецЕсли;

	Найденная = Справочники.Валюта.НайтиПоКоду(СокрЛП(Код));
	Возврат ?(Найденная.Пустая(), Справочники.Валюта.ПустаяСсылка(), Найденная);

КонецФункции


&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого Строчка Из Бренды Цикл
		Строчка.Разбирать = Истина;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура СнятьВсе(Команда)

	Для Каждого Строчка Из Бренды Цикл
		Строчка.Разбирать = Ложь;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)

	Отмечено = 0;
	Для Каждого Строчка Из Бренды Цикл
		Если Строчка.Разбирать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	// СНЯТИЕ ВСЕХ ФЛАЖКОВ — ЗАКОННОЕ ДЕЙСТВИЕ, а не промах: оно означает «этот формат не
	// разбирать». Предупреждаем об одном — пока флажков нет, «Обновить задачи» ничего не
	// даст, и молча оставить админа с пустым списком нельзя: он решит, что сломался разбор.
	Если Отмечено = 0 Тогда
		Текст = "Ни один бренд не отмечен. Агент не будет разбирать этот формат вовсе:"
			+ Символы.ПС + "«Обновить задачи» даст пустой список." + Символы.ПС + Символы.ПС
			+ "Сохранить такой выбор?";
		ПоказатьВопрос(Новый ОписаниеОповещения("СохранитьОтвет", ЭтаФорма),
			Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Выбор брендов");
		Возврат;
	КонецЕсли;

	Отправить();

КонецПроцедуры


&НаКлиенте
Процедура СохранитьОтвет(Ответ, ДопДанные) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Отправить();
	КонецЕсли;

КонецПроцедуры


// ОТПРАВИЛИ — ЗАКРЫВАЕМСЯ. Ждать результат здесь нечем и незачем: его показывает форма
// прайсов — там гаснут кнопки и стоит надпись со счётчиком, как у остальных команд.
&НаКлиенте
Процедура Отправить()

	Итог = ПоставитьВыборБрендовНаСервере();

	Если НЕ Итог.ok Тогда
		// Чаще всего это «по этому прайсу уже отправлена команда»: форма прайсов в этот
		// момент и так показывает ожидание, и закрываться, не отправив, нельзя — админ
		// решил бы, что отправилось.
		ПоказатьПредупреждение(, Итог.message);
		Возврат;
	КонецЕсли;

	ЕстьПравки = Ложь;
	Закрыть();

КонецПроцедуры


&НаСервере
Функция ПоставитьВыборБрендовНаСервере()

	// СТРОКА НА БРЕНД, а не список имён: вместе с флажком едут марка и скидка, и в одно
	// текстовое поле они не лягут. Агент применяет это по имени бренда.
	Список = Новый Массив;

	Для Каждого Строчка Из Бренды Цикл
		Запись = Новый Структура;
		Запись.Вставить("brand", Строчка.Бренд);
		Запись.Вставить("parse", Строчка.Разбирать);
		// КОД марки, а не имя: агент знает марки кодами (`Справочники.Производители`
		// ищется `НайтиПоКоду`), а имя в справочнике двуязычное — «Atlas Concorde / Атлас
		// конкорд», — и по нему сопоставление разошлось бы.
		Запись.Вставить("tm_code", ?(Строчка.Марка.Пустая(), "", Строчка.Марка.Код));
		Запись.Вставить("tm_name", ?(Строчка.Марка.Пустая(), "",
			Строчка.Марка.Наименование));
		Запись.Вставить("discount", Строчка.Скидка);
		Список.Добавить(Запись);
	КонецЦикла;

	Значения = Новый Структура;
	Значения.Вставить("signature", Сигнатура);
	Значения.Вставить("marks", Список);
	// ВАЛЮТА И КУРС ЕДУТ ВМЕСТЕ и ложатся к ПРАЙСУ (номер прайса для этого и передан).
	// Врозь их держать нельзя: число без валюты выглядит заданным, а чего оно курс —
	// неизвестно, и по такому числу однажды посчитали бы цену не в той валюте.
	//
	// Валюта уезжает КОДОМ международного классификатора: агент знает её кодом, а имя —
	// только для показа.
	Значения.Вставить("currency", ?(Валюта.Пустая(), "", Валюта.Код));
	Значения.Вставить("currency_name", ?(Валюта.Пустая(), "", Валюта.Наименование));
	Значения.Вставить("rate", Курс);

	// НАГРУЗКУ СВЁРТЫВАЕМ В JSON САМИ: `Данные` в регистре команд — СТРОКА, а
	// `ПоставитьКоманду` кладёт в неё то, что дали, без преобразования. Передав структуру,
	// мы записали бы команду, из которой агент не достанет ничего, и отказ выглядел бы как
	// успех — форма закрылась, надпись погасла, выбор потерян (бой 02.10.2026).
	Строчка = ии_РаботаСМодельюИИАгнета.ДанныеКомандыВСтроку(Значения);

	Возврат ии_РаботаСМодельюИИАгнета.ПоставитьКоманду(
		"изменить бренды формата", НомерПрайса, 0, Строчка, ИмяПользователя());

КонецФункции
