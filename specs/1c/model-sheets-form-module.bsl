// =====================================================================================
// Форма выбора листов прайса (решение админа 02.10.2026)
//
// Кодировка файла: UTF-8. Контракт — specs/1c/model-form.md, раздел «Форма выбора листов».
//
// ЗАЧЕМ. У FLOOR SERVICE четырнадцать листов, по делу два-три, а разбор каждого лишнего
// стоит и токенов, и кругов ручного цикла: тот прайс обошёлся в $5.83. Выбор листов —
// решение АДМИНА, по файлу он не выводится ничем: «АКЦИИ» и «Скидки розница» выглядят как
// данные, а товаров в них нет.
//
// НИ ОДНОГО ФЛАГА — НЕ РАЗБИРАЕМ НИЧЕГО (решение админа). Поэтому новый прайс задач не
// порождает: его листы приезжают сюда, админ отмечает нужные и сам нажимает «Обновить
// задачи» в форме прайсов. Обратное умолчание стоило бы полного разбора каждого файла.
//
// КАК ОТКРЫВАЕТСЯ: двойным щелчком по имени файла в таблице прайсов (`ОткрытьВыборЛистов`
// в model-form-module.bsl). Параметры формы — `Сигнатура` (хеш формата) и `Файл` (имя для
// заголовка).
//
// ЧТО ЗАВЕСТИ В КОНФИГУРАЦИИ
//
// **`РегистрСведений.ии_МодельЛистыПрайсов`** — независимый непериодический регистр
// сведений. Пишет его ТОЛЬКО `set-model-state`; эта форма его читает и НЕ меняет.
//   Измерения:
//     Сигнатура   Строка  64   — хеш формата файла
//     Лист        Строка 150   — имя листа
//   Ресурсы:
//     Поставщик   СправочникСсылка.ии_МодельПоставщики — ССЫЛКА, а не строка (правка
//                                админа 02.10.2026): справочник заведён затем, чтобы имя
//                                жило в одном месте. Строкой это была бы вторая копия
//     Формат      Строка 150   — назначение формата либо имя файла-образца
//     Порядок     Число   3,0  — номер листа В КНИГЕ: сортировать по алфавиту нельзя,
//                                админ ищет лист глазами там, где он стоит в файле
//     Разбирать   Булево       — отметка админа
//
// Форма: **ФормаВыбораЛистов** у этого регистра. Реквизиты формы:
//     Сигнатура   Строка  64   — параметр, кладётся в `ПриСозданииНаСервере`
//     Файл        Строка 255   — параметр, только для заголовка
//     Листы       ТаблицаЗначений (реквизит формы): Лист (Строка 150),
//                 Разбирать (Булево), Порядок (Число)
//     ЕстьПравки  Булево       — что-то отметили и ещё не отправили
// Элементы: таблица `Листы` (колонки `Лист` только для просмотра и `Разбирать` —
// флажок, доступен), кнопки `Сохранить` и `Отметить все` / `Снять все`.
//
// ПОЧЕМУ НЕ ПИШЕМ В РЕГИСТР НАПРЯМУЮ. Зеркало — не источник истины: его перезапишет
// следующий снимок, и отметки пропали бы через пять секунд. Истина живёт у агента, поэтому
// форма СТАВИТ КОМАНДУ, а флажки приезжают обратно снимком — как и всё остальное.
// =====================================================================================


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Сигнатура = СтрокаПараметра("Сигнатура");
	Файл      = СтрокаПараметра("Файл");

	Если ПустаяСтрока(Сигнатура) Тогда
		// Без формата показывать нечего, и открывать пустую форму незачем: пустая таблица
		// читается как «листов нет», а это другое.
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПрочитатьЛисты();

КонецПроцедуры


&НаСервере
Функция СтрокаПараметра(Имя)

	Значение = Параметры.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции


&НаСервере
Процедура ПрочитатьЛисты()

	Листы.Очистить();
	ЕстьПравки = Ложь;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сигнатура", Сигнатура);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Л.Лист КАК Лист,
		|	Л.Разбирать КАК Разбирать,
		|	Л.Порядок КАК Порядок,
		|	Л.Поставщик КАК Поставщик,
		|	Л.Формат КАК Формат
		|ИЗ
		|	РегистрСведений.ии_МодельЛистыПрайсов КАК Л
		|ГДЕ
		|	Л.Сигнатура = &Сигнатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Л.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();
	Поставщик = "";

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Листы.Добавить();
		НоваяСтрока.Лист      = Выборка.Лист;
		НоваяСтрока.Разбирать = Выборка.Разбирать;
		НоваяСтрока.Порядок   = Выборка.Порядок;
		// Ссылка приводится к строке ЗДЕСЬ, для заголовка: в самом регистре живёт ссылка,
		// и имя у неё всегда текущее — переименовали поставщика, заголовок поехал за ним.
		Поставщик = Строка(Выборка.Поставщик);
	КонецЦикла;

	Заголовок = "Листы прайса: " + ?(ПустаяСтрока(Поставщик), Файл, Поставщик);

КонецПроцедуры


// ОБНОВЛЕНИЕ НЕ ЗАТИРАЕТ НЕОТПРАВЛЕННЫЕ ПРАВКИ. Снимок приходит каждые несколько секунд, и
// перечитав таблицу посреди расстановки флажков, мы стёрли бы уже отмеченное — админ ставит
// их по одному, а не залпом.
&НаКлиенте
Процедура Обновить(Команда)

	Если ЕстьПравки Тогда
		ПоказатьПредупреждение(,
			"Есть неотправленные отметки. Сохраните их или закройте форму без сохранения.");
		Возврат;
	КонецЕсли;

	ПрочитатьЛисты();

КонецПроцедуры


&НаКлиенте
Процедура ЛистыРазбиратьПриИзменении(Элемент)

	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого Строчка Из Листы Цикл
		Строчка.Разбирать = Истина;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура СнятьВсе(Команда)

	Для Каждого Строчка Из Листы Цикл
		Строчка.Разбирать = Ложь;
	КонецЦикла;
	ЕстьПравки = Истина;

КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)

	Отмечено = Новый Массив;
	Для Каждого Строчка Из Листы Цикл
		Если Строчка.Разбирать Тогда
			Отмечено.Добавить(Строчка.Лист);
		КонецЕсли;
	КонецЦикла;

	// СНЯТИЕ ВСЕХ ФЛАЖКОВ — ЗАКОННОЕ ДЕЙСТВИЕ, а не промах. Оно означает «этот формат не
	// разбирать», и спрашивать подтверждение здесь незачем: отменяется оно тем же способом,
	// каким и сделано, а задач при этом не теряется — их просто не собирают.
	//
	// Предупреждаем только об одном: пока флажков нет, «Обновить задачи» ничего не даст.
	// Молча оставить админа с пустым списком задач нельзя — он решит, что сломался разбор.
	Если Отмечено.Количество() = 0 Тогда
		Текст = "Ни один лист не отмечен. Агент не будет разбирать этот формат вовсе:"
			+ Символы.ПС + "«Обновить задачи» даст пустой список." + Символы.ПС + Символы.ПС
			+ "Сохранить такой выбор?";
		ПоказатьВопрос(Новый ОписаниеОповещения("СохранитьОтвет", ЭтаФорма, Отмечено),
			Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Выбор листов");
		Возврат;
	КонецЕсли;

	Отправить(Отмечено);

КонецПроцедуры


&НаКлиенте
Процедура СохранитьОтвет(Ответ, Отмечено) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Отправить(Отмечено);
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура Отправить(Отмечено)

	Итог = ПоставитьВыборЛистовНаСервере(Отмечено);

	Если ПустаяСтрока(Итог) Тогда
		ПоказатьПредупреждение(, "Команда не поставилась: формат не определён.");
		Возврат;
	КонецЕсли;

	// Правки ушли — признак снимаем, иначе «Обновить» будет считать их неотправленными.
	// Сами флажки остаются как есть: они приедут обратно снимком, когда агент применит
	// команду, и до тех пор показывать прежние значения честнее, чем мигать.
	ЕстьПравки = Ложь;
	ПоказатьПредупреждение(,
		"Отправлено агенту: " + Формат(Отмечено.Количество(), "ЧГ=0") + " лист(ов)."
		+ Символы.ПС + "Чтобы собрать задачи по ним, нажмите «Обновить задачи» в форме "
		+ "прайсов.");

КонецПроцедуры


&НаСервере
Функция ПоставитьВыборЛистовНаСервере(Отмечено)

	Возврат ии_РаботаСМодельюИИАгнета.ПоставитьВыборЛистов(
		Сигнатура, Отмечено, ИмяПользователя());

КонецФункции
